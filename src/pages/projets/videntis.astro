---
// Page projet Videntis — maquette v2 (étape de validation du design).
// La démo est figée sur un état réaliste ; la logique sera branchée après validation.
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import MethodPipe from "../../components/MethodPipe.astro";
import Draw from "../../components/Draw.astro";
import { Image } from "astro:assets";
import capVerdict from "../../assets/videntis/cap-verdict.png";
import capMarche from "../../assets/videntis/cap-marche.png";
import capScore from "../../assets/videntis/cap-score.png";
import "../../styles/videntis.css";

const description =
  "Videntis, SaaS d’intelligence tarifaire pour le matériel PC d’occasion, conçu et codé seul : fonctions, démo interactive, architecture, méthode de travail et difficultés résolues.";

const FAMILIES = [
  { k: "gpu", n: 139, t: "Cartes graphiques" },
  { k: "cpu", n: 127, t: "Processeurs" },
  { k: "mobo", n: 203, t: "Cartes mères" },
  { k: "psu", n: 149, t: "Alimentations" },
  { k: "ssd", n: 42, t: "SSD" },
  { k: "ram", n: 30, t: "Mémoire" },
];
const FEATURES = [
  { k: "lens", t: "Lens", tag: "Extension Chrome", d: "Le verdict s’affiche sur l’annonce que vous regardez. Chaque annonce lue rapporte un crédit." },
  { k: "estimator", t: "Estimateur", tag: "Achat ou revente", d: "Trois plateformes, cinq états : marge nette, verdict et escalier d’offres." },
  { k: "catalogue", t: "Catalogue", tag: "690 modèles", d: "Chaque modèle avec sa médiane, sa tendance et sa liquidité." },
  { k: "watchlist", t: "Watchlist", tag: "Suivi", d: "Les modèles qu’on surveille, toujours sous les yeux." },
  { k: "stock", t: "Inventaire", tag: "Achats et ventes", d: "La marge réelle de chaque pièce, de l’achat à la revente." },
  { k: "dashboard", t: "Tableau de bord", tag: "Vue d’ensemble", d: "Capital engagé, profit réalisé, stock à écouler." },
  { k: "repair", t: "Repair Guide", tag: "37 pannes", d: "Causes probables, étapes de diagnostic et réparations chiffrées." },
  { k: "community", t: "Communauté", tag: "Votes et missions", d: "Les utilisateurs confirment la nature des annonces, à la manière de Waze." },
];

// Observations de la démo : inventées, calées sur des quartiles réalistes (P25 410 €, médiane 457 €, P75 480 €).
const OBS = [290, 335, 360, 375, 390, 395, 400, 405, 410, 415, 420, 430, 440, 445, 450, 455, 457, 460, 462, 465, 470, 472, 475, 478, 480, 485, 495, 510, 520, 540, 560, 590, 625];
const LO = 280, HI = 640, STEP = 20;
const bins = Array.from({ length: (HI - LO) / STEP }, (_, i) => OBS.filter((p) => p >= LO + i * STEP && p < LO + (i + 1) * STEP).length);
const maxBin = Math.max(...bins);
const X = (p: number) => ((p - LO) / (HI - LO)) * 100;
const SAMPLES = [
  { t: "rtx3080ti 12go comme neuf !!!", p: 420, on: true },
  { t: "Geforce RTX 3080 gaming OC 10Go", p: 390 },
  { t: "carte graphique 3080 ti founders", p: 455 },
  { t: "Boîte vide RTX 3080 Ti", p: 15 },
  { t: "Recherche RTX 3080 Ti", p: 380 },
  { t: "RX 6800 XT nitro+ facture", p: 340 },
];
---
<Base title="Videntis, le juste prix du matériel d’occasion" description={description} themeColor="#FFD93B">
<SiteHeader />

<main class="v">

  <!-- ========== En-tête ========== -->
  <section class="band b-yellow v-hero" aria-labelledby="v-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kicker">Projet 1 · SaaS B2B · 2025–2026</p>
        <h1 id="v-title" class="v-h1">Videntis</h1>
        <p class="lead">Le juste prix du matériel PC d’occasion. Videntis lit l’annonce, la ramène au bon modèle et tranche&nbsp;: foncer, négocier, tenter ou passer.</p>
        <p class="status"><span class="dot" aria-hidden="true"></span>Prêt à lancer. Il manque une communauté.</p>
        <div class="cta">
          <a class="vbtn primary" href="#demo">Essayer la démo</a>
          <a class="vbtn" href="https://videntis-corp.fr" rel="noopener">videntis-corp.fr <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="stack" aria-label="Technologies">
          <li>Python</li><li>FastAPI</li><li>PostgreSQL</li><li>React</li><li>TypeScript</li><li>Stripe</li><li>Claude Haiku</li><li>Docker</li>
        </ul>
      </div>
      <div class="stamp-scene" aria-hidden="true">
        <div class="ad-wrap">
          <article class="ad">
            <div class="ad-photo"><Draw name="gpu" /><span>annonce inventée</span></div>
            <p class="ad-title">rtx3080ti 12go comme neuf !!!</p>
            <p class="ad-price">420 €</p>
            <p class="ad-meta">Bon état · Leboncoin · il y a 4 min</p>
          </article>
          <div class="stamp st-neg hit">Négocier</div>
        </div>
        <ul class="rack">
          <li class="stamp mini st-go">Foncer</li>
          <li class="stamp mini st-neg">Négocier</li>
          <li class="stamp mini st-try">Tenter</li>
          <li class="stamp mini st-pass">Passer</li>
        </ul>
      </div>
    </div>
    <div class="wrap">
      <ul class="facts">
        <li><b>690</b><span>modèles</span></li>
        <li><b>7&nbsp;918</b><span>façons de les écrire</span></li>
        <li><b>46&nbsp;211</b><span>prix observés</span></li>
        <li><b>1&nbsp;100+</b><span>tests</span></li>
      </ul>
    </div>
  </section>

  <!-- ========== Fonctions ========== -->
  <section class="band b-paper" aria-labelledby="h-fn">
    <div class="wrap">
      <h2 class="v-h2" id="h-fn">Huit outils, une question&nbsp;: à quel prix&nbsp;?</h2>
      <ul class="families" aria-label="Les six familles du catalogue">
        {FAMILIES.map((f) => (
          <li class="fam"><Draw name={f.k} /><b>{f.n}</b><span>{f.t}</span></li>
        ))}
      </ul>
      <ul class="features">
        {FEATURES.map((f) => (
          <li class="feat"><div class="feat-art"><Draw name={f.k} /></div><p class="feat-tag">{f.tag}</p><h3>{f.t}</h3><p>{f.d}</p></li>
        ))}
      </ul>
      <p class="also"><b>Et aussi</b> trois formules et des recharges de crédits · un support avec pièces jointes · export et suppression des données (RGPD)</p>
    </div>
  </section>

  <!-- ========== Démo ========== -->
  <section class="band b-blue" id="demo" aria-labelledby="h-demo">
    <div class="wrap">
      <h2 class="v-h2" id="h-demo">Une annonce, un verdict.</h2>
      <p class="intro">Le vrai chemin de Videntis en quatre étapes. Vrai code pour la lecture du titre et le verdict, données inventées.</p>
      <div class="machine">
        <div class="m-input">
          <ul class="chips">
            {SAMPLES.map((s) => (
              <li><button type="button" class={"chip" + (s.on ? " on" : "")}><span class="c-t">{s.t}</span><span class="c-p">{s.p} €</span></button></li>
            ))}
          </ul>
          <div class="m-form">
            <label class="f f-title"><span>ou tapez un titre</span><input type="text" value="rtx3080ti 12go comme neuf !!!" /></label>
            <label class="f"><span>Prix</span><input type="text" inputmode="numeric" value="420 €" /></label>
            <label class="f"><span>État</span><select><option>Bon</option><option>Comme neuf</option><option>Acceptable</option></select></label>
            <label class="f"><span>Plateforme</span><select><option>Leboncoin</option><option>Vinted</option><option>eBay</option></select></label>
          </div>
        </div>
        <ol class="stations">
          <li class="stn">
            <header><i>1</i><h3>Lire le titre</h3><span class="tag t-real">vrai code</span></header>
            <p class="mono norm"><s>!!!</s> <span class="tk tk-m">rtx3080ti</span> <span class="tk tk-g">12go</span> <span class="tk tk-n">comme</span> <span class="tk tk-n">neuf</span></p>
            <div class="match">
              <p class="mc ok-m"><b>GeForce RTX 3080 Ti</b><em>égalité exacte</em></p>
              <p class="mc ko-m"><s>GeForce RTX 3080</s><em>autre modèle</em></p>
            </div>
          </li>
          <li class="stn">
            <header><i>2</i><h3>Vraie vente&nbsp;?</h3><span class="tag t-rec">IA enregistrée</span></header>
            <ul class="intents">
              <li class="on">vente</li><li>recherche</li><li>échange</li><li>boîte seule</li><li>pour pièces</li><li>lot</li><li>prix symbolique</li>
            </ul>
            <p class="ok">✓ Compte dans les prix</p>
          </li>
          <li class="stn">
            <header><i>3</i><h3>Prix du marché</h3><span class="tag t-fake">données inventées</span></header>
            <figure class="hist" role="img" aria-label="33 prix observés entre 290 et 625 euros, médiane 457 euros, prix demandé 420 euros.">
              <div class="bars">
                {bins.map((n, i) => (
                  <span class={"bar" + (LO + i * STEP + STEP / 2 >= 410 && LO + i * STEP + STEP / 2 <= 480 ? " iq" : "")} style={`height:${(n / maxBin) * 100}%`}></span>
                ))}
              </div>
              <span class="mark m-ask" style={`left:${X(420)}%`}><em>420 €</em></span>
              <span class="mark m-med" style={`left:${X(457)}%`}><em>457 €</em></span>
              <div class="axis"><span>280 €</span><span>640 €</span></div>
            </figure>
            <p class="big-n"><b>457 €</b> fair price <span>· confiance 77 %</span></p>
          </li>
          <li class="stn st-verdict">
            <header><i>4</i><h3>Verdict</h3><span class="tag t-real">vrai code</span></header>
            <div class="gauge" aria-hidden="true">
              <span class="g-z z1"></span><span class="g-z z2"></span><span class="g-z z3"></span>
              <span class="g-m" style="left:22%"><em>8,8 %</em></span><span class="g-m g-m2" style="left:58.75%"><em>23,5 %</em></span>
            </div>
            <p class="gt" aria-hidden="true"><span style="left:50%">20 %</span><span style="left:75%">30 %</span></p>
            <p class="gk"><span class="k1">marge à 420 €</span><span class="k2">après négociation, 370 €</span></p>
            <div class="verdict-row">
              <div class="stamp st-neg big">Négocier</div>
              <p class="offer">Offre<b>370 €</b></p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ========== Captures ========== -->
  <section class="band b-paper" aria-labelledby="h-shots">
    <div class="wrap">
      <h2 class="v-h2" id="h-shots">Le vrai produit.</h2>
      <p class="intro">La même annonce dans l’application, le 3 novembre 2026.</p>
      <div class="shots">
        <figure class="shot s-main">
          <button type="button" class="zoom" aria-label="Agrandir la capture de l’Estimateur">
            <Image src={capVerdict} alt="L’Estimateur de Videntis : verdict Négocier pour une RTX 3080 Ti à 420 euros, 37 euros de marge nette, offre agressive conseillée à 376 euros." widths={[800, 1200, 1800, 2340]} sizes="(max-width: 1212px) 100vw, 1180px" />
          </button>
          <figcaption>L’Estimateur&nbsp;: verdict, marge nette et escalier d’offres.</figcaption>
        </figure>
        <figure class="shot">
          <button type="button" class="zoom" aria-label="Agrandir la capture du positionnement de prix">
            <Image src={capMarche} alt="Positionnement du prix : histogramme de 33 ventes, le prix demandé de 420 euros est moins cher que 70 % du marché." widths={[600, 900, 1200, 1800]} sizes="(max-width: 860px) 100vw, 576px" />
          </button>
          <figcaption>Le prix parmi les ventes observées.</figcaption>
        </figure>
        <figure class="shot">
          <button type="button" class="zoom" aria-label="Agrandir la capture de la construction du score">
            <Image src={capScore} alt="Construction du score : base 70, liquidité moins 5, ajustement de confiance plus 1, total 66 sur 100, confiance globale 77 %." widths={[600, 900, 1200, 1800]} sizes="(max-width: 860px) 100vw, 576px" />
          </button>
          <figcaption>Le score, signal par signal.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ========== Architecture ========== -->
  <section class="band b-ink" aria-labelledby="h-archi">
    <div class="wrap">
      <h2 class="v-h2" id="h-archi">Le plan.</h2>
      <p class="intro">Touchez un bloc pour voir son rôle.</p>
      <div class="plan" id="plan">
        <svg class="wires" aria-hidden="true"></svg>
        <div class="lane"><p class="lane-k">Chez l’utilisateur</p>
          <button type="button" class="nd on" data-k="lens" id="n-lens"><b>Lens</b><span>extension Chrome</span></button>
          <button type="button" class="nd" data-k="app" id="n-app"><b>Application</b><span>React</span></button>
        </div>
        <div class="lane lane-srv"><p class="lane-k">Serveur · VPS à Paris · Docker</p>
          <button type="button" class="nd nd-y" data-k="api" id="n-api"><b>API</b><span>FastAPI, Pydantic</span></button>
          <button type="button" class="nd" data-k="est" id="n-est"><b>Estimateur</b><span>marge et verdict</span></button>
          <button type="button" class="nd nd-db" data-k="db" id="n-db"><b>PostgreSQL</b><span>prix observés</span></button>
        </div>
        <div class="lane"><p class="lane-k">Services</p>
          <button type="button" class="nd nd-p" data-k="ai" id="n-ai"><b>Claude Haiku</b><span>tri des annonces</span></button>
          <button type="button" class="nd nd-g" data-k="stripe" id="n-stripe"><b>Stripe</b><span>abonnements</span></button>
          <button type="button" class="nd" data-k="mail" id="n-mail"><b>Brevo</b><span>e-mails</span></button>
        </div>
      </div>
      <p class="plan-detail" id="plan-detail" aria-live="polite"><b>Lens</b> Lit l’annonce dans le navigateur, la ramène au bon modèle sur place et affiche le verdict par-dessus.</p>
    </div>
  </section>

  <!-- ========== Méthode ========== -->
  <section class="band b-paper" aria-labelledby="h-method">
    <div class="wrap">
      <h2 class="v-h2" id="h-method">Comment je travaille.</h2>
      <p class="intro">Avec des agents IA, en gardant la main sur chaque étape. Ça n’a pas toujours été le cas.</p>
      <ol class="eras">
        <li class="era"><Draw name="era-gpt" /><p class="era-k">2025</p><h3>ChatGPT sur mon PC</h3><p>Le code naissait dans la conversation. Je le recopiais sur le VPS, fichier par fichier.</p></li>
        <li class="era"><Draw name="era-cc" /><p class="era-k">Janvier–février 2026</p><h3>Claude Code sur le VPS</h3><p>L’agent travaille dans le projet&nbsp;: il lit, modifie, lance les tests. Je passe de copiste à relecteur.</p></li>
        <li class="era"><Draw name="era-lovable" /><p class="era-k">Puis</p><h3>Lovable pour l’interface</h3><p>J’écris les briefs, Claude Code fait le serveur, Lovable l’interface. Je relis chaque diff.</p></li>
        <li class="era"><Draw name="era-git" /><p class="era-k">30 avril 2026</p><h3>Tout passe sous Git</h3><p>450 commits sur l’API en quatre mois, une branche par chantier, un seul script de mise en ligne.</p></li>
      </ol>
      <h3 class="sub-h">Aujourd’hui, chaque fonctionnalité suit ces cinq étapes</h3>
      <MethodPipe />
    </div>
  </section>

  <!-- ========== Choix ========== -->
  <section class="band b-pink" aria-labelledby="h-choix">
    <div class="wrap">
      <h2 class="v-h2" id="h-choix">Six choix, et ce que j’ai écarté.</h2>
      <div class="choices">
        <article class="card"><h3>Des règles pour lire les titres</h3><p>Même titre, même modèle. Testable, instantané, gratuit.</p><p class="cut"><span>Écarté</span> <s>une IA par annonce</s></p></article>
        <article class="card"><h3>L’IA trie, elle ne chiffre pas</h3><p>Claude Haiku dit si l’annonce est une vraie vente, pour 0,001&nbsp;$ environ.</p><p class="cut"><span>Écarté</span> <s>un prix estimé par l’IA</s></p></article>
        <article class="card"><h3>Un verdict sur la marge réelle</h3><p>Prix de revente net de frais, avant puis après négociation.</p><p class="cut"><span>Écarté</span> <s>ignorer frais et négociation</s></p></article>
        <article class="card"><h3>Crédit à la facture payée</h3><p>Un seul événement Stripe crédite. Rejoué, il ne crédite pas deux fois.</p><p class="cut"><span>Écarté</span> <s>créditer à la fin du formulaire</s></p></article>
        <article class="card"><h3>Rien d’envoyé hors formule</h3><p>Les données s’ajoutent selon la formule, jamais retirées après coup.</p><p class="cut"><span>Écarté</span> <s>masquer dans l’interface</s></p></article>
        <article class="card"><h3>Aucune annonce stockée</h3><p>Modèle et prix seulement, jamais titre, adresse ou vendeur (art. L.341-1).</p><p class="cut"><span>Écarté</span> <s>garder les annonces brutes</s></p></article>
      </div>
    </div>
  </section>

  <!-- ========== Difficultés ========== -->
  <section class="band b-ink" aria-labelledby="h-bugs">
    <div class="wrap">
      <h2 class="v-h2" id="h-bugs">Ce qui a cassé.</h2>
      <div class="incidents">
        <article class="inc">
          <p class="i-id">Lens · bug signalé</p>
          <h3>Le faux « Ti »</h3>
          <div class="dia dia-ti" aria-hidden="true">
            <span class="tok">rtx3080</span><span class="arrow">⊂</span><span class="tok bad">rtx3080<u>ti</u></span><span class="verd ko">✗ plus long ≠ juste</span>
            <span class="tok">rtx3080</span><span class="arrow">=</span><span class="tok good">rtx3080</span><span class="verd okk">✓ égalité exacte</span>
          </div>
          <p><b>Correctif</b> égalité exacte d’abord, et tout suffixe absent du titre est rejeté. Tests sur les paires piège.</p>
        </article>
        <article class="inc">
          <p class="i-id">Paiement · repéré en relecture</p>
          <h3>Le double crédit</h3>
          <div class="dia dia-lock" aria-hidden="true">
            <span class="ev">événement</span><span class="ev">même événement</span>
            <span class="lock">verrou</span>
            <span class="once">+1 crédit, une fois</span>
          </div>
          <p><b>Correctif</b> l’unicité en base n’empêche pas deux traitements simultanés&nbsp;: un verrou PostgreSQL par événement.</p>
        </article>
        <article class="inc">
          <p class="i-id">Lens · données</p>
          <h3>L’annonce d’avant</h3>
          <div class="dia dia-id" aria-hidden="true">
            <span class="idl">adresse</span><span class="idv">…/2841</span>
            <span class="idl">données de la page</span><span class="idv bad">2790</span>
            <span class="neq">≠ → lire la page elle-même</span>
          </div>
          <p><b>Correctif</b> le site change de page sans recharger&nbsp;: Lens compare les deux identifiants avant de lire.</p>
        </article>
        <article class="inc">
          <p class="i-id">Sécurité · incident, août 2026</p>
          <h3>Deux secrets à l’écran</h3>
          <div class="dia dia-term" aria-hidden="true">
            <code>$ docker compose config</code>
            <code>  API_KEY: <mark>••••••••••••</mark></code>
          </div>
          <p><b>Correctif</b> clés révoquées et remplacées, commandes qui affichent l’environnement interdites, audit avant chaque envoi sur GitHub.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ========== Suite ========== -->
  <section class="band b-green" aria-labelledby="h-next">
    <div class="wrap next-grid">
      <div>
        <h2 class="v-h2" id="h-next">Prêt, pas encore lancé.</h2>
        <p class="intro">Tout est en place, paiement compris. Ce qui manque n’est pas technique&nbsp;: les prix viennent des utilisateurs de Lens. Je construis d’abord une communauté autour de l’achat-revente de matériel, sur les réseaux.</p>
      </div>
      <ul class="limits">
        <li><b>Limite</b> Peu de ventes sur un modèle&nbsp;: confiance plus basse, verdict plus prudent.</li>
        <li><b>En cours</b> Alertes de prix, avec Deal Hunter.</li>
        <li><b>Prêt, éteint</b> Diagnostic de panne par IA.</li>
        <li><b>Prévu</b> Simulateur de réparation.</li>
      </ul>
    </div>
  </section>

  <section class="band b-paper v-end">
    <div class="wrap end-grid">
      <a class="nextcard" href="/"><span class="n-k">Projet suivant</span><b>Deal Hunter</b><span class="n-d">Alerter quand un prix passe sous la référence.</span><span class="n-arrow" aria-hidden="true">→</span></a>
      <a class="back" href="/">← Retour à l’accueil</a>
    </div>
    <div class="wrap"><SiteFooter /></div>
  </section>
</main>

<dialog class="lightbox" id="lightbox"><button type="button" class="lb-close" aria-label="Fermer">×</button><img alt="" /></dialog>

<script is:inline>
  (function () {
    // Agrandir une capture
    var lb = document.getElementById("lightbox"), lbImg = lb.querySelector("img");
    Array.prototype.forEach.call(document.querySelectorAll(".zoom"), function (b) {
      b.addEventListener("click", function () {
        var img = b.querySelector("img");
        lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt;
        if (lb.showModal) lb.showModal();
      });
    });
    lb.addEventListener("click", function (e) { if (e.target === lb || e.target.classList.contains("lb-close")) lb.close(); });

    // Le plan : liaisons dessinées entre les blocs, détail du bloc choisi
    var TXT = {
      lens: ["Lens", "Lit l’annonce dans le navigateur, la ramène au bon modèle sur place et affiche le verdict par-dessus."],
      app: ["Application", "Tableau de bord, estimateur, catalogue, inventaire, guides. Écrite avec Lovable, relue diff par diff."],
      api: ["API", "Reçoit les prix observés, vérifie les droits de chaque formule, sert l’application."],
      est: ["Estimateur", "Choisit la meilleure référence (même état, même plateforme si assez de ventes) et calcule marge et verdict."],
      db: ["PostgreSQL", "Les prix observés ne sont jamais modifiés. Aucun titre, adresse ou vendeur stocké."],
      ai: ["Claude Haiku", "Dit si chaque annonce est une vraie vente. Seules les vraies ventes comptent dans les prix."],
      stripe: ["Stripe", "Trois formules et des recharges. Seule la facture payée crédite."],
      mail: ["Brevo", "Vérification de l’adresse, mot de passe oublié, paiements, support."]
    };
    var LINKS = [["n-lens", "n-api", "prix observés"], ["n-app", "n-api", "requêtes"], ["n-api", "n-est", ""], ["n-est", "n-db", ""], ["n-api", "n-ai", "tri"], ["n-stripe", "n-api", "paiements"], ["n-api", "n-mail", "e-mails"]];
    var plan = document.getElementById("plan"), wires = plan.querySelector(".wires"), det = document.getElementById("plan-detail");
    function anchor(el, toward) {
      var r = el.getBoundingClientRect(), p = plan.getBoundingClientRect();
      var cx = r.left - p.left + r.width / 2, cy = r.top - p.top + r.height / 2;
      if (Math.abs(toward.x - cx) > r.width / 2) return { x: toward.x > cx ? cx + r.width / 2 : cx - r.width / 2, y: cy };
      return { x: cx, y: toward.y > cy ? cy + r.height / 2 : cy - r.height / 2 };
    }
    function center(el) { var r = el.getBoundingClientRect(), p = plan.getBoundingClientRect(); return { x: r.left - p.left + r.width / 2, y: r.top - p.top + r.height / 2 }; }
    function draw() {
      var p = plan.getBoundingClientRect(), html = "";
      wires.setAttribute("viewBox", "0 0 " + p.width + " " + p.height);
      wires.setAttribute("width", p.width); wires.setAttribute("height", p.height);
      if (getComputedStyle(wires).display === "none") return;
      LINKS.forEach(function (l) {
        var a = document.getElementById(l[0]), b = document.getElementById(l[1]);
        var A = anchor(a, center(b)), B = anchor(b, center(a));
        var mx = (A.x + B.x) / 2;
        var d = Math.abs(A.y - B.y) < 2 || Math.abs(A.x - B.x) < 2 ? "M" + A.x + " " + A.y + "L" + B.x + " " + B.y : "M" + A.x + " " + A.y + "C" + mx + " " + A.y + " " + mx + " " + B.y + " " + B.x + " " + B.y;
        html += "<path d=\"" + d + "\" class=\"w\" data-a=\"" + l[0] + "\" data-b=\"" + l[1] + "\"/>";
        if (l[2]) html += "<text x=\"" + mx + "\" y=\"" + ((A.y + B.y) / 2 - 7) + "\" text-anchor=\"middle\">" + l[2] + "</text>";
      });
      wires.innerHTML = html;
      hi();
    }
    var curK = "n-lens";
    function hi() { Array.prototype.forEach.call(wires.querySelectorAll(".w"), function (w) { w.classList.toggle("hot", w.getAttribute("data-a") === curK || w.getAttribute("data-b") === curK); }); }
    Array.prototype.forEach.call(plan.querySelectorAll(".nd"), function (n) {
      function show() {
        Array.prototype.forEach.call(plan.querySelectorAll(".nd"), function (o) { o.classList.toggle("on", o === n); });
        var t = TXT[n.getAttribute("data-k")]; det.innerHTML = "<b>" + t[0] + "</b> " + t[1];
        curK = n.id; hi();
      }
      n.addEventListener("click", show);
      n.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") show(); });
    });
    draw();
    window.addEventListener("resize", draw);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
  })();
</script>
