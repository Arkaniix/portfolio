---
// Page projet Videntis — maquette v3 : démo fonctionnelle, en-tête animé, survols animés.
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import MethodPipe from "../../components/MethodPipe.astro";
import VidentisDemo from "../../components/VidentisDemo.astro";
import Draw from "../../components/Draw.astro";
import { Image } from "astro:assets";
import capVerdict from "../../assets/videntis/cap-verdict.png";
import capMarche from "../../assets/videntis/cap-marche.png";
import capScore from "../../assets/videntis/cap-score.png";
import capPlans from "../../assets/videntis/cap-plans.png";
import capRepair from "../../assets/videntis/cap-repair.png";
import "../../styles/videntis.css";

const description =
  "Videntis, SaaS d’intelligence tarifaire pour le matériel PC d’occasion, conçu et codé seul : fonctions, démo interactive, architecture, méthode de travail et difficultés résolues.";

const FAMILIES = [
  { k: "gpu", n: 139, t: "Cartes graphiques" },
  { k: "cpu", n: 127, t: "Processeurs" },
  { k: "mobo", n: 203, t: "Cartes mères" },
  { k: "psu", n: 149, t: "Alimentations" },
  { k: "ssd", n: 42, t: "SSD" },
  { k: "ram", n: 30, t: "Mémoire" },
];
const FEATURES = [
  { k: "lens", t: "Lens", tag: "Extension Chrome", d: "Le verdict s’affiche sur l’annonce que vous regardez. Chaque annonce lue rapporte un crédit." },
  { k: "estimator", t: "Estimateur", tag: "Achat ou revente", d: "Trois plateformes, cinq états : marge nette, verdict et escalier d’offres." },
  { k: "catalogue", t: "Catalogue", tag: "690 modèles", d: "Chaque modèle avec sa médiane, sa tendance et sa liquidité." },
  { k: "watchlist", t: "Watchlist", tag: "Suivi", d: "Les modèles qu’on surveille, toujours sous les yeux." },
  { k: "stock", t: "Inventaire", tag: "Achats et ventes", d: "La marge réelle de chaque pièce, de l’achat à la revente." },
  { k: "dashboard", t: "Tableau de bord", tag: "Vue d’ensemble", d: "Capital engagé, profit réalisé, stock à écouler." },
  { k: "repair", t: "Repair Guide", tag: "37 pannes", d: "Causes probables, étapes de diagnostic et réparations chiffrées." },
  { k: "community", t: "Communauté", tag: "Votes et missions", d: "Les utilisateurs confirment la nature des annonces, à la manière de Waze." },
];
---
<Base title="Videntis, le juste prix du matériel d’occasion" description={description} themeColor="#FFD93B">
<SiteHeader />

<main class="v">

  <!-- ========== En-tête ========== -->
  <section class="band b-yellow v-hero" aria-labelledby="v-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kicker">Projet 1 · SaaS B2B · 2025–2026</p>
        <h1 id="v-title" class="v-h1">Videntis</h1>
        <p class="lead">Le juste prix du matériel PC d’occasion. Videntis lit l’annonce, la ramène au bon modèle et tranche&nbsp;: foncer, négocier, tenter ou passer.</p>
        <p class="status"><span class="dot" aria-hidden="true"></span>Prêt à lancer. Il manque une communauté.</p>
        <div class="cta">
          <a class="vbtn primary" href="#demo">Essayer la démo</a>
          <a class="vbtn" href="https://videntis-corp.fr" rel="noopener">videntis-corp.fr <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="stack" aria-label="Technologies">
          <li>Python</li><li>FastAPI</li><li>PostgreSQL</li><li>React</li><li>TypeScript</li><li>Stripe</li><li>Claude Haiku</li><li>Docker</li>
        </ul>
      </div>
      <div class="stamp-scene" id="hs" aria-hidden="true">
        <div class="lot-wrap">
          <article class="lot">
            <div class="lot-photo"><Draw name="gpu" /><span>annonce inventée</span></div>
            <p class="lot-title" id="hs-title"><span class="tkn m">rtx3080ti</span> <span class="tkn g">12go</span> <span class="tkn n">comme</span> <span class="tkn n">neuf</span> <span class="tkn x">!!!</span></p>
            <p class="lot-price" id="hs-price">420 €</p>
            <p class="lot-meta" id="hs-meta">Bon état · Leboncoin · il y a 4 min</p>
            <p class="lot-model" id="hs-model">= GeForce RTX 3080 Ti</p>
          </article>
          <div class="stamp hit st-neg" id="hs-stamp">Négocier</div>
        </div>
        <div class="rack-row">
          <ul class="rack">
            <li class="stamp mini st-go" data-v="go">Foncer</li>
            <li class="stamp mini st-neg lit" data-v="neg">Négocier</li>
            <li class="stamp mini st-try" data-v="try">Tenter</li>
            <li class="stamp mini st-pass" data-v="pass">Passer</li>
          </ul>
          <button type="button" class="replay" id="hs-next" aria-hidden="false">Autre annonce <span aria-hidden="true">↻</span></button>
        </div>
      </div>
    </div>
    <div class="wrap">
      <ul class="facts">
        <li><b>690</b><span>modèles reconnus</span><em>cartes graphiques, processeurs, cartes mères…</em></li>
        <li><b>7&nbsp;918</b><span>écritures ramenées au bon modèle</span><em>« rtx3080ti », « 3080 ti founders »…</em></li>
        <li><b>46&nbsp;211</b><span>prix de vente observés</span><em>sans garder une seule annonce</em></li>
        <li><b>1&nbsp;100+</b><span>tests automatisés</span><em>sur l’API et l’extension</em></li>
      </ul>
    </div>
  </section>

  <!-- ========== Fonctions ========== -->
  <section class="band b-paper" aria-labelledby="h-fn">
    <div class="wrap">
      <h2 class="v-h2" id="h-fn">Huit outils, une question&nbsp;: à quel prix&nbsp;?</h2>
      <ul class="families" aria-label="Les six familles du catalogue">
        {FAMILIES.map((f) => (
          <li class="fam" tabindex="0"><Draw name={f.k} /><b>{f.n}</b><span>{f.t}</span></li>
        ))}
      </ul>
      <ul class="features">
        {FEATURES.map((f) => (
          <li class={"feat f-" + f.k} tabindex="0"><div class="feat-art"><Draw name={f.k} /></div><p class="feat-tag">{f.tag}</p><h3>{f.t}</h3><p>{f.d}</p></li>
        ))}
      </ul>
      <p class="also"><b>Et aussi</b> trois formules et des recharges de crédits · un support avec pièces jointes · export et suppression des données (RGPD)</p>
    </div>
  </section>

  <!-- ========== Démo ========== -->
  <section class="band b-blue" id="demo" aria-labelledby="h-demo">
    <div class="wrap">
      <h2 class="v-h2" id="h-demo">Une annonce, un verdict.</h2>
      <p class="intro">Choisissez une annonce ou écrivez la vôtre. Elle suit le vrai chemin de Videntis, avec le code du produit&nbsp;; seuls les prix de revente sont inventés.</p>
      <VidentisDemo />
    </div>
  </section>

  <!-- ========== Captures ========== -->
  <section class="band b-paper" aria-labelledby="h-shots">
    <div class="wrap">
      <h2 class="v-h2" id="h-shots">Le vrai produit.</h2>
      <p class="intro">Captures de l’application, le 3 novembre 2026. Touchez une image pour l’agrandir.</p>
      <div class="shots">
        <figure class="shot s-main">
          <button type="button" class="zoom" aria-label="Agrandir la capture de l’Estimateur">
            <Image src={capVerdict} alt="L’Estimateur de Videntis : verdict Négocier pour une RTX 3080 Ti à 420 euros, 37 euros de marge nette, offre agressive conseillée à 376 euros." widths={[800, 1200, 1800, 2340]} sizes="(max-width: 1212px) 100vw, 1180px" />
          </button>
          <figcaption>L’Estimateur sur une RTX 3080 Ti à 420&nbsp;€&nbsp;: verdict, marge nette et escalier d’offres.</figcaption>
        </figure>
        <figure class="shot">
          <button type="button" class="zoom" aria-label="Agrandir la capture du positionnement de prix">
            <Image src={capMarche} alt="Positionnement du prix : histogramme de 33 ventes, le prix demandé de 420 euros est moins cher que 70 % du marché." widths={[600, 900, 1200, 1800]} sizes="(max-width: 860px) 100vw, 576px" />
          </button>
          <figcaption>Le prix demandé parmi les ventes observées.</figcaption>
        </figure>
        <figure class="shot">
          <button type="button" class="zoom" aria-label="Agrandir la capture de la construction du score">
            <Image src={capScore} alt="Construction du score : base 70, liquidité moins 5, ajustement de confiance plus 1, total 66 sur 100, confiance globale 77 %." widths={[600, 900, 1200, 1800]} sizes="(max-width: 860px) 100vw, 576px" />
          </button>
          <figcaption>Le score, expliqué signal par signal.</figcaption>
        </figure>
        <figure class="shot">
          <button type="button" class="zoom" aria-label="Agrandir la capture des formules">
            <Image src={capPlans} alt="Les trois formules : Free gratuit, Standard 11,99 euros par mois, Pro 24,99 euros par mois, avec crédits mensuels, crédits Lens, historique de marché et inventaire." widths={[600, 900, 1200, 1800]} sizes="(max-width: 860px) 100vw, 576px" />
          </button>
          <figcaption>Trois formules, payées par Stripe.</figcaption>
        </figure>
        <figure class="shot">
          <button type="button" class="zoom" aria-label="Agrandir la capture du Repair Guide">
            <Image src={capRepair} alt="Repair Guide, ventilateurs hors service : sévérité, difficulté, taux de réussite, causes probables en pourcentage et étapes de diagnostic." widths={[600, 900, 1200, 1800]} sizes="(max-width: 860px) 100vw, 576px" />
          </button>
          <figcaption>Repair Guide&nbsp;: une panne, ses causes probables et le diagnostic pas à pas.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ========== Architecture ========== -->
  <section class="band b-ink" aria-labelledby="h-archi">
    <div class="wrap">
      <h2 class="v-h2" id="h-archi">Le plan.</h2>
      <p class="intro">Touchez un bloc pour voir son rôle.</p>
      <div class="plan" id="plan">
        <svg class="wires" aria-hidden="true"></svg>
        <div class="lane"><p class="lane-k">Chez l’utilisateur</p>
          <button type="button" class="nd on" data-k="lens" id="n-lens"><b>Lens</b><span>extension Chrome</span></button>
          <button type="button" class="nd" data-k="app" id="n-app"><b>Application</b><span>React</span></button>
        </div>
        <div class="lane lane-srv"><p class="lane-k">Serveur · VPS à Paris · Docker</p>
          <button type="button" class="nd nd-y" data-k="api" id="n-api"><b>API</b><span>FastAPI, Pydantic</span></button>
          <button type="button" class="nd" data-k="est" id="n-est"><b>Estimateur</b><span>marge et verdict</span></button>
          <button type="button" class="nd nd-db" data-k="db" id="n-db"><b>PostgreSQL</b><span>prix observés</span></button>
        </div>
        <div class="lane"><p class="lane-k">Services</p>
          <button type="button" class="nd nd-p" data-k="ai" id="n-ai"><b>Claude Haiku</b><span>tri des annonces</span></button>
          <button type="button" class="nd nd-g" data-k="stripe" id="n-stripe"><b>Stripe</b><span>abonnements</span></button>
          <button type="button" class="nd" data-k="mail" id="n-mail"><b>Brevo</b><span>e-mails</span></button>
        </div>
      </div>
      <p class="plan-detail" id="plan-detail" aria-live="polite"><b>Lens</b> Lit l’annonce dans le navigateur, la ramène au bon modèle sur place et affiche le verdict par-dessus.</p>
    </div>
  </section>

  <!-- ========== Méthode ========== -->
  <section class="band b-paper" aria-labelledby="h-method">
    <div class="wrap">
      <h2 class="v-h2" id="h-method">Comment je travaille.</h2>
      <p class="intro">Avec des agents IA, en gardant la main sur chaque étape. Ça n’a pas toujours été le cas.</p>
      <ol class="eras">
        <li class="era"><Draw name="era-gpt" /><p class="era-k">2025</p><h3>ChatGPT sur mon PC</h3><p>Le code naissait dans la conversation. Je le recopiais sur le VPS, fichier par fichier.</p></li>
        <li class="era"><Draw name="era-cc" /><p class="era-k">Janvier–février 2026</p><h3>Claude Code sur le VPS</h3><p>L’agent travaille dans le projet&nbsp;: il lit, modifie, lance les tests. Je passe de copiste à relecteur.</p></li>
        <li class="era"><Draw name="era-lovable" /><p class="era-k">Puis</p><h3>Lovable pour l’interface</h3><p>J’écris les briefs, Claude Code fait le serveur, Lovable l’interface. Je relis chaque diff.</p></li>
        <li class="era"><Draw name="era-git" /><p class="era-k">30 avril 2026</p><h3>Tout passe sous Git</h3><p>450 commits sur l’API en quatre mois, une branche par chantier, un seul script de mise en ligne.</p></li>
      </ol>
      <h3 class="sub-h">Aujourd’hui, chaque fonctionnalité suit ces cinq étapes</h3>
      <MethodPipe />
    </div>
  </section>

  <!-- ========== Choix ========== -->
  <section class="band b-pink" aria-labelledby="h-choix">
    <div class="wrap">
      <h2 class="v-h2" id="h-choix">Six questions, six choix.</h2>
      <div class="choices">
        <article class="card">
          <p class="q">Comment reconnaître le modèle dans un titre&nbsp;?</p>
          <h3>Avec des règles et un catalogue de 7&nbsp;918 écritures</h3>
          <p>Le même titre donne toujours le même modèle&nbsp;: on peut le tester, et ça tourne dans le navigateur sans rien coûter.</p>
          <p class="cut"><span>Écarté</span> demander à une IA pour chaque annonce&nbsp;: plus lent, payant, et pas toujours la même réponse.</p>
        </article>
        <article class="card">
          <p class="q">Comment écarter les fausses annonces&nbsp;?</p>
          <h3>Des règles d’abord, puis Claude Haiku</h3>
          <p>Recherches, boîtes vides, pièces en panne&nbsp;: les règles trient les cas nets, l’IA relit le reste pour environ 0,001&nbsp;$ l’annonce.</p>
          <p class="cut"><span>Écarté</span> laisser l’IA estimer les prix&nbsp;: ils doivent venir de ventes réelles.</p>
        </article>
        <article class="card">
          <p class="q">Quand une annonce est-elle une bonne affaire&nbsp;?</p>
          <h3>Quand la marge de revente le permet</h3>
          <p>On compare le prix demandé au prix de revente, frais déduits, avant puis après la négociation habituelle de la plateforme.</p>
          <p class="cut"><span>Écarté</span> comparer seulement le prix à la moyenne.</p>
        </article>
        <article class="card">
          <p class="q">Quand créditer un abonné&nbsp;?</p>
          <h3>Seulement quand Stripe confirme le paiement</h3>
          <p>Un seul signal crédite, la facture payée, au premier mois comme aux renouvellements. Reçu deux fois, il ne crédite qu’une fois.</p>
          <p class="cut"><span>Écarté</span> créditer dès la fin du formulaire, avant d’être sûr d’être payé.</p>
        </article>
        <article class="card">
          <p class="q">Comment protéger les données des formules payantes&nbsp;?</p>
          <h3>Le serveur ne les envoie qu’aux comptes qui y ont droit</h3>
          <p>Une donnée cachée à l’écran reste lisible dans le navigateur. Une donnée jamais envoyée, non.</p>
          <p class="cut"><span>Écarté</span> tout envoyer et masquer dans l’interface.</p>
        </article>
        <article class="card">
          <p class="q">Que garder des annonces&nbsp;?</p>
          <h3>Le modèle et le prix, rien d’autre</h3>
          <p>Jamais le titre, la photo, l’adresse ou le vendeur&nbsp;: la loi protège les bases de données des sites d’annonces (art. L.341-1). Un prix enregistré n’est jamais modifié.</p>
          <p class="cut"><span>Écarté</span> copier les annonces telles quelles.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ========== Ce qui a cassé ========== -->
  <section class="band b-ink" aria-labelledby="h-bugs">
    <div class="wrap">
      <h2 class="v-h2" id="h-bugs">Ce qui a cassé, et comment je l’ai réparé.</h2>
      <div class="incidents">
        <article class="inc">
          <p class="i-id">Lens · bug signalé</p>
          <h3>Le faux « Ti »</h3>
          <div class="dia" aria-hidden="true">
            <p class="dia-l">Titre lu&nbsp;: <code>MSI RTX 3080 gaming Z trio</code></p>
            <p class="dia-r"><span class="when">Avant</span><span class="tok bad">RTX 3080 Ti</span><span class="verd ko">✗ le nom le plus long gagnait</span></p>
            <p class="dia-r"><span class="when">Après</span><span class="tok good">RTX 3080</span><span class="verd okk">✓ « Ti » absent du titre, refusé</span></p>
          </div>
          <dl class="pcs">
            <div><dt>Le problème</dt><dd>Des RTX 3080 étaient rangées avec les 3080 Ti, plus chères&nbsp;: les prix des deux modèles étaient faussés.</dd></div>
            <div><dt>La cause</dt><dd>La règle prenait le nom du catalogue le plus long qui ressemblait au titre. « RTX 3080 Ti » contient « RTX 3080 » et il est plus long&nbsp;: il gagnait.</dd></div>
            <div><dt>La solution</dt><dd>Un modèle dont le suffixe (Ti, Super, XT) n’est pas dans le titre est refusé. Des tests vérifient les paires piège.</dd></div>
          </dl>
        </article>
        <article class="inc">
          <p class="i-id">Paiement · repéré en relisant le code</p>
          <h3>Le double crédit</h3>
          <div class="dia" aria-hidden="true">
            <p class="dia-r"><span class="when">Avis</span><span class="tok">pas encore traité&nbsp;?</span><span class="verd okk">oui → +1 crédit</span></p>
            <p class="dia-r"><span class="when">Doublon</span><span class="tok lockd">attend le verrou</span><span class="verd okk">déjà traité → rien</span></p>
          </div>
          <dl class="pcs">
            <div><dt>Le problème</dt><dd>Stripe envoie parfois deux fois le même avis de paiement, au même instant. L’abonné aurait reçu ses crédits deux fois.</dd></div>
            <div><dt>La cause</dt><dd>La base refusait bien d’enregistrer deux fois l’avis, mais trop tard&nbsp;: les deux traitements avaient déjà vu « pas encore traité » et crédité.</dd></div>
            <div><dt>La solution</dt><dd>Un verrou par avis&nbsp;: le second attend la fin du premier, voit que c’est fait, et ne crédite pas.</dd></div>
          </dl>
        </article>
        <article class="inc">
          <p class="i-id">Lens · données</p>
          <h3>L’annonce d’avant</h3>
          <div class="dia" aria-hidden="true">
            <p class="dia-r"><span class="when">Adresse</span><span class="tok">annonce n° 2841</span><span></span></p>
            <p class="dia-r"><span class="when">Données</span><span class="tok bad">annonce n° 2790</span><span class="verd okk">≠ → lire l’écran</span></p>
          </div>
          <dl class="pcs">
            <div><dt>Le problème</dt><dd>En passant d’une annonce à l’autre sur Leboncoin, Lens enregistrait parfois le prix de l’annonce précédente.</dd></div>
            <div><dt>La cause</dt><dd>Le site change de page sans la recharger. Les données cachées dans la page restaient celles de la première annonce.</dd></div>
            <div><dt>La solution</dt><dd>Lens compare le numéro de l’adresse à celui des données. S’ils diffèrent, il lit ce qui est affiché.</dd></div>
          </dl>
        </article>
        <article class="inc">
          <p class="i-id">Sécurité · incident, août 2026</p>
          <h3>Deux clés à l’écran</h3>
          <div class="dia dia-term" aria-hidden="true">
            <code>$ docker compose config</code>
            <code>  API_KEY: <mark>••••••••••••</mark></code>
          </div>
          <dl class="pcs">
            <div><dt>Le problème</dt><dd>Pendant une session de travail, une commande a affiché deux clés secrètes en clair dans le terminal.</dd></div>
            <div><dt>La cause</dt><dd>Cette commande affiche toute la configuration en remplaçant chaque variable par sa valeur, secrets compris.</dd></div>
            <div><dt>La solution</dt><dd>Clés révoquées et remplacées. Ces commandes sont interdites sans filtre, et le contenu des fichiers est contrôlé avant chaque envoi sur GitHub.</dd></div>
          </dl>
        </article>
      </div>
    </div>
  </section>

  <!-- ========== Suite ========== -->
  <section class="band b-green" aria-labelledby="h-next">
    <div class="wrap next-grid">
      <div>
        <h2 class="v-h2" id="h-next">Prêt, pas encore lancé.</h2>
        <p class="intro">Tout est en place, paiement compris. Ce qui manque n’est pas technique&nbsp;: les prix viennent des utilisateurs de Lens. Je construis d’abord une communauté autour de l’achat-revente de matériel, sur les réseaux.</p>
      </div>
      <ul class="limits">
        <li><b>Limite</b> Peu de ventes sur un modèle&nbsp;: confiance plus basse, verdict plus prudent.</li>
        <li><b>En cours</b> Alertes de prix, avec Deal Hunter.</li>
        <li><b>Prêt, éteint</b> Diagnostic de panne par IA.</li>
        <li><b>Prévu</b> Simulateur de réparation.</li>
      </ul>
    </div>
  </section>

  <section class="band b-paper v-end">
    <div class="wrap end-grid">
      <a class="nextcard" href="/"><span class="n-k">Projet suivant</span><b>Deal Hunter</b><span class="n-d">Alerter quand un prix passe sous la référence.</span><span class="n-arrow" aria-hidden="true">→</span></a>
      <a class="back" href="/">← Retour à l’accueil</a>
    </div>
    <div class="wrap"><SiteFooter /></div>
  </section>
</main>

<dialog class="lightbox" id="lightbox"><button type="button" class="lb-close" aria-label="Fermer">×</button><img alt="" /></dialog>

<script is:inline>
  (function () {
    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---------- En-tête : une annonce arrive, son titre est lu, le tampon tombe ----------
    var SC = [
      { t: [["rtx3080ti", "m"], ["12go", "g"], ["comme", "n"], ["neuf", "n"], ["!!!", "x"]], p: "420 €", meta: "Bon état · Leboncoin · il y a 4 min", model: "GeForce RTX 3080 Ti", v: "neg", label: "Négocier" },
      { t: [["MSI", "n"], ["RTX 3080", "m"], ["gaming", "n"], ["Z", "n"], ["trio", "n"], ["10Go", "g"]], p: "255 €", meta: "Bon état · Leboncoin · il y a 12 min", model: "GeForce RTX 3080", v: "go", label: "Foncer" },
      { t: [["RTX 4070 Super", "m"], ["dual", "n"], ["OC,", "n"], ["facture", "n"]], p: "560 €", meta: "Bon état · Vinted · il y a 1 h", model: "GeForce RTX 4070 Super", v: "try", label: "Tenter" },
      { t: [["RX 6800 XT", "m"], ["16Go", "g"], ["ex-minage", "n"]], p: "450 €", meta: "Bon état · eBay · il y a 2 h", model: "Radeon RX 6800 XT", v: "pass", label: "Passer" }
    ];
    var CLS = { go: "st-go", neg: "st-neg", try: "st-try", pass: "st-pass" };
    var hs = document.getElementById("hs"), hT = document.getElementById("hs-title"), hStamp = document.getElementById("hs-stamp");
    var rack = hs.querySelectorAll(".rack li"), sc = 0, hsTimers = [];
    function setScene(s) {
      hT.innerHTML = s.t.map(function (w) { return "<span class=\"tkn " + w[1] + "\">" + w[0] + "</span>"; }).join(" ");
      document.getElementById("hs-price").textContent = s.p;
      document.getElementById("hs-meta").textContent = s.meta;
      document.getElementById("hs-model").textContent = "= " + s.model;
      hStamp.className = "stamp hit " + CLS[s.v]; hStamp.textContent = s.label;
      Array.prototype.forEach.call(rack, function (li) { li.classList.toggle("lit", li.getAttribute("data-v") === s.v); });
    }
    // Une annonce se joue en entier (≈ 3 s), reste affichée, puis la suivante arrive.
    // La boucle démarre seule au chargement et ne dépend d'aucun observateur : certains
    // cadres d'aperçu ne signalent jamais la visibilité. L'observateur sert seulement à
    // rejouer l'annonce depuis le début quand l'en-tête revient à l'écran.
    var HOLD = 2600;
    function stop() { hsTimers.forEach(clearTimeout); hsTimers = []; }
    function play() {
      stop();
      var toks = hT.querySelectorAll(".tkn");
      if (reduce) { hs.className = "stamp-scene done"; Array.prototype.forEach.call(toks, function (t) { t.classList.add("lit"); }); return; }
      hs.className = "stamp-scene pre";
      Array.prototype.forEach.call(rack, function (li) { li.dataset.on = li.classList.contains("lit") ? "1" : ""; li.classList.remove("lit"); });
      void hs.offsetWidth;
      hsTimers.push(setTimeout(function () { hs.className = "stamp-scene in"; }, 60));
      Array.prototype.forEach.call(toks, function (t, i) { hsTimers.push(setTimeout(function () { t.classList.add("lit"); }, 700 + i * 150)); });
      var tEnd = 700 + toks.length * 150;
      hsTimers.push(setTimeout(function () { hs.classList.add("model"); }, tEnd + 150));
      hsTimers.push(setTimeout(function () { hs.classList.add("slam"); }, tEnd + 700));
      hsTimers.push(setTimeout(function () {
        hs.classList.add("done");
        Array.prototype.forEach.call(rack, function (li) { if (li.dataset.on) li.classList.add("lit"); });
      }, tEnd + 1050));
      hsTimers.push(setTimeout(function () { next(); }, tEnd + 1050 + HOLD));
    }
    function next() { sc = (sc + 1) % SC.length; setScene(SC[sc]); play(); }
    document.getElementById("hs-next").addEventListener("click", next);
    setScene(SC[0]);
    if (!reduce) {
      hs.className = "stamp-scene pre";            // pas d'état final visible avant le départ
      hsTimers.push(setTimeout(play, 350));
      if ("IntersectionObserver" in window) {
        var wasVisible = null;
        new IntersectionObserver(function (es) {
          var v = es[0].isIntersecting;
          if (v && wasVisible === false) play();   // retour à l'écran : l'annonce se rejoue en entier
          wasVisible = v;
        }, { threshold: .25 }).observe(hs);
      }
      document.addEventListener("visibilitychange", function () { if (!document.hidden) play(); });
    }

    // ---------- Survol des fonctions : sur mobile, le toucher rejoue l'animation ----------
    Array.prototype.forEach.call(document.querySelectorAll(".feat, .fam"), function (el) {
      el.addEventListener("click", function () {
        el.classList.remove("play"); void el.offsetWidth; el.classList.add("play");
        clearTimeout(el._t); el._t = setTimeout(function () { el.classList.remove("play"); }, 1600);
      });
    });

    // ---------- Agrandir une capture ----------
    var lb = document.getElementById("lightbox"), lbImg = lb.querySelector("img");
    Array.prototype.forEach.call(document.querySelectorAll(".zoom"), function (b) {
      b.addEventListener("click", function () {
        var img = b.querySelector("img");
        lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt;
        if (lb.showModal) lb.showModal();
      });
    });
    lb.addEventListener("click", function (e) { if (e.target === lb || e.target.classList.contains("lb-close")) lb.close(); });

    // ---------- Le plan : liaisons dessinées, détail du bloc choisi ----------
    var TXT = {
      lens: ["Lens", "Lit l’annonce dans le navigateur, la ramène au bon modèle sur place et affiche le verdict par-dessus."],
      app: ["Application", "Tableau de bord, estimateur, catalogue, inventaire, guides. Écrite avec Lovable, relue diff par diff."],
      api: ["API", "Reçoit les prix observés, vérifie les droits de chaque formule, sert l’application."],
      est: ["Estimateur", "Choisit la meilleure référence (même état, même plateforme si assez de ventes) et calcule marge et verdict."],
      db: ["PostgreSQL", "Les prix observés ne sont jamais modifiés. Aucun titre, adresse ou vendeur stocké."],
      ai: ["Claude Haiku", "Relit chaque annonce pour confirmer que c’est une vraie vente. Seules les vraies ventes comptent dans les prix."],
      stripe: ["Stripe", "Trois formules et des recharges. Seule la facture payée crédite."],
      mail: ["Brevo", "Vérification de l’adresse, mot de passe oublié, paiements, support."]
    };
    var LINKS = [["n-lens", "n-api", "prix observés"], ["n-app", "n-api", "requêtes"], ["n-api", "n-est", ""], ["n-est", "n-db", ""], ["n-api", "n-ai", "tri"], ["n-stripe", "n-api", "paiements"], ["n-api", "n-mail", "e-mails"]];
    var plan = document.getElementById("plan"), wires = plan.querySelector(".wires"), det = document.getElementById("plan-detail");
    function box(el) { var r = el.getBoundingClientRect(), p = plan.getBoundingClientRect(); return { l: r.left - p.left, t: r.top - p.top, w: r.width, h: r.height }; }
    function anchor(b, to) {
      var cx = b.l + b.w / 2, cy = b.t + b.h / 2;
      if (Math.abs(to.x - cx) > b.w / 2) return { x: to.x > cx ? b.l + b.w : b.l, y: cy };
      return { x: cx, y: to.y > cy ? b.t + b.h : b.t };
    }
    var curK = "n-lens";
    function hi() { Array.prototype.forEach.call(wires.querySelectorAll(".w"), function (w) { w.classList.toggle("hot", w.getAttribute("data-a") === curK || w.getAttribute("data-b") === curK); }); }
    function draw() {
      var p = plan.getBoundingClientRect(), html = "";
      wires.setAttribute("viewBox", "0 0 " + p.width + " " + p.height);
      if (getComputedStyle(wires).display === "none") return;
      LINKS.forEach(function (l) {
        var A0 = box(document.getElementById(l[0])), B0 = box(document.getElementById(l[1]));
        var A = anchor(A0, { x: B0.l + B0.w / 2, y: B0.t + B0.h / 2 }), B = anchor(B0, { x: A0.l + A0.w / 2, y: A0.t + A0.h / 2 });
        var mx = (A.x + B.x) / 2;
        var d = Math.abs(A.x - B.x) < 2 ? "M" + A.x + " " + A.y + "L" + B.x + " " + B.y : "M" + A.x + " " + A.y + "C" + mx + " " + A.y + " " + mx + " " + B.y + " " + B.x + " " + B.y;
        html += "<path d=\"" + d + "\" class=\"w\" data-a=\"" + l[0] + "\" data-b=\"" + l[1] + "\"/>";
        if (l[2]) html += "<text x=\"" + mx + "\" y=\"" + ((A.y + B.y) / 2 - 8) + "\" text-anchor=\"middle\">" + l[2] + "</text>";
      });
      wires.innerHTML = html; hi();
    }
    Array.prototype.forEach.call(plan.querySelectorAll(".nd"), function (n) {
      function show() {
        Array.prototype.forEach.call(plan.querySelectorAll(".nd"), function (o) { o.classList.toggle("on", o === n); });
        var t = TXT[n.getAttribute("data-k")]; det.innerHTML = "<b>" + t[0] + "</b> " + t[1];
        curK = n.id; hi();
      }
      n.addEventListener("click", show);
      n.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") show(); });
    });
    draw();
    window.addEventListener("resize", draw);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
  })();
</script>
</Base>
