<script type="application/json" id="hs-data" set:html={JSON.stringify(HERO_JS)}></script>
<script is:inline>
  (function () {
    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---------- En-tête : une annonce arrive, son titre est lu, le tampon tombe ----------
    // Chaque annonce : elle tombe, son titre est lu, le modèle et la jauge de prix apparaissent,
    // le tampon tombe. Elle reste affichée, puis sort de côté avec son tampon avant que la suivante
    // ne tombe : le contenu ne change jamais sous les yeux.
    var SC = JSON.parse(document.getElementById("hs-data").textContent);
    var CLS = { go: "st-go", neg: "st-neg", try: "st-try", pass: "st-pass" };
    var hs = document.getElementById("hs"), lot = hs.querySelector(".lot"), photo = hs.querySelector(".lot-photo");
    var arts = photo.querySelectorAll(".gpu-v"), gauge = document.getElementById("hs-gauge");
    var hT = document.getElementById("hs-title"), hStamp = document.getElementById("hs-stamp");
    var rack = hs.querySelectorAll(".rack li"), sc = 0, hsTimers = [];
    function $(id) { return document.getElementById(id); }
    function fill(i) {                                // contenu de la carte seulement
      var s = SC[i];
      hT.innerHTML = s.t.map(function (w) { return "<span class=\"tkn " + w[1] + "\">" + w[0] + "</span>"; }).join(" ");
      var PLN = { lbc: "Leboncoin", vin: "Vinted", ebay: "eBay" }, c2 = function (x) { return x.toFixed(2).replace(".", ","); };
      $("hs-price").textContent = s.pl === "lbc" ? s.p + "\u00a0€" : c2(s.p) + (s.pl === "ebay" ? "\u00a0EUR" : "\u00a0€");
      $("hs-incl").hidden = s.pl !== "vin";                 // Vinted : prix avec la protection acheteurs (0,70 € + 5 %)
      $("hs-incl").textContent = c2(s.p + 0.7 + s.p * 0.05) + "\u00a0€ incl.";
      $("hs-pf").textContent = PLN[s.pl]; $("hs-pf").className = "pf " + s.pl;
      lot.className = lot.className.replace(/\bpl-\w+/, "pl-" + s.pl);
      $("hs-meta").textContent = s.meta;
      $("hs-model").textContent = "= " + s.model;
      $("hs-ref").textContent = s.ref + " €";
      $("hs-pc").textContent = s.pc; $("hs-pc").className = "pc" + (s.g.up ? "" : " dn");
      $("hs-why").textContent = s.why;
    }
    function setScene(i) {
      var s = SC[i];
      fill(i);
      lot.style.setProperty("--rot", s.rot + "deg");
      photo.setAttribute("data-bg", s.bg);
      Array.prototype.forEach.call(arts, function (a, k) { a.classList.toggle("on", k === i); });
      ["p", "r", "a", "w"].forEach(function (k) { gauge.style.setProperty("--" + k, s.g[k]); });
      gauge.querySelector(".g-gap").className = "g-gap" + (s.g.up ? "" : " dn");
      hStamp.className = "stamp hit " + CLS[s.v]; hStamp.textContent = s.label;
    }
    function rackOn(on) { Array.prototype.forEach.call(rack, function (li) { li.classList.toggle("lit", on && li.getAttribute("data-v") === SC[sc].v); }); }
    // Toutes les cartes ont la hauteur de la plus haute : rien ne saute sous la carte d'une annonce à l'autre.
    function sizeCard() {
      lot.style.minHeight = "";
      var h = 0;
      for (var i = 0; i < SC.length; i++) { fill(i); h = Math.max(h, lot.offsetHeight); }
      fill(sc);
      if (hs.classList.contains("in") || hs.classList.contains("done")) Array.prototype.forEach.call(hT.querySelectorAll(".tkn"), function (t) { t.classList.add("lit"); });
      lot.style.minHeight = h + "px";
    }

    var HOLD = 3000, EXIT = 480;
    function stop() { hsTimers.forEach(clearTimeout); hsTimers = []; }
    function reset() {                                // retour instantané au départ, carte invisible
      hs.className = "stamp-scene pre notr"; rackOn(false);
      void hs.offsetWidth; hs.classList.remove("notr");
    }
    function play() {                                 // joue l'annonce courante depuis le début
      stop();
      var toks = hT.querySelectorAll(".tkn");
      if (reduce) { hs.className = "stamp-scene done"; Array.prototype.forEach.call(toks, function (t) { t.classList.add("lit"); }); rackOn(true); return; }
      reset();
      hsTimers.push(setTimeout(function () { hs.className = "stamp-scene in"; }, 60));
      Array.prototype.forEach.call(toks, function (t, i) { hsTimers.push(setTimeout(function () { t.classList.add("lit"); }, 700 + i * 150)); });
      var tEnd = 700 + toks.length * 150;
      hsTimers.push(setTimeout(function () { hs.classList.add("model"); }, tEnd + 150));
      hsTimers.push(setTimeout(function () { hs.classList.add("slam"); }, tEnd + 950));
      hsTimers.push(setTimeout(function () { hs.classList.add("done"); rackOn(true); }, tEnd + 1300));
      hsTimers.push(setTimeout(next, tEnd + 1300 + HOLD));
    }
    function next() {                                 // la carte tamponnée sort, la suivante tombe
      stop();
      var go = function () { sc = (sc + 1) % SC.length; setScene(sc); play(); };
      if (reduce) return go();
      hs.classList.add("out"); rackOn(false);
      hsTimers.push(setTimeout(go, EXIT));
    }
    var armed = true;                                 // l'annonce se rejouera depuis le début à la prochaine arrivée
    $("hs-next").addEventListener("click", function () {
      armed = false; next();
      // La scène est décorative (masquée aux lecteurs d'écran) : le bouton annonce en texte l'annonce qui arrive
      setTimeout(function () {                        // une fois la nouvelle annonce en place
        var s = SC[sc]; $("hs-say").textContent = "Annonce inventée : " + s.model + " à " + $("hs-price").textContent + ". Verdict : " + s.label + ".";
      }, reduce ? 0 : EXIT + 30);
    });
    setScene(0);
    sizeCard();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sizeCard);
    var rsz; addEventListener("resize", function () { clearTimeout(rsz); rsz = setTimeout(sizeCard, 150); });
    if (!reduce) {
      reset();                                        // pas d'état final visible avant le départ
      hsTimers.push(setTimeout(play, 350));
      // La boucle ne dépend pas de l'observateur. Il remet l'annonce au départ quand l'en-tête
      // a complètement quitté l'écran, et la rejoue en entier quand il en montre au moins un quart.
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          var e = es[0];
          if (!e.isIntersecting) { if (!armed) { stop(); reset(); armed = true; } return; }
          if (armed && e.intersectionRatio >= .25) { armed = false; play(); }
        }, { threshold: [0, .25] }).observe(hs);
      }
    }

    // ---------- Suite : la boucle tourne, la jauge de confiance se construit ----------
    // Les deux se rejouent depuis le début à chaque arrivée ; hors écran, elles reviennent au départ.
    // Sans observateur ou en mouvement réduit : état final, statique.
    (function () {
      var loopBox = document.getElementById("nx-loop"), meterBox = document.getElementById("nx-meter");
      var nodes = loopBox.querySelectorAll(".ln"), arrows = loopBox.querySelectorAll(".la");
      var needle = document.getElementById("mt-needle"), val = document.getElementById("mt-val");
      var rows = meterBox.querySelectorAll(".mt-f li");
      if (reduce || !("IntersectionObserver" in window)) return;
      function each(list, fn) { Array.prototype.forEach.call(list, fn); }

      var lt = null, step = 0;
      function loopTick() {                          // nœud k, puis la flèche qui mène au suivant
        var k = Math.floor(step / 2) % nodes.length;
        each(nodes, function (n, i) { n.classList.toggle("on", i === k); });
        each(arrows, function (a, i) { a.classList.toggle("on", step % 2 === 1 && i === k); });
        step = (step + 1) % (nodes.length * 2);
      }
      function loopStart() { loopStop(); step = 0; loopTick(); lt = setInterval(loopTick, 750); }
      function loopStop() { clearInterval(lt); lt = null; each(nodes, function (n) { n.classList.remove("on"); }); each(arrows, function (a) { a.classList.remove("on"); }); }

      var mTimers = [], total = 0;
      function setNeedle(v, instant) {
        if (instant) { needle.style.transition = "none"; }
        needle.style.setProperty("--v", v); val.textContent = v + " %";
        if (instant) { void needle.offsetWidth; needle.style.transition = ""; }
      }
      function meterReset() { mTimers.forEach(clearTimeout); mTimers = []; each(rows, function (r) { r.classList.remove("on"); }); setNeedle(35, true); }
      function meterPlay() {
        meterReset(); total = 0;
        each(rows, function (r, i) {
          mTimers.push(setTimeout(function () { total += +r.getAttribute("data-d") || 0; r.classList.add("on"); setNeedle(35 + total); }, 300 + i * 750));
        });
      }
      meterReset();                                  // départ silencieux : la section est loin sous la ligne de flottaison
      function watch(el, start, stop) {
        var armed = true;
        new IntersectionObserver(function (es) {
          var e = es[0];
          if (!e.isIntersecting) { if (!armed) { stop(); armed = true; } return; }
          if (armed && e.intersectionRatio >= .35) { armed = false; start(); }
        }, { threshold: [0, .35] }).observe(el);
      }
      watch(loopBox, loopStart, loopStop);
      watch(meterBox, meterPlay, meterReset);
    })();

    // ---------- Survol des fonctions : sur mobile, le toucher rejoue l'animation ----------
    Array.prototype.forEach.call(document.querySelectorAll(".feat, .fam"), function (el) {
      el.addEventListener("click", function () {
        el.classList.remove("play"); void el.offsetWidth; el.classList.add("play");
        clearTimeout(el._t); el._t = setTimeout(function () { el.classList.remove("play"); }, 1600);
      });
    });

    // ---------- Agrandir une capture ----------
    var lb = document.getElementById("lightbox"), lbImg = lb.querySelector("img");
    Array.prototype.forEach.call(document.querySelectorAll(".zoom"), function (b) {
      b.addEventListener("click", function () {
        var img = b.querySelector("img");
        lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt;
        if (lb.showModal) lb.showModal();
      });
    });
    lb.addEventListener("click", function (e) { if (e.target === lb || e.target.classList.contains("lb-close")) lb.close(); });

    // ---------- Le plan : liaisons dessinées, détail du bloc choisi ----------
    var TXT = {
      lens: ["Lens", "Lit l’annonce dans le navigateur, la ramène au bon modèle sur place et affiche le verdict par-dessus."],
      app: ["Application", "Tableau de bord, estimateur, catalogue, inventaire, guides. Écrite avec Lovable, relue diff par diff."],
      api: ["API", "Reçoit les prix observés, vérifie les droits de chaque formule, sert l’application."],
      est: ["Estimateur", "Choisit la meilleure référence (même état, même plateforme si assez de ventes) et calcule marge et verdict."],
      db: ["PostgreSQL", "Les prix observés ne sont jamais modifiés. Aucun titre, adresse ou vendeur stocké."],
      ai: ["Claude Haiku", "Relit chaque annonce pour confirmer que c’est une vraie vente. Seules les vraies ventes comptent dans les prix."],
      stripe: ["Stripe", "Trois formules et des recharges. Seule la facture payée crédite."],
      mail: ["Brevo", "Vérification de l’adresse, mot de passe oublié, paiements, support."]
    };
    var LINKS = [["n-lens", "n-api", "prix observés"], ["n-app", "n-api", "requêtes"], ["n-api", "n-est", ""], ["n-est", "n-db", ""], ["n-api", "n-ai", "tri"], ["n-stripe", "n-api", "paiements"], ["n-api", "n-mail", "e-mails"]];
    var plan = document.getElementById("plan"), wires = plan.querySelector(".wires"), det = document.getElementById("plan-detail");
    function box(el) { var r = el.getBoundingClientRect(), p = plan.getBoundingClientRect(); return { l: r.left - p.left, t: r.top - p.top, w: r.width, h: r.height }; }
    function anchor(b, to) {
      var cx = b.l + b.w / 2, cy = b.t + b.h / 2;
      if (Math.abs(to.x - cx) > b.w / 2) return { x: to.x > cx ? b.l + b.w : b.l, y: cy };
      return { x: cx, y: to.y > cy ? b.t + b.h : b.t };
    }
    var curK = "n-lens";
    function hi() { Array.prototype.forEach.call(wires.querySelectorAll(".w"), function (w) { w.classList.toggle("hot", w.getAttribute("data-a") === curK || w.getAttribute("data-b") === curK); }); }
    function draw() {
      var p = plan.getBoundingClientRect(), html = "";
      wires.setAttribute("viewBox", "0 0 " + p.width + " " + p.height);
      if (getComputedStyle(wires).display === "none") return;
      LINKS.forEach(function (l) {
        var A0 = box(document.getElementById(l[0])), B0 = box(document.getElementById(l[1]));
        var A = anchor(A0, { x: B0.l + B0.w / 2, y: B0.t + B0.h / 2 }), B = anchor(B0, { x: A0.l + A0.w / 2, y: A0.t + A0.h / 2 });
        var mx = (A.x + B.x) / 2;
        var d = Math.abs(A.x - B.x) < 2 ? "M" + A.x + " " + A.y + "L" + B.x + " " + B.y : "M" + A.x + " " + A.y + "C" + mx + " " + A.y + " " + mx + " " + B.y + " " + B.x + " " + B.y;
        html += "<path d=\"" + d + "\" class=\"w\" data-a=\"" + l[0] + "\" data-b=\"" + l[1] + "\"/>";
        if (l[2]) html += "<text x=\"" + mx + "\" y=\"" + ((A.y + B.y) / 2 - 8) + "\" text-anchor=\"middle\">" + l[2] + "</text>";
      });
      wires.innerHTML = html; hi();
    }
    Array.prototype.forEach.call(plan.querySelectorAll(".nd"), function (n) {
      function show() {
        Array.prototype.forEach.call(plan.querySelectorAll(".nd"), function (o) { o.classList.toggle("on", o === n); });
        var t = TXT[n.getAttribute("data-k")]; det.innerHTML = "<b>" + t[0] + "</b> " + t[1];
        curK = n.id; hi();
      }
      n.addEventListener("click", show);
      n.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") show(); });
    });
    draw();
    window.addEventListener("resize", draw);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
  })();
</script>
