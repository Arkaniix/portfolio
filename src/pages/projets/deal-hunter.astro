<script is:inline>
  (function () {
    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    function each(l, f) { Array.prototype.forEach.call(l, f); }
    function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

    // ---------- En-tête : le salon en direct ----------
    // Les annonces arrivent à intervalles aléatoires. Chacune passe dans le navigateur par le vrai code du bot
    // (filtres, modèle, profit, mémoire, salon, mentions), avec les réglages laissés dans #bot-settings et #settings-etienne.
    // « Analyser », « Signaler », la liste des signalements et les panneaux répondent comme le bot (bot.py, report_view.py, settings.py, user_panel.py).
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var op = $("op"), E = window.DealHunterEngine, D = window.DHDiscord;
      var L = JSON.parse($("live-data").textContent), NAMES = JSON.parse($("live-names").textContent);
      var raw = JSON.parse($("dh-data").textContent);                  // catalogue GPU (noms) et marché inventé
      var data = { index: E.buildModelIndex(raw.catalog), market: raw.market.gpu, cpu: raw.market.cpu };
      var feeds = {}, chs = {}, cur = "deals_fire", timer = null, paused = false, seen = false, visible = false;
      var admin = JSON.parse(JSON.stringify(L.pipe)), me = JSON.parse(JSON.stringify(L.me));
      var state, idx, counts, posts, analyses = 0, reports = [], reportSeq = 0, pending = null, toastT = null;
      each(op.querySelectorAll(".dsc-feed"), function (f) { feeds[f.getAttribute("data-ch")] = f; });
      each(op.querySelectorAll(".dsc-side .dsc-ch"), function (b) { chs[b.getAttribute("data-ch")] = b; });
      function pad(n) { return String(n).padStart(2, "0"); }
      function now() { var d = new Date(); return "Aujourd’hui à " + d.getHours() + ":" + pad(d.getMinutes()); }
      function sqlNow() { var d = new Date(); return d.getUTCFullYear() + "-" + pad(d.getUTCMonth() + 1) + "-" + pad(d.getUTCDate()) + " " + pad(d.getUTCHours()) + ":" + pad(d.getUTCMinutes()) + ":" + pad(d.getUTCSeconds()); }
      function stamp(root) { each(root.querySelectorAll(".msg-h time"), function (t) { t.textContent = now(); }); }
      function quote(ev) { return (ev.price_drop ? "📉 BAISSE DE PRIX" : D.VERDICT[ev.verdict.k]) + "  " + (ev.matched_model ? ev.matched_model.name : ""); }
      function atBottom(f) { return f.scrollHeight - f.scrollTop - f.clientHeight < 60; }
      function toBottom(f, smooth) { f.scrollTo({ top: f.scrollHeight, behavior: smooth && !reduce ? "smooth" : "auto" }); }
      function frag(html) { var b = document.createElement("div"); b.innerHTML = html; return b.firstElementChild; }
      function append(ch, html, isNew) {
        var f = feeds[ch], stick = atBottom(f), el = frag(html);
        stamp(el);
        if (isNew && !reduce) el.classList.add("new");
        f.appendChild(el);
        if (ch === cur && (stick || isNew)) toBottom(f, true);
        return el;
      }
      function unread(ch, mention) {
        if (ch === cur) return;
        chs[ch].classList.add("unr");
        if (mention) chs[ch].setAttribute("data-m", +(chs[ch].getAttribute("data-m") || 0) + 1);
        badges();
      }
      function badges() {
        var other = 0;
        Object.keys(chs).forEach(function (k) {
          var b = chs[k].querySelector(".dsc-badge"), n = +(chs[k].getAttribute("data-m") || 0);
          b.hidden = !n; b.textContent = n; if (k !== cur) other += n;
        });
        var mb = op.querySelector(".dsc-menu .dsc-badge"); mb.hidden = !other; mb.textContent = other;
      }
      function show(ch) {
        cur = ch;
        Object.keys(chs).forEach(function (k) { chs[k].classList.toggle("on", k === ch); });
        Object.keys(feeds).forEach(function (k) { feeds[k].classList.toggle("on", k === ch); });
        chs[ch].classList.remove("unr"); chs[ch].setAttribute("data-m", "0");
        $("op-chn").textContent = NAMES[ch]; $("op-in").textContent = NAMES[ch];
        op.classList.remove("drawer"); badges(); toBottom(feeds[ch], false);
      }
      function status() {
        $("lv-read").textContent = counts.read; $("lv-post").textContent = counts.post; $("lv-out").textContent = counts.out;
        var done = idx >= L.ads.length;
        $("lv-st").textContent = done ? "Plus de nouvelles annonces pour l’instant" : paused ? "Bot en pause" : "Bot en chasse";
        $("op-live").classList.toggle("off", done || paused);
        $("lv-pause").textContent = done ? "Rejouer" : paused ? "Reprendre" : "Pause";
      }
      // Une annonce de plus : le killswitch d'une plateforme la fait sauter avant toute lecture
      function post(isNew) {
        while (idx < L.ads.length) {
          var a = L.ads[idx++];
          if (!admin[a.platform === "vinted" ? "vinted_enabled" : "lbc_enabled"]) continue;
          counts.read++;
          var r = E.processAd({ ad_id: a.id, title: a.title, price_eur: a.price, platform: a.platform, description: a.description, condition: a.condition }, data, state, admin, [me]);
          if (r.stop) { counts.out++; return; }
          counts.post++;
          var who = r.who.filter(function (w) { return w.pinged; }).map(function (w) { return w.name; });
          var n = posts.length;
          posts.push({ id: a.id, title: a.title, price: a.price, ch: r.channel, ai: a.ai, hs: a.hs, quote: quote(r.ev) });
          append(r.channel, "<div class=\"lv\" data-i=\"" + n + "\">" + D.deal({ ev: r.ev, ad: r.ad, token: r.steps[1] && r.steps[1].token, city: a.city, ago: a.ago,
            who: who, mine: who.length > 0, thumb: L.pics[a.pic] }) + "</div>", isNew);
          unread(r.channel, who.length > 0);
          return;
        }
      }
      function schedule() {
        clearTimeout(timer); timer = null;
        if (paused || !visible || idx >= L.ads.length) { status(); return; }
        timer = setTimeout(function () { post(true); status(); schedule(); }, 1800 + Math.random() * 3400);
        status();
      }
      // Mémoire neuve : la première annonce (celle de l'en-tête) est déjà passée
      function start() {
        state = { seen: {}, sent: {} }; idx = 0; counts = { read: 1, post: 1, out: 0 }; posts = [L.first];
        var f = L.first;
        E.processAd({ ad_id: f.id, title: f.title, price_eur: f.price, platform: f.platform, description: f.description }, data, state, admin, [me]);
      }
      function reset() {
        clearTimeout(timer);
        Object.keys(feeds).forEach(function (k) { each(feeds[k].querySelectorAll(".lv:not([data-i=\"0\"]), .eph, .lv-rp"), function (n) { n.remove(); }); });
        Object.keys(chs).forEach(function (k) { chs[k].classList.remove("unr"); chs[k].setAttribute("data-m", "0"); });
        reports = []; drawAdmin(false); start(); show("deals_fire");
      }
      // Panneaux : #bot-settings est renvoyé (nouveau message) après un signalement, édité sur place après un réglage
      function drawAdmin(resend) {
        var box = feeds["bot-settings"].querySelector(".lv-adm"), t = box.querySelector(".msg-h time").textContent;
        var html = D.adminPanel(admin, { reports: reports.length, time: resend ? now() : t });
        if (resend) { box.remove(); append("bot-settings", "<div class=\"lv-adm\">" + html + "</div>", true); unread("bot-settings", false); }
        else box.innerHTML = html;
      }
      // Réponses visibles par vous seul (messages éphémères de Discord)
      function eph(inner, cls) {
        return append(cur, "<div class=\"msg eph" + (cls ? " " + cls : "") + "\">" + D.head({}) + "<div class=\"msg-b\">" + inner +
          "<p class=\"eph-n\"><span aria-hidden=\"true\">👁</span> Vous seul·e pouvez voir ceci · <button type=\"button\" class=\"eph-x\">Ignorer ce message</button></p></div></div>", true);
      }
      function say(text) { toBottom(feeds[cur], true); return eph("<p class=\"msg-c\">" + text + "</p>"); }
      function toast(text) {
        var t = $("op-toast"); t.textContent = text; t.hidden = false;
        clearTimeout(toastT); toastT = setTimeout(function () { t.hidden = true; }, 2600);
      }
      function reportItems() {
        return reports.map(function (r) { return { id: r.id, title: r.title, price: r.price, ch: NAMES[r.ch], by: me.username, reason: r.reason, ts: r.ts, i: r.i }; });
      }
      function drawList(el, sel) { el.querySelector(".lv-list").innerHTML = D.reports(reportItems(), sel); el.setAttribute("data-sel", sel == null ? "" : sel); }
      function activeFor(id) { for (var k = 0; k < reports.length; k++) if (reports[k].adId === id) return reports[k]; return null; }

      op.addEventListener("click", function (e) {
        var t = e.target, b;
        if ((b = t.closest(".dsc-side .dsc-ch"))) return show(b.getAttribute("data-ch"));
        if (t.closest(".dsc-menu")) return op.classList.toggle("drawer");
        if (op.classList.contains("drawer") && !t.closest(".dsc-side")) { op.classList.remove("drawer"); return; }
        if ((b = t.closest(".eph-x"))) return b.closest(".eph").remove();
        // Panneau de #bot-settings
        if ((b = t.closest(".lv-adm button[data-a]"))) {
          var k = b.getAttribute("data-a");
          if (k === "reports") {
            var el = eph("<div class=\"lv-list\"></div>", "lv-rl"); drawList(el, null); toBottom(feeds[cur], true); return;
          }
          admin[k] = !admin[k]; return drawAdmin(false);
        }
        // Liste des signalements
        if ((b = t.closest(".lv-rl [data-a]")) && b.tagName === "BUTTON") {
          var box = b.closest(".lv-rl"), a = b.getAttribute("data-a");
          if (a === "close") { box.querySelector(".lv-list").innerHTML = "<p class=\"msg-c\">Fermé.</p>"; return; }
          if (a === "goto") {
            var target = op.querySelector(".lv[data-i=\"" + b.getAttribute("data-v") + "\"]");
            if (!target) return say("Message introuvable.");
            show(target.parentNode.getAttribute("data-ch"));
            target.scrollIntoView({ block: "center", behavior: reduce ? "auto" : "smooth" });
            target.classList.remove("hl"); void target.offsetWidth; target.classList.add("hl"); return;
          }
          if (a === "resolve") {
            var sel = +box.getAttribute("data-sel");
            reports = reports.filter(function (r) { return r.id !== sel; });
            drawAdmin(true); drawList(box, null); return;
          }
        }
        var lv = t.closest(".lv"); if (!lv) return;
        var ev = posts[+lv.getAttribute("data-i")];
        if (t.closest(".mb-link")) return toast("Lien désactivé : l’annonce est inventée.");
        if (t.closest(".mb-pri")) {
          if (analyses >= 5) return say("⚠️ Limite personnelle atteinte (" + analyses + "/5 analyses cette heure). Réessaie plus tard.");
          analyses++;
          var think = append(cur, "<div class=\"msg lv-rp\">" + D.head({}) + "<div class=\"msg-b\"><p class=\"think\">Deal Hunter réfléchit<span class=\"dots\"><i></i><i></i><i></i></span></p></div></div>", true);
          setTimeout(function () {
            var box = document.createElement("div"), f = think.parentNode, stick = atBottom(f);
            box.innerHTML = D.analysis({ sections: ev.ai, quote: ev.quote, cls: "lv-rp" }) + "<p class=\"ai-tag lv-rp\">Réponse écrite pour la démo, au format exact du bot" + (ev.hs ? ", consigne réparateur" : "") + ".</p>";
            think.replaceWith.apply(think, Array.prototype.slice.call(box.childNodes)); stamp(f);
            if (stick) toBottom(f, true);
          }, reduce ? 0 : 1100 + Math.random() * 900);
          return;
        }
        if (t.closest(".mb-dan")) {
          var ex = activeFor(ev.id);
          if (ex) return say("⚠️ Cette annonce a déjà un signalement actif (par <span class=\"ment\">@" + me.username + "</span> le " + ex.ts + ").<br>Le signalement sera réactivable une fois résolu.");
          pending = +lv.getAttribute("data-i"); $("op-why").value = ""; $("op-modal").hidden = false; $("op-why").focus({ preventScroll: true });
        }
      });
      op.addEventListener("change", function (e) {
        var s = e.target; if (s.tagName !== "SELECT") return;
        var a = s.getAttribute("data-a");
        if (a === "pick") return drawList(s.closest(".lv-rl"), s.value === "" ? null : +s.value);
        admin[a] = +s.value; drawAdmin(false);
      });
      function closeModal() { $("op-modal").hidden = true; pending = null; }
      $("op-cancel").addEventListener("click", closeModal);
      $("op-modal").addEventListener("click", function (e) { if (e.target.id === "op-modal") closeModal(); });
      op.addEventListener("keydown", function (e) { if (e.key === "Escape" && !$("op-modal").hidden) closeModal(); });
      $("op-form").addEventListener("submit", function (e) {
        e.preventDefault(); if (pending === null) return;
        var p = posts[pending];
        reports.push({ id: ++reportSeq, adId: p.id, title: p.title, price: p.price, ch: p.ch, reason: $("op-why").value.trim(), ts: sqlNow(), i: pending });
        closeModal();
        say("🚩 Signalement enregistré (#" + reportSeq + ").<br>Visible dans <code>#bot-settings</code> → <b>🚩 Voir détails</b>.");
        drawAdmin(true);
      });
      $("lv-pause").addEventListener("click", function () {
        if (idx >= L.ads.length) { reset(); paused = false; }
        else paused = !paused;
        if (reduce) { while (idx < L.ads.length) post(false); status(); return; }
        schedule();
      });
      // Panneau perso de #settings-etienne : mêmes commandes que dans Discord ; les annonces suivantes en tiennent compte
      D.bindPanel(feeds["settings-etienne"].querySelector(".lv-me"), { host: op, user: function () { return me; },
        maxGlobal: function () { return admin.max_price; }, change: function () {}, say: function (t) { say(t); } });
      start(); stamp(feeds.deals_fire); toBottom(feeds.deals_fire, false);
      if (reduce || !("IntersectionObserver" in window)) {
        op.classList.add("in");
        while (idx < L.ads.length) post(false);
        status(); return;
      }
      new IntersectionObserver(function (es) {
        var e = es[0];
        visible = e.isIntersecting;
        if (visible && !seen && e.intersectionRatio >= .3) { seen = true; void op.offsetWidth; op.classList.add("in"); }
        schedule();
      }, { threshold: [0, .3] }).observe(op);
      status();
    })();

    // ---------- Le trajet : l'étape lue fixe l'état de l'annonce suivie ----------
    (function () {
      var fol = document.getElementById("fol"), stns = document.querySelectorAll(".stn"), cur = 0, f = "s1";
      var ps = document.querySelectorAll(".fs"), dots = fol.querySelectorAll(".fol-dots li");
      function show() {
        var n = cur || 1;
        fol.setAttribute("data-n", n); fol.setAttribute("data-f", f);
        each(ps, function (p) { p.classList.toggle("on", p.getAttribute("data-f") === f && +p.getAttribute("data-n") === n); });
        each(stns, function (s) { s.classList.toggle("now", +s.getAttribute("data-n") === n); });
        each(dots, function (d) { var k = +d.getAttribute("data-n"); d.className = k < n ? "past" : k === n ? "now" : ""; });
        fol.classList.toggle("lit", n >= 3);
        var stop = document.querySelector('.fs[data-f="' + f + '"][data-n="' + n + '"]');
        fol.classList.toggle("stopped", !!(stop && stop.hasAttribute("data-stop")));
        if (!reduce) { fol.classList.remove("tick"); void fol.offsetWidth; fol.classList.add("tick"); }
      }
      each(document.querySelectorAll(".pk"), function (b) {
        b.addEventListener("click", function () {
          f = b.getAttribute("data-f");
          each(document.querySelectorAll(".pk"), function (o) { var on = o === b; o.classList.toggle("on", on); o.setAttribute("aria-selected", String(on)); });
          each(fol.querySelectorAll(".fol-ann"), function (v) { v.classList.toggle("on", v.getAttribute("data-f") === f); });
          show();
        });
      });
      show();
      if (!("IntersectionObserver" in window)) { each(stns, function (s) { s.classList.add("arr"); }); return; }
      // Étape courante : celle qui traverse le milieu de l'écran
      var vis = {};
      var mid = new IntersectionObserver(function (es) {
        es.forEach(function (e) { vis[e.target.getAttribute("data-n")] = e.isIntersecting; });
        var n = 0; for (var k = 1; k <= 8; k++) if (vis[k]) n = k;
        if (n && n !== cur) { cur = n; show(); }
      }, { rootMargin: "-45% 0px -50% 0px" });
      // Animation d'arrivée de chaque étape : jouée en entier à chaque entrée à l'écran
      var arr = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          var s = e.target;
          if (e.isIntersecting && e.intersectionRatio >= .15) { if (!s.classList.contains("arr")) { void s.offsetWidth; s.classList.add("arr"); } }
          else if (!e.isIntersecting) s.classList.remove("arr");
