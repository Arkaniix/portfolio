<script type="application/json" id="who-data" set:html={JSON.stringify({ me: ME, other: OTHER, deals: WHO_DEALS.map((sid) => bySid[sid]), pipeline: PIPELINE, channels: CHANNEL_INFO, pics: Object.fromEntries(Object.keys(PIC).map((k) => [k, PIC[k].bg])) })}></script>
<script is:inline>
  (function () {
    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    function each(l, f) { Array.prototype.forEach.call(l, f); }
    function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

    // ---------- En-tête : le message arrive, à chaque retour sur l'en-tête ----------
    (function () {
      var op = document.getElementById("op");
      if (reduce || !("IntersectionObserver" in window)) { op.classList.add("in"); return; }
      var armed = true;
      new IntersectionObserver(function (es) {
        var e = es[0];
        if (!e.isIntersecting) { if (!armed) { op.classList.remove("in"); armed = true; } return; }
        if (armed && e.intersectionRatio >= .3) { armed = false; void op.offsetWidth; op.classList.add("in"); }
      }, { threshold: [0, .3] }).observe(op);
    })();

    // ---------- Le trajet : l'étape lue fixe l'état de l'annonce suivie ----------
    (function () {
      var fol = document.getElementById("fol"), stns = document.querySelectorAll(".stn"), cur = 0, f = "s1";
      var ps = document.querySelectorAll(".fs"), dots = fol.querySelectorAll(".fol-dots li");
      function show() {
        var n = cur || 1;
        fol.setAttribute("data-n", n); fol.setAttribute("data-f", f);
        each(ps, function (p) { p.classList.toggle("on", p.getAttribute("data-f") === f && +p.getAttribute("data-n") === n); });
        each(stns, function (s) { s.classList.toggle("now", +s.getAttribute("data-n") === n); });
        each(dots, function (d) { var k = +d.getAttribute("data-n"); d.className = k < n ? "past" : k === n ? "now" : ""; });
        fol.classList.toggle("lit", n >= 3);
        var stop = document.querySelector('.fs[data-f="' + f + '"][data-n="' + n + '"]');
        fol.classList.toggle("stopped", !!(stop && stop.hasAttribute("data-stop")));
        if (!reduce) { fol.classList.remove("tick"); void fol.offsetWidth; fol.classList.add("tick"); }
      }
      each(document.querySelectorAll(".pk"), function (b) {
        b.addEventListener("click", function () {
          f = b.getAttribute("data-f");
          each(document.querySelectorAll(".pk"), function (o) { var on = o === b; o.classList.toggle("on", on); o.setAttribute("aria-selected", String(on)); });
          each(fol.querySelectorAll(".pv"), function (v) { v.classList.toggle("on", v.getAttribute("data-f") === f); });
          each(fol.querySelectorAll(".fol-ann"), function (v) { v.classList.toggle("on", v.getAttribute("data-f") === f); });
          fol.querySelector(".fol-pic").setAttribute("data-bg", fol.querySelector('.pv[data-f="' + f + '"]').getAttribute("data-bg"));
          show();
        });
      });
      fol.querySelector(".fol-pic").setAttribute("data-bg", fol.querySelector(".pv.on").getAttribute("data-bg"));
      show();
      if (!("IntersectionObserver" in window)) { each(stns, function (s) { s.classList.add("arr"); }); return; }
      // Étape courante : celle qui traverse le milieu de l'écran
      var vis = {};
      var mid = new IntersectionObserver(function (es) {
        es.forEach(function (e) { vis[e.target.getAttribute("data-n")] = e.isIntersecting; });
        var n = 0; for (var k = 1; k <= 8; k++) if (vis[k]) n = k;
        if (n && n !== cur) { cur = n; show(); }
      }, { rootMargin: "-45% 0px -50% 0px" });
      // Animation d'arrivée de chaque étape : jouée en entier à chaque entrée à l'écran
      var arr = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          var s = e.target;
          if (e.isIntersecting && e.intersectionRatio >= .15) { if (!s.classList.contains("arr")) { void s.offsetWidth; s.classList.add("arr"); } }
          else if (!e.isIntersecting) s.classList.remove("arr");
        });
      }, { threshold: [0, .15] });
      each(stns, function (s) { mid.observe(s); if (reduce) s.classList.add("arr"); else arr.observe(s); });
    })();

    // ---------- Survols : sur mobile, le toucher rejoue l'animation ----------
    each(document.querySelectorAll(".sieve li, .sal6 li, .fork, .rep, .ai-c"), function (el) {
      el.addEventListener("click", function () {
        el.classList.remove("play"); void el.offsetWidth; el.classList.add("play");
        clearTimeout(el._t); el._t = setTimeout(function () { el.classList.remove("play"); }, 1600);
      });
    });

    // ---------- Deux chasseurs : les mentions se recalculent ----------
    (function () {
      var E = window.DealHunterEngine, W = JSON.parse(document.getElementById("who-data").textContent);
      if (!E) return;
      var raw = JSON.parse(document.getElementById("dhd-data").textContent);
      var data = { index: E.buildModelIndex(raw.catalog), market: raw.market.gpu, cpu: raw.market.cpu };
      var users = { me: JSON.parse(JSON.stringify(W.me)), other: JSON.parse(JSON.stringify(W.other)) };
      var R = W.deals.map(function (s) {
        return { s: s, r: E.processAd({ ad_id: s.id, title: s.title, price_eur: s.price, platform: s.platform, description: s.description || "", condition: s.condition || null }, data, { seen: {}, sent: {} }, W.pipeline, [users.me]) };
      });
      var cur = 0, auto = null, who = document.getElementById("who"), note = {};
      function eur(x) { var r = Math.round(x); return (r > 0 ? "+" : r < 0 ? "−" : "") + Math.abs(r) + " €"; }
      function render() {
        var d = R[cur], ev = d.r.ev, ch = W.channels[d.r.channel];
        document.getElementById("who-deal").innerHTML =
          "<div class=\"wd\"><span class=\"wd-pic\" data-bg=\"" + W.pics[d.s.pic] + "\">" + (document.querySelector("#dhd-pic .pv[data-k=\"" + d.s.pic + "\"]") || { outerHTML: "" }).outerHTML.replace(" on\"", "\"") + "</span>" +
          "<div><p class=\"wd-t\">" + esc(d.s.title) + "</p><p class=\"wd-m\">" + d.s.price + " € · " + (d.s.platform === "vinted" ? "Vinted" : "Leboncoin") + "</p>" +
          "<p class=\"wd-r\"><span class=\"salpill c-" + ch.c + "\"># " + ch.name + "</span><b>" + eur(ev.best_profit) + "</b> de profit</p></div></div>";
        var off = users.me.presence === "OFF" && users.other.presence === "OFF";
        var res = E.mentions([users.me, users.other], ev, d.r.channel);
        document.getElementById("who-bot").innerHTML = off ? "<b>Bot en pause</b>&nbsp;: plus personne ne chasse, les annonces ne sont même plus lues." : "<b>Bot en chasse</b>&nbsp;: au moins un chasseur est ON.";
        who.classList.toggle("paused", off);
        ["me", "other"].forEach(function (k, j) {
          var box = who.querySelector("[data-res=\"" + k + "\"]"), r = res[j];
          box.className = "hunt-res " + (off ? "zz" : r.pinged ? "yes" : "no");
          box.innerHTML = off ? "Bot en pause&nbsp;: annonce jamais lue" : r.pinged ? "<b>@" + esc(r.name) + "</b> mentionné" : "Silencieux&nbsp;: " + esc(r.why) + (note[k] ? "<em>" + note[k] + "</em>" : "");
          if (!off && r.pinged && note[k]) box.innerHTML += "<em>" + note[k] + "</em>";
          var p = who.querySelector("[data-u=\"" + k + "\"]"), u = users[k];
          each(p.querySelectorAll("[data-f]"), function (b) {
            var fl = b.getAttribute("data-f");
            if (fl === "presence") { b.textContent = u.presence; b.setAttribute("aria-pressed", u.presence === "ON" ? "true" : "false"); }
            else if (fl === "notify_when_offline") { b.textContent = u.notify_when_offline ? "oui" : "non"; b.setAttribute("aria-pressed", u.notify_when_offline ? "true" : "false"); }
            else if (fl === "min_profit_to_ping") b.setAttribute("aria-pressed", String(u.min_profit_to_ping === +b.getAttribute("data-v")));
            else if (fl === "ch") b.setAttribute("aria-pressed", String(!!u.channels_to_ping[b.getAttribute("data-v")]));
          });
        });
        each(who.querySelectorAll(".wtab"), function (t, j) { t.classList.toggle("on", j === cur); t.setAttribute("aria-selected", String(j === cur)); });
      }
      function stopAuto() { clearInterval(auto); auto = false; }
      each(who.querySelectorAll(".wtab"), function (t, j) { t.addEventListener("click", function () { stopAuto(); cur = j; render(); }); });
      each(who.querySelectorAll(".hunt"), function (p) {
        var k = p.getAttribute("data-u"), u = users[k];
        each(p.querySelectorAll("[data-f]"), function (b) {
          b.addEventListener("click", function () {
            stopAuto(); note[k] = "";
            var fl = b.getAttribute("data-f");
            if (fl === "presence") u.presence = u.presence === "ON" ? "OFF" : "ON";
            else if (fl === "notify_when_offline") u.notify_when_offline = !u.notify_when_offline;
            else if (fl === "min_profit_to_ping") u.min_profit_to_ping = +b.getAttribute("data-v");
            else if (fl === "ch") { var c = b.getAttribute("data-v"); u.channels_to_ping[c] = !u.channels_to_ping[c]; }
            else if (fl === "disconnect") { if (u.presence === "ON") { u.presence = "OFF"; note[k] = "Discord fermé : présence passée à OFF."; } else note[k] = "Déjà OFF."; }
            render();
          });
        });
      });
      render();
      if (!reduce && "IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          if (es[0].isIntersecting) { if (auto === null) auto = setInterval(function () { cur = (cur + 1) % R.length; render(); }, 3200); }
          else if (auto) { clearInterval(auto); auto = null; }
        }, { threshold: .3 }).observe(who);
      }
    })();

    // ---------- Forge : la règle se construit à l'arrivée ----------
    (function () {
      var fg = document.getElementById("forge");
      if (reduce || !("IntersectionObserver" in window)) { fg.classList.add("built"); return; }
      var armed = true;
      new IntersectionObserver(function (es) {
        var e = es[0];
        if (!e.isIntersecting) { if (!armed) { fg.classList.remove("built"); armed = true; } return; }
        if (armed && e.intersectionRatio >= .35) { armed = false; void fg.offsetWidth; fg.classList.add("built"); }
      }, { threshold: [0, .35] }).observe(fg);
    })();
  })();
</script>
