---
// Page projet Deal Hunter : le bot Discord qui triait les nouvelles annonces dans six salons.
// Faits tirés du dépôt Arkaniix/deal-hunter et des réglages relevés dans le salon ; annonces et prix de démo inventés.
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import DealHunterDemo from "../../components/DealHunterDemo.astro";
import { PIC, SALON_ART, OUT_ART, triple } from "../../lib/dh-art";
import { SAMPLES, PIPELINE, ME, OTHER, CHANNEL_INFO } from "../../data/deal-hunter/samples";
import market from "../../data/deal-hunter/demo-market.json";
import catalog from "../../data/videntis/gpu-catalog.json";
import "../../scripts/deal-hunter-engine.js";
import "../../styles/projet.css";
import "../../styles/deal-hunter.css";

const E = (globalThis as any).DealHunterEngine;
const data = { index: E.buildModelIndex(catalog as { name: string }[]), market: market.gpu, cpu: market.cpu };
const PL: Record<string, string> = { leboncoin: "Leboncoin", vinted: "Vinted" };
const CHN: Record<string, string> = { lbc: "Leboncoin", vinted: "Vinted", ebay: "eBay" };
const eur = (x: number) => Math.round(x).toLocaleString("fr-FR") + "\u00a0€";
const seur = (x: number) => (x > 0 ? "+" : x < 0 ? "−" : "") + Math.abs(Math.round(x)).toLocaleString("fr-FR") + "\u00a0€";

const description =
  "Deal Hunter, le bot Discord qui triait les nouvelles annonces de matériel PC : six salons, profit net de revente, analyse par Claude Haiku au clic. Démo interactive, architecture, choix et difficultés résolues.";

// ---------- En-tête : sept annonces passent par le vrai moteur, chacune finit dans sa case ----------
const bySid = Object.fromEntries(SAMPLES.map((s) => [s.id, s]));
const heroSeq: [string, number?][] = [["s1"], ["s2"], ["s3"], ["s4"], ["s5"], ["s7"], ["s1", 189]];
const hst = { seen: {}, sent: {} };
const HERO = heroSeq.map(([sid, price]) => {
  const s = bySid[sid];
  const ad = { ad_id: s.id, title: s.title, price_eur: price ?? s.price, platform: s.platform, description: s.description || "", condition: s.condition || null };
  const r = E.processAd(ad, data, hst, PIPELINE, [ME]);
  const ex = r.steps[0] && !r.steps[0].ok ? r.steps[0] : null;
  const model = r.steps[1] && r.steps[1].ok ? r.steps[1] : null;
  const risk = r.steps.find((x: any) => x.k === "risk");
  const tokWords = model ? E.normalize(model.token).split(" ") : [];
  const hsWords = risk && risk.hs && risk.hs.is_hs ? E.normalize(risk.hs.signals.join(" ")).replace(/[^a-z0-9 ]/g, " ") : "";
  const words = s.title.split(" ").map((w) => {
    const n = E.normalize(w).replace(/[^a-z0-9]/g, "");
    let k = "n";
    if (ex && ex.hit && E.normalize(ex.hit).split(/[\s-]+/).some((h: string) => h && n.indexOf(h.replace(/[^a-z0-9]/g, "")) === 0)) k = "x";
    else if (n && tokWords.some((t: string) => t === n || (n.length > 2 && n.indexOf(t) === 0 && t.length > 2) || n === t.replace(/\s/g, ""))) k = "m";
    else if (n && hsWords && hsWords.indexOf(n) !== -1 && n.length > 2) k = "r";
    return [w, k];
  });
  const ev = r.ev;
  const lines = ex ? [["Écartée", ex.why]] : [
    ["Modèle", model.name || model.token],
    ["Revente", eur(ev.realistic_sell_price)],
    ["Profit", seur(ev.best_profit) + " via " + CHN[ev.best_channel]],
    ...(ev.price_drop ? [["Prix", eur(ev.price_drop.old_price) + " → " + eur(ev.price_drop.new_price)]] : []),
    ...(ev.is_hs ? [["Signal", "pour pièces"]] : ev.is_scam_suspect ? [["Signal", "prix à " + (ev.ratio).toFixed(2).replace(".", ",") + " de la revente"]] : []),
  ];
  return {
    t: words, p: ad.price_eur, meta: PL[s.platform] + (s.city ? " · " + s.city : "") + " · " + s.ago, pic: s.pic, bg: PIC[s.pic].bg,
    lines, slot: r.stop ? "out" : r.channel, ping: !!(r.who && r.who.some((w: any) => w.pinged)),
  };
});
const H0 = HERO[0];
const SLOTS = ["deals_fire", "deals_price_drop", "deals_hs", "deals_suspect", "deals_not_rentable", "deals_other"];
const heroPics = [...new Set(HERO.map((h) => h.pic))];

// ---------- Six salons ----------
const SALONS = [
  { k: "deals_fire", art: "fire", rule: "Profit net d’au moins 50 €", sub: "Seuil réglable dans #bot-settings, 25 € par défaut." },
  { k: "deals_price_drop", art: "drop", rule: "Prix baissé d’au moins 5 %", sub: "Sur une annonce déjà vue dans les 7 derniers jours." },
  { k: "deals_hs", art: "hs", rule: "Pour pièces, en panne, écran noir…", sub: "Gardée, avec une analyse de réparateur." },
  { k: "deals_suspect", art: "suspect", rule: "Prix à la moitié de la revente ou moins", sub: "Ou deux signaux à la fois : langue étrangère et plus de 600 € de revente sur Vinted." },
  { k: "deals_not_rentable", art: "flat", rule: "Profit négatif", sub: "Posté quand même, dans son salon." },
  { k: "deals_other", art: "other", rule: "Tout le reste", sub: "Profit entre 0 et 50 €, ou pas de référence." },
];
const OUTS = [
  { k: "lot", t: "Lots et packs" }, { k: "box", t: "Boîtes vides" }, { k: "laptop", t: "PC portables" }, { k: "swap", t: "Échanges" },
  { k: "mug", t: "Goodies" }, { k: "fan", t: "Ventilateurs, câbles" }, { k: "glasses", t: "Lunettes «\u00a0RX\u00a0»" }, { k: "old", t: "Vieilles générations" },
];

// ---------- Le vrai bot : message et analyse de l'annonce n° 1 ----------
const R1 = E.processAd({ ad_id: "s1", title: SAMPLES[0].title, price_eur: SAMPLES[0].price, platform: "leboncoin", description: SAMPLES[0].description }, data, { seen: {}, sent: {} }, PIPELINE, [ME]);
const ev1 = R1.ev;

// ---------- Qui est prévenu ? ----------
const WHO_DEALS = ["s1", "s2", "s4", "s5"];

// ---------- Le plan ----------
const PLAN: Record<string, [string, string]> = {
  src: ["Nouvelles annonces", "Le matériel PC fraîchement publié sur Leboncoin et Vinted. Le bot se met en pause dès que plus personne n’est en chasse."],
  excl: ["Écartées d’office", "Prix au-dessus du maximum (500 €), lots, boîtes vides, portables, échanges, goodies, accessoires, lunettes. Sur Vinted, le même tri en allemand, italien, espagnol, néerlandais et portugais."],
  model: ["Quel modèle ?", "Cartes graphiques par motif (RTX 20 et plus, RX 5000 et plus, Arc), processeurs (Intel 8e génération et plus, Ryzen 3000 et plus), mémoire et SSD. Alimentations et cartes mères par les alias du catalogue Videntis."],
  seen: ["Déjà vue ?", "Une annonce vue ne repasse que si son prix baisse d’au moins 5 %. Une empreinte titre et prix rattrape le même objet sous un autre numéro."],
  profit: ["Profit", "Ventes confirmées de Videntis, corrigées de 15 à 25 % selon le prix et plafonnées à 90 % du neuf. Puis frais et port des trois canaux de revente : le meilleur l’emporte."],
  risk: ["Pour pièces ? Arnaque ?", "Mots de panne en français et en anglais, négations comprises (« sans défaut »), état « pour pièces » de Leboncoin. Prix trop bas, langue étrangère, gros montant sur Vinted."],
  route: ["Six salons", "Chaque annonce reconnue est postée dans un salon. Les mentions dépendent du panneau de chaque chasseur."],
  ref: ["Référence Videntis", "La base PostgreSQL de Videntis, en lecture seule, rechargée toutes les 30 minutes. Un modèle sans 3 ventes confirmées sur 90 jours n’a pas de référence."],
  mem: ["Mémoire locale", "SQLite : annonces vues (7 jours), messages postés (90 jours), signalements. Les empreintes tiennent 2 heures, même après un redémarrage."],
  forge: ["Règles Forge", "Les règles de chaque chasseur, écrites dans la console Videntis et lues en lecture seule. En mode envoi, si une règle correspond, le message part dans son salon (#deals-forge) à la place du tri."],
  haiku: ["Claude Haiku", "Au clic sur « Analyser », avec la photo de l’annonce. Consigne de revendeur, ou de réparateur dans #deals-hs. 20 appels par heure, 50 par jour, 5 par personne et par heure."],
  report: ["Signalements", "« Signaler » fige le contexte du message (verdict, profit, signaux). Les causes qui reviennent deviennent des exclusions."],
  panels: ["Panneaux", "Un panneau global dans #bot-settings, un par chasseur dans son salon. Chaque clic est enregistré sur disque et s’applique tout de suite."],
};
---
<Base title="Deal Hunter, le bot qui trie les bonnes affaires" description={description} themeColor="#FF4F9A">
<SiteHeader />

<main class="v dh">

  <!-- ========== En-tête ========== -->
  <section class="band b-pink v-hero" aria-labelledby="dh-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kicker">Projet 2 · Bot Discord, module de Videntis · 2026</p>
        <h1 id="dh-title" class="v-h1">Deal Hunter</h1>
        <p class="lead">Les bonnes affaires partent en quelques minutes. Deal Hunter lisait les nouvelles annonces de matériel PC sur Leboncoin et Vinted, calculait ce qu’elle rapporterait à la revente et la rangeait dans le bon salon Discord. Un clic sur «&nbsp;Analyser&nbsp;», et Claude Haiku donnait son avis.</p>
        <p class="status"><span class="dot off" aria-hidden="true"></span>À l’arrêt aujourd’hui. Le code et ses 901 tests restent.</p>
        <div class="cta">
          <a class="vbtn primary" href="#demo">Essayer la démo</a>
          <a class="vbtn" href="#plan">Voir le plan</a>
        </div>
        <ul class="stack" aria-label="Technologies">
          <li>Python</li><li>asyncio</li><li>discord.py</li><li>SQLite</li><li>PostgreSQL</li><li>Claude Haiku</li><li>pytest</li>
        </ul>
      </div>
      <div class="srt pre" id="srt" aria-hidden="true">
        <div class="srt-stage">
          <article class="dh-card">
            <div class="dh-card-pic" data-bg={H0.bg}>
              {heroPics.map((k) => <svg class={"draw pv" + (k === H0.pic ? " on" : "")} data-k={k} viewBox="0 0 176 100" set:html={PIC[k].svg} />)}
              <span>annonce inventée</span>
            </div>
            <p class="dh-card-t" id="srt-t">{H0.t.map(([w, k], i) => <Fragment>{i > 0 && " "}<span class={"tkn " + k}>{w}</span></Fragment>)}</p>
            <p class="dh-card-p"><b id="srt-p">{H0.p} €</b><span id="srt-m">{H0.meta}</span></p>
          </article>
          <dl class="srt-read" id="srt-read">
            {H0.lines.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}
          </dl>
          <span class="srt-chip" id="srt-chip"></span>
        </div>
        <ul class="srt-slots" id="srt-slots">
          {SLOTS.map((k) => (
            <li class={"slot c-" + CHANNEL_INFO[k].c} data-s={k}><b><i>#&nbsp;</i>{CHANNEL_INFO[k].name}</b><em>0</em><span class="ping">@moi</span></li>
          ))}
          <li class="slot bin" data-s="out"><b>Écartées, sans message</b><em>0</em></li>
        </ul>
        <button type="button" class="replay" id="srt-next">Annonce suivante <span aria-hidden="true">↻</span></button>
      </div>
    </div>
    <div class="wrap">
      <ul class="facts">
        <li><b>7</b><span>familles reconnues</span><em>cartes graphiques, processeurs, mémoire, SSD, alimentations, cartes mères, PC complets</em></li>
        <li><b>6</b><span>salons de tri</span><em>de « bonnes affaires » à « pas rentables »</em></li>
        <li><b>3</b><span>reventes comparées</span><em>Leboncoin, Vinted et eBay, frais et port déduits</em></li>
        <li><b>901</b><span>tests automatisés</span><em>filtres, calculs, doublons, panneaux, règles</em></li>
      </ul>
    </div>
  </section>

  <!-- ========== Six salons ========== -->
  <section class="band b-paper" aria-labelledby="h-salons">
    <div class="wrap">
      <h2 class="v-h2" id="h-salons">Six salons, une règle chacun.</h2>
      <p class="intro">Chaque annonce reconnue est postée quelque part. Seules celles qui passent vos seuils vous mentionnent.</p>
      <ul class="salons">
        {SALONS.map((s) => (
          <li class={"salon c-" + CHANNEL_INFO[s.k].c} tabindex="0">
            <div class="salon-art"><svg class="draw" viewBox="0 0 120 80" aria-hidden="true" set:html={SALON_ART[s.art]} /></div>
            <p class="salon-ch"># {CHANNEL_INFO[s.k].name}</p>
            <h3>{CHANNEL_INFO[s.k].label}</h3>
            <p class="salon-r">{s.rule}</p>
            <p class="salon-s">{s.sub}</p>
          </li>
        ))}
      </ul>
      <div class="prio">
        <p class="prio-k">Quand plusieurs règles collent, l’ordre tranche</p>
        <ol>
          <li class="c-hs">Pour pièces</li><li class="c-suspect">Suspecte</li><li class="c-drop">Baisse de prix</li><li class="c-fire">Profit</li>
        </ol>
      </div>
      <h3 class="sub-h2">Écarté avant tout calcul</h3>
      <ul class="outs">
        {OUTS.map((o) => (
          <li class="out" tabindex="0"><svg class="draw" viewBox="0 0 64 64" aria-hidden="true" set:html={OUT_ART[o.k]} /><span>{o.t}</span></li>
        ))}
      </ul>
      <p class="outs-n">Et tout ce qui dépasse 500 €, le prix maximum réglé dans #bot-settings. Vieilles générations : GTX, Radeon avant les RX 5000, Intel avant la 8e génération, Ryzen avant les 3000.</p>
    </div>
  </section>

  <!-- ========== Démo ========== -->
  <section class="band b-blue" id="demo" aria-labelledby="h-demo">
    <div class="wrap">
      <h2 class="v-h2" id="h-demo">Une annonce, un salon.</h2>
      <p class="intro">Choisissez une annonce ou écrivez la vôtre. Elle suit le chemin du bot, étape par étape, jusqu’à son salon. Puis cliquez sur «&nbsp;Analyser&nbsp;».</p>
      <DealHunterDemo />
    </div>
  </section>

  <!-- ========== Le vrai bot, redessiné ========== -->
  <section class="band b-paper" aria-labelledby="h-bot">
    <div class="wrap">
      <h2 class="v-h2" id="h-bot">Le vrai bot, redessiné.</h2>
      <p class="intro">D’après mes captures du salon&nbsp;: mêmes champs, mêmes boutons, mêmes réglages. L’annonce est inventée, les couleurs sont celles du site.</p>
      <div class="anat" id="anat">
        <div class="win">
          <div class="win-side" aria-hidden="true">
            <p class="win-srv">Serveur de chasse</p>
            {["deals-fire", "deals-price-drop", "deals-hs", "deals-suspect", "deals-not-rentable", "deals-other", "deals-forge", "bot-settings", "bot-logs", "settings-etienne"].map((c) => (
              <p class={"win-ch" + (c === "deals-fire" ? " on" : "")}># {c}</p>
            ))}
          </div>
          <div class="win-main">
            <p class="win-top"># deals-fire</p>
            <div class="msg">
              <span class="msg-av" aria-hidden="true">DH</span>
              <div class="msg-b">
                <p class="msg-h"><b>Deal Hunter</b><span class="botp">bot</span><em>aujourd’hui à 14:31</em></p>
                <p class="msg-at" data-n="2">@moi<i class="n">2</i></p>
                <div class="emb k-vgood">
                  <div class="emb-top">
                    <div class="emb-txt">
                      <p class="emb-t" data-n="1"><span class="newp">nouveau</span>{ev1.verdict.v} · {ev1.matched_model.name}<i class="n">1</i></p>
                      <p class="emb-d">{SAMPLES[0].title}<span class="emb-desc">{SAMPLES[0].description}</span></p>
                    </div>
                    <span class="emb-th" data-bg={PIC["gpu-fe"].bg}><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={PIC["gpu-fe"].svg} /></span>
                  </div>
                  <dl class="emb-f">
                    <div><dt>Prix</dt><dd><b>{eur(SAMPLES[0].price)}</b></dd></div>
                    <div><dt>Revente estimée</dt><dd>~{eur(ev1.realistic_sell_price)}</dd></div>
                    <div data-n="3"><dt>Profit net</dt><dd><b>{seur(ev1.best_profit)}</b> via {ev1.best_channel.toUpperCase()}<i class="n">3</i></dd></div>
                    <div><dt>Localisation</dt><dd>{SAMPLES[0].city}</dd></div>
                    <div><dt>Plateforme</dt><dd>Leboncoin</dd></div>
                    <div data-n="5"><dt>Observations</dt><dd>{ev1.observation_count} ✓ fiable<i class="n">5</i></dd></div>
                    <div class="w" data-n="4"><dt>Détail profits</dt><dd>{["lbc", "vinted", "ebay"].map((c) => c.toUpperCase() + " : " + seur(ev1.profits_by_channel[c].profit)).join(" | ")}<i class="n">4</i></dd></div>
                    <div><dt>Publiée</dt><dd>il y a 3 min</dd></div>
                  </dl>
                  <p class="emb-foot">Deal Hunter · LBC</p>
                </div>
                <div class="msg-btns">
                  <span class="mb mb-buy">Acheter ↗</span>
                  <span class="mb mb-ai" data-n="6">Analyser<i class="n">6</i></span>
                  <span class="mb mb-rep" data-n="7">Signaler<i class="n">7</i></span>
                </div>
              </div>
            </div>
            <div class="msg msg-ai">
              <span class="msg-av" aria-hidden="true">DH</span>
              <div class="msg-b">
                <p class="msg-re">↳ réponse à Deal Hunter</p>
                <div class="emb k-ai" data-n="6">
                  <p class="emb-t">Analyse du deal</p>
                  {SAMPLES[0].ai!.map((s) => (<Fragment><p class="ai-h">{s.h}</p>{s.l.map((l) => <p class="ai-l">{l}</p>)}</Fragment>))}
                  <p class="emb-foot">Analyse par Claude Haiku (texte + image) · usage personnel</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <ol class="legend" id="legend">
          <li data-n="1"><i>1</i><div><b>Verdict et modèle</b><span>Paliers de profit&nbsp;: 100, 80, 50 et 20&nbsp;€. Pastille «&nbsp;nouveau&nbsp;» si l’annonce a moins de 10&nbsp;minutes.</span></div></li>
          <li data-n="2"><i>2</i><div><b>La mention</b><span>Seulement si l’annonce passe les seuils de votre panneau. Sinon, le message arrive en silence.</span></div></li>
          <li data-n="3"><i>3</i><div><b>Profit net</b><span>Sur le meilleur canal de revente, frais et port déduits.</span></div></li>
          <li data-n="4"><i>4</i><div><b>Les trois reventes</b><span>Leboncoin en main propre, Vinted et eBay avec leurs frais et 8&nbsp;€ de port.</span></div></li>
          <li data-n="5"><i>5</i><div><b>Observations</b><span>Ventes connues pour ce modèle. «&nbsp;Fiable&nbsp;» à partir de 30, «&nbsp;faible&nbsp;» sous 15.</span></div></li>
          <li data-n="6"><i>6</i><div><b>Analyser</b><span>Claude Haiku, au clic, avec la photo. La réponse arrive dans le salon, sous le message.</span></div></li>
          <li data-n="7"><i>7</i><div><b>Signaler</b><span>Une fausse alerte rejoint la liste de #bot-settings, avec le contexte du message figé.</span></div></li>
          <li data-n="8"><i>8</i><div><b>Le panneau global</b><span>Interrupteur par site, prix maximum absolu, seuil des bonnes affaires, signalements en cours.</span></div></li>
        </ol>
        <div class="win win-set" data-n="8">
          <div class="win-main">
            <p class="win-top"># bot-settings<i class="n">8</i></p>
            <div class="emb k-set">
              <p class="emb-t">Pipeline Deal Hunter · interrupteurs et routage</p>
              <p class="emb-d">Le bot tourne tant qu’au moins un chasseur est ON.</p>
              <dl class="emb-f set">
                <div><dt>Plateformes</dt><dd><span class="tg on">Leboncoin</span><span class="tg on">Vinted</span></dd></div>
                <div><dt>Prix max absolu</dt><dd><b>500 €</b> · les panneaux perso sont plafonnés par cette valeur</dd></div>
                <div><dt>Seuil des bonnes affaires</dt><dd><b>50 €</b> de profit → #deals-fire</dd></div>
                <div><dt>Signalements en cours</dt><dd>1, avec le bouton «&nbsp;Voir détails&nbsp;»</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Qui est prévenu ? ========== -->
  <section class="band b-yellow" aria-labelledby="h-who">
    <div class="wrap">
      <h2 class="v-h2" id="h-who">Deux chasseurs, un bot.</h2>
      <p class="intro">Chacun règle son panneau dans son salon privé. Changez les réglages&nbsp;: les mentions se recalculent.</p>
      <div class="who" id="who">
        <div class="who-deals">
          <p class="dh-k">L’annonce postée</p>
          <div class="who-tabs" role="tablist">
            {WHO_DEALS.map((sid, i) => (
              <button type="button" role="tab" class={"wtab" + (i === 0 ? " on" : "")} data-sid={sid}><span>{bySid[sid].title}</span></button>
            ))}
          </div>
          <div class="who-deal" id="who-deal"></div>
          <p class="who-bot" id="who-bot"></p>
        </div>
        {[["me", "moi", ME], ["other", "second chasseur", OTHER]].map(([key, name, s]: any) => (
          <div class="hunt" data-u={key}>
            <p class="hunt-h">Panneau de chasse · {name}</p>
            <div class="hunt-res" data-res={key}></div>
            <div class="hunt-row"><span>Présence</span><button type="button" class="sw" data-f="presence" aria-pressed={s.presence === "ON" ? "true" : "false"}>{s.presence}</button></div>
            <div class="hunt-row"><span>Mentionné même OFF</span><button type="button" class="sw" data-f="notify_when_offline" aria-pressed={s.notify_when_offline ? "true" : "false"}>{s.notify_when_offline ? "oui" : "non"}</button></div>
            <div class="hunt-row"><span>Profit minimum</span><span class="seg-g">{[25, 50, 80].map((v) => <button type="button" class="seg2" data-f="min_profit_to_ping" data-v={v} aria-pressed={s.min_profit_to_ping === v ? "true" : "false"}>{v} €</button>)}</span></div>
