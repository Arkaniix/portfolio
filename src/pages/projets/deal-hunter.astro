---
// Page projet Deal Hunter : le trajet d'une annonce, de sa publication au message du bot.
// Faits tirés du dépôt Arkaniix/deal-hunter et des réglages relevés dans le salon ; annonces et prix de démo inventés.
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import DealHunterDemo from "../../components/DealHunterDemo.astro";
import { PIC, SALON_ART, OUT_ART, triple } from "../../lib/dh-art";
import { SAMPLES, PIPELINE, ME, OTHER, CHANNEL_INFO } from "../../data/deal-hunter/samples";
import market from "../../data/deal-hunter/demo-market.json";
import catalog from "../../data/videntis/gpu-catalog.json";
import "../../scripts/deal-hunter-engine.js";
import "../../styles/projet.css";
import "../../styles/deal-hunter.css";

const E = (globalThis as any).DealHunterEngine;
const data = { index: E.buildModelIndex(catalog as { name: string }[]), market: market.gpu, cpu: market.cpu };
const PL: Record<string, string> = { leboncoin: "Leboncoin", vinted: "Vinted" };
const CHN: Record<string, string> = { lbc: "Leboncoin", vinted: "Vinted", ebay: "eBay" };
const NB = " ";
const eur = (x: number) => Math.round(x).toLocaleString("fr-FR") + NB + "€";
const seur = (x: number) => (x > 0 ? "+" : x < 0 ? "−" : "") + Math.abs(Math.round(x)).toLocaleString("fr-FR") + NB + "€";
const esc = (s: string) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const run = (title: string, price: number, extra: Record<string, any> = {}) =>
  E.processAd({ ad_id: "p" + title.length + "-" + price, title, price_eur: price, platform: "leboncoin", description: "", ...extra }, data, { seen: {}, sent: {} }, PIPELINE, [ME]);

const description =
  "Deal Hunter, le bot Discord qui triait les nouvelles annonces de matériel PC : le trajet d’une annonce, des filtres au profit net, du salon à l’analyse de Claude Haiku. Démo interactive.";

const bySid = Object.fromEntries(SAMPLES.map((s) => [s.id, s]));
const S1 = SAMPLES[0];
const R1 = E.processAd({ ad_id: "s1", title: S1.title, price_eur: S1.price, platform: "leboncoin", description: S1.description }, data, { seen: {}, sent: {} }, PIPELINE, [ME]);
const ev1 = R1.ev;

// Mots du titre : m = modèle lu, x = cause de l'exclusion, r = signal de panne, n = le reste
function tokens(title: string, r: any) {
  const ex = r.steps[0] && !r.steps[0].ok ? r.steps[0] : null;
  const model = r.steps[1] && r.steps[1].ok ? r.steps[1] : null;
  const risk = r.steps.find((x: any) => x.k === "risk");
  const tokWords = model ? E.normalize(model.token).split(" ") : [];
  const hsWords = risk && risk.hs && risk.hs.is_hs ? E.normalize(risk.hs.signals.join(" ")).replace(/[^a-z0-9 ]/g, " ") : "";
  return title.split(" ").map((w) => {
    const n = E.normalize(w).replace(/[^a-z0-9]/g, "");
    let k = "n";
    if (ex && ex.hit && E.normalize(ex.hit).split(/[\s-]+/).some((h: string) => h && n.indexOf(h.replace(/[^a-z0-9]/g, "")) === 0)) k = "x";
    else if (n && tokWords.some((t: string) => t === n || (n.length > 2 && n.indexOf(t) === 0 && t.length > 2) || n === t.replace(/\s/g, ""))) k = "m";
    else if (n && hsWords && hsWords.indexOf(n) !== -1 && n.length > 2) k = "r";
    return [w, k];
  });
}

// ---------- L'annonce suivie : son état à chacune des huit étapes ----------
const AI_LINE: Record<string, string> = { s1: "ACHETER IMMÉDIATEMENT", s2: "RÉPARABLE PROBABLEMENT", s3: "ARNAQUE PROBABLE, NE PAS ACHETER" };
const FOLLOW = [
  { sid: "s1", short: "RTX 3080 FE" }, { sid: "s2", short: "RTX 3070 en panne" },
  { sid: "s3", short: "RTX 4090 neuve" }, { sid: "s7", short: "Lunettes RX" },
].map(({ sid, short }) => {
  const s = bySid[sid];
  const r = E.processAd({ ad_id: s.id, title: s.title, price_eur: s.price, platform: s.platform, description: s.description || "", condition: s.condition || null }, data, { seen: {}, sent: {} }, PIPELINE, [ME]);
  const step = (k: string) => r.steps.find((x: any) => x.k === k);
  const stop = '<span class="fs-stop">Arrêtée à l’étape 2&nbsp;: elle ne va pas plus loin.</span>';
  const ex = step("exclude"), mo = step("model"), ri = step("risk"), ro = step("route"), ev = r.ev;
  const ch = ro ? CHANNEL_INFO[ro.channel] : null;
  const states = [
    `<b>${PL[s.platform]}${s.city ? " · " + esc(s.city) : ""}</b>, ${eur(s.price)}&nbsp;: sous le plafond de 500&nbsp;€, elle est lue.`,
    ex.ok ? `<span class="fs-ok">Rien à écarter.</span> Ni lot, ni portable, ni boîte vide.` : `<span class="fs-no">Écartée&nbsp;:</span> ${esc(ex.why)}. Aucun message.`,
    mo ? `Lu dans le titre&nbsp;: <code>${esc(mo.token)}</code> → <b>${esc(mo.name)}</b>` : stop,
    mo ? `<span class="fs-ok">Première fois.</span> Gardée 7&nbsp;jours avec son prix.` : stop,
    ev ? `Revente ~${eur(ev.realistic_sell_price)}, <b>${seur(ev.best_profit)}</b> via ${CHN[ev.best_channel]} <span class="vp v-${ev.verdict.k}">${ev.verdict.v}</span>` : stop,
    ri ? (ri.hs && ri.hs.is_hs ? `<span class="fs-warn">Pour pièces&nbsp;:</span> ${esc(ri.hs.signals.slice(0, 2).join(", "))}.`
      : ri.suspect ? `<span class="fs-no">Suspecte&nbsp;:</span> ${ri.flags.length} drapeaux, dont un prix à ${String(Math.round(ri.ratio * 100) / 100).replace(".", ",")} de la revente.`
      : `<span class="fs-ok">Rien à signaler.</span> Prix à ${String(Math.round(ri.ratio * 100) / 100).replace(".", ",")} de la revente.`) : stop,
    ch ? `<span class="salpill c-${ch.c}">#&nbsp;${ch.name}</span> <span class="at">@moi</span> mentionné.` : stop,
    AI_LINE[sid] ? `Clic sur «&nbsp;Analyser&nbsp;», Haiku répond&nbsp;: <b>${AI_LINE[sid]}</b>` : stop,
  ];
  return { sid, short, title: s.title, price: s.price, meta: PL[s.platform] + (s.city ? " · " + s.city : "") + " · " + s.ago, pic: s.pic, t: tokens(s.title, r), states, last: r.stop ? 2 : 8 };
});

// ---------- Étape 1 : ce qui arrive ----------
const FLOW = [
  { t: "RTX 3080 Founders Edition", p: 210 }, { t: "PC complet RTX 4070", p: 900 }, { t: "Ryzen 7 5800X", p: 95 },
  { t: "RTX 4080 Super neuve", p: 780 }, { t: "Kit DDR4 2x16 Go", p: 110 }, { t: "RX 6700 XT", p: 230 },
];
// ---------- Étape 3 : quatre titres, ce que le bot en lit ----------
const READS = ["RTX 3080 Founders Edition comme neuve", "Ryzen 7 5800X, très bon état", "Kit 2x16 Go DDR4 3200 Corsair Vengeance", "GTX 1080 Ti Strix"].map((t) => {
  const r = run(t, 95), m = r.steps[1];
  // Génération trop ancienne : le modèle est bien lu, puis refusé ; on le marque comme cause du refus
  const tk = m.ok ? tokens(t, r) : t.split(" ").map((w) => [w, m.token && E.normalize(m.token).split(" ").indexOf(E.normalize(w)) !== -1 ? "x" : "n"]);
  return { t: tk, ok: m.ok, out: m.ok ? m.name : "Trop ancienne", fam: m.ok ? m.family : "RTX 20, RX 5000, Arc et plus récentes seulement" };
});
const FAMS = ["Cartes graphiques", "Processeurs", "Mémoire", "SSD", "Alimentations", "Cartes mères", "PC complets"];
// ---------- Étape 4 : la mémoire ----------
const FP = E.makeFingerprint("leboncoin", S1.title, 199);
// ---------- Étape 5 : le calcul ----------
const CH3 = ["lbc", "vinted", "ebay"].map((c) => ({ c, name: CHN[c], sub: c === "lbc" ? "main propre, sans frais" : (c === "vinted" ? "−5" : "−13") + NB + "%, port 8" + NB + "€", p: ev1.profits_by_channel[c].profit }));
const TIERS = [["PAS RENTABLE", "bad", 0], ["PRIX CORRECT", "ok", 20], ["BON PRIX", "good", 50], ["TRÈS BON DEAL", "vgood", 80], ["ÉNORME DEAL", "huge", 100]] as const;
// ---------- Étape 7 : les salons ----------
const SALONS = [
  { k: "deals_fire", art: "fire", rule: "Profit net d’au moins 50" + NB + "€" },
  { k: "deals_price_drop", art: "drop", rule: "Prix baissé d’au moins 5" + NB + "%" },
  { k: "deals_hs", art: "hs", rule: "Pour pièces, en panne" },
  { k: "deals_suspect", art: "suspect", rule: "Prix trop beau, signaux d’arnaque" },
  { k: "deals_not_rentable", art: "flat", rule: "Profit négatif" },
  { k: "deals_other", art: "other", rule: "Tout le reste" },
];
const SLOTS = SALONS.map((x) => x.k);
const WHO_DEALS = ["s1", "s2", "s4", "s5"];

const STEPS = [
  { id: "publiee", q: "Une annonce est publiée", short: "Publiée" },
  { id: "ecartee", q: "Faut-il l’écarter ?", short: "Écartée ?" },
  { id: "modele", q: "Quel modèle ?", short: "Modèle" },
  { id: "vue", q: "Déjà vue ?", short: "Déjà vue ?" },
  { id: "profit", q: "Combien ça rapporte ?", short: "Profit" },
  { id: "risque", q: "En panne ? Arnaque ?", short: "Panne, arnaque" },
  { id: "salon", q: "Quel salon, qui prévenir ?", short: "Salon" },
  { id: "analyser", q: "Et si on clique sur « Analyser » ?", short: "Analyser" },
];
---
<Base title="Deal Hunter, le bot qui trie les bonnes affaires" description={description} themeColor="#FF4F9A">
<SiteHeader />

<main class="v dh">

  <!-- ========== En-tête : le message, en très grand ========== -->
  <section class="band b-pink dh-open" aria-labelledby="dh-title">
    <div class="wrap">
      <noscript><style>.op.wait .op-av, .op.wait .op-h, .op.wait .op-at, .op.wait .op-emb, .op.wait .op-b .msg-btns{ opacity:1 !important; }</style></noscript>
      <p class="op-k">Projet 2 · Module de Videntis · Bot Discord, à l’arrêt aujourd’hui</p>
      <div class="op wait" id="op">
        <div class="op-msg">
          <span class="op-av" aria-hidden="true">DH</span>
          <div class="op-b">
            <div class="op-h"><h1 id="dh-title" class="op-name">Deal Hunter</h1><span class="botp">bot</span><span class="op-time">aujourd’hui à 14:31</span></div>
            <p class="op-at"><span class="at">@moi</span></p>
            <div class="emb op-emb k-vgood">
              <div class="emb-top">
                <div>
                  <p class="emb-t"><span class="newp">nouveau</span>{ev1.verdict.v} · {ev1.matched_model.name}</p>
                  <p class="emb-d">{S1.title}<span class="emb-desc">{S1.description}</span></p>
                </div>
                <span class="emb-th" data-bg={PIC["gpu-fe"].bg}><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={PIC["gpu-fe"].svg} /></span>
              </div>
              <dl class="emb-f">
                <div><dt>Prix</dt><dd><b>{eur(S1.price)}</b></dd></div>
                <div><dt>Revente estimée</dt><dd>~{eur(ev1.realistic_sell_price)}</dd></div>
                <div><dt>Profit net</dt><dd><b>{seur(ev1.best_profit)}</b> via LBC</dd></div>
                <div><dt>Localisation</dt><dd>{S1.city}</dd></div>
                <div><dt>Observations</dt><dd>{ev1.observation_count} ✓ fiable</dd></div>
                <div><dt>Publiée</dt><dd>il y a 3 min</dd></div>
              </dl>
            </div>
            <div class="msg-btns">
              <a class="mb mb-buy" href="#a-vous">Acheter ↗</a>
              <a class="mb mb-ai" href="#analyser">Analyser</a>
              <a class="mb mb-rep" href="#salon">Signaler</a>
            </div>
          </div>
        </div>
        <div class="op-side">
          <p class="op-lead">Ce message, Deal Hunter le postait dans un salon Discord quelques instants après une annonce de matériel PC sur Leboncoin ou Vinted. <b>Voici tout ce qui se passe entre les deux.</b></p>
          <div class="op-go">
            <a class="vbtn primary" href="#trajet">Suivre une annonce ↓</a>
            <a class="vbtn" href="#a-vous">Essayer avec la vôtre</a>
          </div>
          <p class="op-note">Annonce et prix inventés, message redessiné d’après mes captures du salon. Le code et ses 901 tests restent&nbsp;; le bot, lui, ne tourne plus.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Le trajet ========== -->
  <section class="band b-paper trip-band" id="trajet" aria-label="Le trajet d’une annonce">
    <div class="wrap">
      <div class="pick" role="tablist" aria-label="Annonce à suivre">
        <span class="pick-k">Suivre&nbsp;:</span>
        {FOLLOW.map((f, i) => (
          <button type="button" role="tab" class={"pk" + (i === 0 ? " on" : "")} data-f={f.sid} aria-selected={i === 0 ? "true" : "false"}>
            <span class="pk-pic" data-bg={PIC[f.pic].bg}><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={PIC[f.pic].svg} /></span>{f.short}
          </button>
        ))}
      </div>

      <div class="trip">
        <aside class="fol" id="fol" data-f="s1" data-n="1" aria-live="polite">
          <article class="fol-card">
            <div class="fol-pic">
              {FOLLOW.map((f, i) => <svg class={"draw pv" + (i === 0 ? " on" : "")} data-f={f.sid} data-bg={PIC[f.pic].bg} viewBox="0 0 176 100" aria-hidden="true" set:html={PIC[f.pic].svg} />)}
              <span>annonce inventée</span>
            </div>
            <div class="fol-txt">
              {FOLLOW.map((f, i) => (
                <div class={"fol-ann" + (i === 0 ? " on" : "")} data-f={f.sid}>
                  <p class="fol-t">{f.t.map(([w, k], j) => <Fragment>{j > 0 && " "}<span class={"tkn " + k}>{w}</span></Fragment>)}</p>
                  <p class="fol-p"><b>{eur(f.price)}</b><span>{f.meta}</span></p>
                </div>
              ))}
            </div>
          </article>
          <ol class="fol-dots" aria-hidden="true">{STEPS.map((s, i) => <li data-n={i + 1}><i>{i + 1}</i><span>{s.short}</span></li>)}</ol>
          <div class="fol-st">
            {FOLLOW.map((f) => f.states.map((h, i) => <p class="fs" data-f={f.sid} data-n={i + 1} data-stop={i + 1 > f.last ? "1" : undefined} set:html={h} />))}
          </div>
        </aside>

        <div class="stns">
          <!-- 1 -->
          <section class="stn" id="publiee" data-n="1" aria-labelledby="q1">
            <header class="stn-h"><span class="stn-n">1</span><h2 id="q1">{STEPS[0].q}</h2></header>
            <p class="stn-p">Le bot lisait les nouvelles annonces de matériel PC sur Leboncoin et Vinted. Au-dessus du prix maximum réglé dans #bot-settings, 500&nbsp;€, il ne va pas plus loin. Et quand plus aucun chasseur n’est en chasse, il se met en pause.</p>
            <ul class="flow" aria-label="Annonces qui arrivent (inventées)">
              {FLOW.map((x, i) => <li class={x.p > 500 ? "over" : ""} style={`--i:${i}`}><b>{x.t}</b><span>{eur(x.p)}</span>{x.p > 500 && <em>au-dessus de 500&nbsp;€</em>}</li>)}
            </ul>
          </section>

          <!-- 2 -->
          <section class="stn" id="ecartee" data-n="2" aria-labelledby="q2">
            <header class="stn-h"><span class="stn-n">2</span><h2 id="q2">{STEPS[1].q}</h2></header>
            <p class="stn-p">Avant tout calcul, le titre passe au crible. Sur Vinted, le même tri existe en allemand, italien, espagnol, néerlandais et portugais.</p>
            <ul class="sieve">
              {[["lot", "Lots et packs"], ["box", "Boîtes vides"], ["laptop", "PC portables"], ["swap", "Échanges"], ["mug", "Goodies"], ["fan", "Ventilateurs, câbles"], ["glasses", "Lunettes « RX »"], ["old", "Vieilles générations"]].map(([k, t], i) => (
                <li tabindex="0" style={`--d:${(i * 0.08).toFixed(2)}s`}><svg class="draw" viewBox="0 0 64 64" aria-hidden="true" set:html={OUT_ART[k]} /><span>{t}</span></li>
              ))}
            </ul>
            <article class="rep" tabindex="0">
              <span class="rep-art" data-bg="wood"><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={PIC.laptop.svg} /></span>
              <div class="rep-b">
                <p class="rep-h"><span class="rep-k">Signalé</span>La RTX du portable<span class="rep-s ok">Corrigé</span></p>
                <p><b>Ce qui arrivait&nbsp;:</b> des PC portables passaient pour des cartes graphiques, avec des profits imaginaires. Le titre citait la carte du portable, évaluée comme une carte de bureau.</p>
                <p><b>Correctif&nbsp;:</b> exclusion des mots (portable, laptop) et des gammes (Legion, Omen, Zephyrus…), plus la RTX 2050, qui n’existe qu’en portable.</p>
              </div>
            </article>
            <article class="rep open" tabindex="0">
              <span class="rep-art rose"><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={PIC.waterblock.svg} /></span>
              <div class="rep-b">
                <p class="rep-h"><span class="rep-k">Signalé le 27 mai 2026</span>Le bloc à eau vendu comme une RTX 3080<span class="rep-s">Ouvert</span></p>
                <p><b>Ce qui est arrivé&nbsp;:</b> un bloc de watercooling pour RTX 3080 et 3090, à 200&nbsp;€, est arrivé en «&nbsp;très bon deal&nbsp;»&nbsp;: revente ~306&nbsp;€, +95&nbsp;€ via Leboncoin. Haiku a reconnu un bloc à eau… et a conseillé d’acheter.</p>
                <p><b>Pourquoi&nbsp;:</b> le titre ne disait jamais «&nbsp;water block&nbsp;», seule la description le disait, et les exclusions ne lisent que le titre. Haiku part des chiffres du bot&nbsp;: il a hérité de l’erreur.</p>
              </div>
            </article>
          </section>

          <!-- 3 -->
          <section class="stn" id="modele" data-n="3" aria-labelledby="q3">
            <header class="stn-h"><span class="stn-n">3</span><h2 id="q3">{STEPS[2].q}</h2></header>
            <p class="stn-p">Le bot cherche dans le titre le modèle qui donnera un prix&nbsp;: motifs pour les cartes graphiques, processeurs, mémoire et SSD, alias du catalogue Videntis pour les alimentations et les cartes mères.</p>
            <ol class="reads">
              {READS.map((r, i) => (
                <li class={r.ok ? "" : "ko"} style={`--i:${i}`}>
                  <p class="rd-t">{r.t.map(([w, k], j) => <Fragment>{j > 0 && " "}<span class={"tkn " + k}>{w}</span></Fragment>)}</p>
                  <span class="rd-a" aria-hidden="true">→</span>
                  <p class="rd-o"><b>{r.out}</b><span>{r.fam}</span></p>
                </li>
              ))}
            </ol>
            <p class="fams"><span>7 familles reconnues&nbsp;:</span>{FAMS.map((f) => <em>{f}</em>)}</p>
            <article class="rep" tabindex="0">
              <span class="rep-art" data-bg="lined"><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={PIC.glasses.svg} /></span>
              <div class="rep-b">
                <p class="rep-h"><span class="rep-k">Signalé</span>Les lunettes Radeon<span class="rep-s ok">Corrigé</span></p>
                <p><b>Ce qui arrivait&nbsp;:</b> des lunettes Ray-Ban «&nbsp;RX 5154&nbsp;» arrivaient comme cartes graphiques. «&nbsp;RX&nbsp;» suivi de quatre chiffres, c’est exactement le motif d’une Radeon.</p>
                <p><b>Correctif&nbsp;:</b> lunettes, montures et Ray-Ban dans les exclusions. Un «&nbsp;RX&nbsp;» est refusé si le titre dit «&nbsp;Ray&nbsp;».</p>
              </div>
            </article>
          </section>

          <!-- 4 -->
          <section class="stn" id="vue" data-n="4" aria-labelledby="q4">
            <header class="stn-h"><span class="stn-n">4</span><h2 id="q4">{STEPS[3].q}</h2><span class="src">Branché sur <b>SQLite</b>, sur la machine du bot</span></header>
            <p class="stn-p">Une annonce vue reste en mémoire 7&nbsp;jours, avec son prix. Elle ne repasse que si ce prix baisse d’au moins 5&nbsp;%.</p>
            <ol class="days">
              <li style="--i:0"><span class="dy">Lundi</span><b>210&nbsp;€</b><em class="go">Postée dans #deals-fire</em></li>
              <li style="--i:1"><span class="dy">Mardi</span><b>210&nbsp;€</b><em>Relue, rien de neuf&nbsp;: silence</em></li>
              <li style="--i:2"><span class="dy">Jeudi</span><b>199&nbsp;€ <small>−5,2&nbsp;%</small></b><em class="go">Repostée dans #deals-price-drop</em></li>
              <li style="--i:3"><span class="dy">Jeudi</span><b>199&nbsp;€ <small>autre numéro</small></b><em>Même empreinte&nbsp;: ignorée</em></li>
            </ol>
            <p class="fp"><span>Empreinte&nbsp;:</span><code>{FP}</code><em>site, titre sans espaces ni ponctuation, prix arrondi à 5&nbsp;€</em></p>
            <article class="rep" tabindex="0">
              <span class="rep-art" data-bg="mat"><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={triple()} /></span>
              <div class="rep-b">
                <p class="rep-h"><span class="rep-k">Signalé</span>Trois numéros, un seul objet<span class="rep-s ok">Corrigé</span></p>
                <p><b>Ce qui arrivait&nbsp;:</b> une même carte déclenchait trois alertes d’affilée. Vinted publie parfois un objet sous plusieurs numéros, et la mémoire du bot ne connaissait que les numéros.</p>
                <p><b>Correctif&nbsp;:</b> l’empreinte ci-dessus, gardée 2&nbsp;heures, même après un redémarrage.</p>
              </div>
            </article>
          </section>

          <!-- 5 -->
          <section class="stn" id="profit" data-n="5" aria-labelledby="q5">
            <header class="stn-h"><span class="stn-n">5</span><h2 id="q5">{STEPS[4].q}</h2><span class="src">Branché sur <b>la référence Videntis</b>, PostgreSQL en lecture seule, rechargée toutes les 30&nbsp;min</span></header>
            <div class="calc">
              <p class="cl-row" style="--i:0"><span>Ventes confirmées sur Videntis, médiane</span><b>{eur(ev1.market_median)}</b></p>
              <p class="cl-row" style="--i:1"><span>Revue à la baisse&nbsp;: −15&nbsp;% à partir de 300&nbsp;€ (−20&nbsp;% à partir de 150&nbsp;€, −25&nbsp;% en dessous)</span><b>{eur(ev1.realistic_sell_price)}</b></p>
              <ul class="cl-ch">
                {CH3.map((c, i) => (
