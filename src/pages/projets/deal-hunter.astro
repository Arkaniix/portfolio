      }, { threshold: [0, .15] });
      each(stns, function (s) { mid.observe(s); if (reduce) s.classList.add("arr"); else arr.observe(s); });
    })();

    // ---------- Survols : sur mobile, le toucher rejoue l'animation ----------
    each(document.querySelectorAll(".sieve li, .sal6 li, .fork, .rep, .ai-c"), function (el) {
      el.addEventListener("click", function () {
        el.classList.remove("play"); void el.offsetWidth; el.classList.add("play");
        clearTimeout(el._t); el._t = setTimeout(function () { el.classList.remove("play"); }, 1600);
      });
    });

    // ---------- Étape 8 : déplier la réponse de Haiku ----------
    each(document.querySelectorAll(".ai-more"), function (b) {
      b.addEventListener("click", function (e) {
        e.stopPropagation();
        var rep = b.previousElementSibling, open = b.getAttribute("aria-expanded") !== "true";
        rep.style.maxHeight = (open ? rep.scrollHeight : rep.offsetHeight) + "px";
        void rep.offsetHeight;
        rep.classList.toggle("open", open); rep.style.maxHeight = open ? rep.scrollHeight + "px" : "";
        b.setAttribute("aria-expanded", String(open)); b.textContent = open ? "Réduire" : "Réponse complète";
      });
    });

    // ---------- Deux chasseurs : les mentions se recalculent ----------
    // Les quatre annonces sont posées l'une sur l'autre et passent en fondu ; les panneaux sont mis à jour sur place.
    (function () {
      var E = window.DealHunterEngine, D = window.DHDiscord, W = JSON.parse(document.getElementById("who-data").textContent);
      if (!E) return;
      var raw = JSON.parse(document.getElementById("dh-data").textContent);
      var data = { index: E.buildModelIndex(raw.catalog), market: raw.market.gpu, cpu: raw.market.cpu };
      var users = { me: JSON.parse(JSON.stringify(W.me)), other: JSON.parse(JSON.stringify(W.other)) };
      var R = W.deals.map(function (s) {
        return { s: s, r: E.processAd({ ad_id: s.id, title: s.title, price_eur: s.price, platform: s.platform, description: s.description || "", condition: s.condition || null }, data, { seen: {}, sent: {} }, W.pipeline, [users.me]) };
      });
      var cur = 0, who = document.getElementById("who"), tabs = who.querySelectorAll(".wtab"), timer = null, steps = 0, touched = false, AUTO = 3600;
      function eur(x) { var r = Math.round(x); return (r > 0 ? "+" : r < 0 ? "−" : "") + Math.abs(r) + " €"; }
      document.getElementById("who-deal").innerHTML = R.map(function (d, j) {
        var ev = d.r.ev, ch = W.channels[d.r.channel];

        return "<div class=\"wd" + (j === 0 ? " on" : "") + "\"" + (j ? " aria-hidden=\"true\"" : "") + ">" + window.Annonce.html({ pl: d.s.platform, bg: W.pics[d.s.pic], pics: W.art[d.s.pic] || "",
            title: esc(d.s.title), price: d.s.price, city: d.s.city, zip: d.s.zip, ago: d.s.ago, brand: d.s.brand, cond: d.s.cond, likes: d.s.likes, ship: d.s.ship, row: true }) +
          "<p class=\"wd-r\"><span class=\"salpill c-" + ch.c + "\"># " + ch.name + "</span><b>" + eur(ev.best_profit) + "</b> de profit net</p></div>";
      }).join("");
      var cards = who.querySelectorAll(".wd");
      function set(el, html) {                          // change le texte et rejoue un petit fondu, seulement s'il a changé
        if (el.innerHTML === html) return;
        el.innerHTML = html; el.classList.remove("flip"); void el.offsetWidth; el.classList.add("flip");
      }
      function render() {
        var d = R[cur], ev = d.r.ev;
        var off = users.me.presence === "OFF" && users.other.presence === "OFF";
        var res = E.mentions([users.me, users.other], ev, d.r.channel);
        set(document.getElementById("who-bot"), off ? "<b>Bot en pause</b>&nbsp;: plus personne ne chasse, les annonces ne sont même plus lues." : "<b>Bot en chasse</b>&nbsp;: au moins un chasseur est ON.");
        who.classList.toggle("paused", off);
        ["me", "other"].forEach(function (k, j) {
          var box = who.querySelector("[data-res=\"" + k + "\"]"), r = res[j];
          ["zz", "yes", "no"].forEach(function (c) { box.classList.toggle(c, c === (off ? "zz" : r.pinged ? "yes" : "no")); });
          set(box.querySelector(".hunt-t"), off ? "Bot en pause&nbsp;: annonce jamais lue" : r.pinged ? "<b>@" + esc(r.name) + "</b> mentionné" : "Silencieux&nbsp;: " + esc(r.why));
        });
        each(cards, function (c, j) { c.classList.toggle("on", j === cur); if (j === cur) c.removeAttribute("aria-hidden"); else c.setAttribute("aria-hidden", "true"); });
        each(tabs, function (t, j) { t.classList.toggle("on", j === cur); t.setAttribute("aria-selected", String(j === cur)); });
      }
      // Défilement automatique : un seul tour des quatre annonces à chaque arrivée, barre de progression sur l'onglet actif
      function stop() { clearTimeout(timer); timer = null; who.classList.remove("auto"); }
      function tick() {
        who.classList.remove("auto"); void who.offsetWidth;
        if (steps >= R.length) return stop();
        who.classList.add("auto");
        timer = setTimeout(function () { steps++; cur = (cur + 1) % R.length; render(); tick(); }, AUTO);
      }
      function interact() { touched = true; stop(); }
      each(tabs, function (t, j) { t.addEventListener("click", function () { interact(); cur = j; render(); }); });
      // Un panneau à la fois : les deux résultats restent côte à côte et servent d'onglets
      each(who.querySelectorAll(".hunt-res"), function (b) {
        b.addEventListener("click", function () {
          var k = b.getAttribute("data-res");
          each(who.querySelectorAll(".hunt-res"), function (x) { x.setAttribute("aria-selected", String(x === b)); });
          each(who.querySelectorAll(".hunt"), function (h) { var on = h.getAttribute("data-u") === k; h.classList.toggle("on", on); h.setAttribute("aria-hidden", String(!on)); });
        });
      });
      ["me", "other"].forEach(function (k) {
        var col = who.querySelector(".hunt[data-u=\"" + k + "\"]"), box = col.querySelector(".hunt-d"), note = col.querySelector(".hunt-n");
        function say(text) {
          var old = box.querySelector(".eph"); if (old) old.remove();
          box.insertAdjacentHTML("beforeend", "<div class=\"msg eph flip\">" + D.head({}) + "<div class=\"msg-b\"><p class=\"msg-c\">" + text +
            "</p><p class=\"eph-n\"><span aria-hidden=\"true\">👁</span> Vous seul·e pouvez voir ceci · <button type=\"button\" class=\"eph-x\">Ignorer ce message</button></p></div></div>");
          box.querySelector(".eph .msg-h time").textContent = "Aujourd’hui à " + new Date().getHours() + ":" + String(new Date().getMinutes()).padStart(2, "0");
        }
        box.addEventListener("click", function (e) { var x = e.target.closest(".eph-x"); if (x) x.closest(".eph").remove(); });
        var ctl = D.bindPanel(box, { compact: true, host: col, user: function () { return users[k]; }, maxGlobal: function () { return W.pipeline.max_price; },
          say: say, change: function () { interact(); set(note, ""); render(); } });
        col.querySelector(".hunt-off").addEventListener("click", function () {
          var u = users[k]; interact();
          if (u.presence === "OFF") set(note, "Déjà OFF.");
          else if (u.auto_off === false) set(note, "Auto-OFF désactivé&nbsp;: présence inchangée.");
          else { u.presence = "OFF"; set(note, "Discord fermé&nbsp;: présence passée à OFF."); }
          ctl.draw(); render();
        });
      });
      render();
      if (!reduce && "IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          if (es[0].isIntersecting) { if (!touched && !timer) { steps = 0; tick(); } }
          else stop();
        }, { threshold: .3 }).observe(who);
      }
    })();

    // ---------- Forge : la règle se construit à l'arrivée ----------
    (function () {
      var fg = document.getElementById("forge");
      if (reduce || !("IntersectionObserver" in window)) { fg.classList.add("built"); return; }
      var armed = true;
      new IntersectionObserver(function (es) {
        var e = es[0];
        if (!e.isIntersecting) { if (!armed) { fg.classList.remove("built"); armed = true; } return; }
        if (armed && e.intersectionRatio >= .35) { armed = false; void fg.offsetWidth; fg.classList.add("built"); }
      }, { threshold: [0, .35] }).observe(fg);
    })();
  })();
</script>
