<script type="application/json" id="srt-data" set:html={JSON.stringify(HERO)}></script>
<script type="application/json" id="plan-data" set:html={JSON.stringify(PLAN)}></script>
<script type="application/json" id="who-data" set:html={JSON.stringify({ me: ME, other: OTHER, deals: WHO_DEALS.map((sid) => bySid[sid]), pipeline: PIPELINE, channels: CHANNEL_INFO, pics: Object.fromEntries(Object.keys(PIC).map((k) => [k, PIC[k].bg])) })}></script>
<script is:inline>
  (function () {
    var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    function each(l, f) { Array.prototype.forEach.call(l, f); }
    function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

    // ---------- En-tête : la trieuse ----------
    // Chaque annonce tombe, ses mots-clés s'allument, le bot affiche modèle, revente et profit,
    // puis une étiquette part dans la case de son salon. Piloté par le temps, rejoué à chaque arrivée.
    (function () {
      var SC = JSON.parse(document.getElementById("srt-data").textContent);
      var srt = document.getElementById("srt"), stage = srt.querySelector(".srt-stage"), card = srt.querySelector(".dh-card");
      var pic = srt.querySelector(".dh-card-pic"), pics = pic.querySelectorAll(".pv"), tt = document.getElementById("srt-t");
      var read = document.getElementById("srt-read"), chip = document.getElementById("srt-chip"), slots = srt.querySelectorAll(".slot");
      var i = 0, timers = [], counts = {};
      function fill(k) {
        var s = SC[k];
        tt.innerHTML = s.t.map(function (w) { return "<span class=\"tkn " + w[1] + "\">" + esc(w[0]) + "</span>"; }).join(" ");
        document.getElementById("srt-p").textContent = s.p + "\u00a0€";
        document.getElementById("srt-m").textContent = s.meta;
        read.innerHTML = s.lines.map(function (l, j) { return "<div style=\"--j:" + j + "\"><dt>" + esc(l[0]) + "</dt><dd>" + esc(l[1]) + "</dd></div>"; }).join("");
        pic.setAttribute("data-bg", s.bg);
        each(pics, function (p) { p.classList.toggle("on", p.getAttribute("data-k") === s.pic); });
        chip.textContent = s.t.map(function (w) { return w[0]; }).join(" ").slice(0, 26) + (s.t.map(function (w) { return w[0]; }).join(" ").length > 26 ? "…" : "") + " · " + s.p + "\u00a0€";
        read.className = "srt-read" + (s.slot === "out" ? " is-out" : "");
      }
      function slotOf(s) { for (var k = 0; k < slots.length; k++) if (slots[k].getAttribute("data-s") === s.slot) return slots[k]; return slots[slots.length - 1]; }
      function lit(on) { each(slots, function (li) { li.classList.remove("hit", "pinged"); }); }
      function stop() { timers.forEach(clearTimeout); timers = []; }
      function setCount(li) { var s = li.getAttribute("data-s"); counts[s] = (counts[s] || 0) + 1; li.querySelector("em").textContent = counts[s]; li.classList.add("has"); }
      function reset() {
        srt.className = "srt pre notr"; chip.style.transform = ""; lit(false);
        void srt.offsetWidth; srt.classList.remove("notr");
      }
      function rewind() {                               // retour au début : première annonce, compteurs à zéro
        i = 0; counts = {}; reset(); fill(0);
        each(slots, function (li) { li.classList.remove("has"); li.querySelector("em").textContent = "0"; });
      }
      function finalState() {                          // mouvement réduit : la première annonce, déjà triée
        i = 0; fill(0); srt.className = "srt done";
        each(tt.querySelectorAll(".tkn"), function (t) { t.classList.add("lit"); });
        var li = slotOf(SC[0]); li.classList.add("hit"); setCount(li); if (SC[0].ping) li.classList.add("pinged");
      }
      function play() {
        stop(); reset(); fill(i);
        var s = SC[i], toks = tt.querySelectorAll(".tkn");
        timers.push(setTimeout(function () { srt.className = "srt in"; }, 60));
        each(toks, function (t, k) { timers.push(setTimeout(function () { t.classList.add("lit"); }, 650 + k * 120)); });
        var tEnd = 650 + toks.length * 120;
        timers.push(setTimeout(function () { srt.classList.add("read"); }, tEnd + 100));
        var tFly = tEnd + 650 + s.lines.length * 260;
        timers.push(setTimeout(function () {             // l'étiquette part vers sa case
          var li = slotOf(s), sr = stage.getBoundingClientRect(), cr = chip.getBoundingClientRect(), lr = li.getBoundingClientRect();
          var dx = lr.left + lr.width / 2 - (cr.left + cr.width / 2), dy = lr.top + lr.height / 2 - (cr.top + cr.height / 2);
          srt.classList.add("fly");
          chip.style.transform = "translate(" + dx.toFixed(1) + "px," + dy.toFixed(1) + "px) scale(.55)";
        }, tFly));
        timers.push(setTimeout(function () {
          var li = slotOf(s); srt.classList.add("landed"); li.classList.add("hit"); setCount(li);
          if (s.ping) li.classList.add("pinged");
        }, tFly + 640));
        timers.push(setTimeout(next, tFly + 640 + 1700));
      }
      function next() { stop(); i = (i + 1) % SC.length; if (reduce) { fill(i); return; } play(); }
      document.getElementById("srt-next").addEventListener("click", function () { armed = false; next(); });
      if (reduce) { finalState(); return; }
      var armed = true;
      reset(); fill(0);
      if (!("IntersectionObserver" in window)) timers.push(setTimeout(function () { armed = false; play(); }, 400));
      else {
        new IntersectionObserver(function (es) {
          var e = es[0];
          if (!e.isIntersecting) { if (!armed) { stop(); rewind(); armed = true; } return; }
          if (armed && e.intersectionRatio >= .25) { armed = false; play(); }
        }, { threshold: [0, .25] }).observe(srt);
      }
    })();

    // ---------- Survols : sur mobile, le toucher rejoue l'animation ----------
    each(document.querySelectorAll(".salon, .out, .duel, .inc2"), function (el) {
      el.addEventListener("click", function () {
        el.classList.remove("play"); void el.offsetWidth; el.classList.add("play");
        clearTimeout(el._t); el._t = setTimeout(function () { el.classList.remove("play"); }, 1600);
      });
    });

    // ---------- Le vrai bot : légende et repères liés ----------
    (function () {
      var anat = document.getElementById("anat");
      function hi(n) { each(anat.querySelectorAll("[data-n]"), function (e) { e.classList.toggle("hi", e.getAttribute("data-n") === n); }); }
      each(anat.querySelectorAll(".legend li, [data-n] > .n, .win-top .n"), function (el) {
        var n = el.getAttribute("data-n") || el.textContent.trim();
        el.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") hi(n); });
        el.addEventListener("click", function () { hi(n); });
      });
      anat.addEventListener("pointerleave", function (e) { if (e.pointerType === "mouse") hi(""); });
    })();

    // ---------- Deux chasseurs : les mentions se recalculent ----------
    (function () {
      var E = window.DealHunterEngine, W = JSON.parse(document.getElementById("who-data").textContent);
      if (!E) return;
      var data = { index: {}, market: null, cpu: null };
      var raw = JSON.parse(document.getElementById("dhd-data").textContent);
      data = { index: E.buildModelIndex(raw.catalog), market: raw.market.gpu, cpu: raw.market.cpu };
      var users = { me: JSON.parse(JSON.stringify(W.me)), other: JSON.parse(JSON.stringify(W.other)) };
      var R = W.deals.map(function (s) {
        return { s: s, r: E.processAd({ ad_id: s.id, title: s.title, price_eur: s.price, platform: s.platform, description: s.description || "", condition: s.condition || null }, data, { seen: {}, sent: {} }, W.pipeline, [users.me]) };
      });
      var cur = 0, auto = null, who = document.getElementById("who"), note = {};
      function eur(x) { var r = Math.round(x); return (r > 0 ? "+" : r < 0 ? "−" : "") + Math.abs(r) + "\u00a0€"; }
      function render() {
        var d = R[cur], ev = d.r.ev, ch = W.channels[d.r.channel];
        document.getElementById("who-deal").innerHTML =
          "<div class=\"wd\"><span class=\"wd-pic\" data-bg=\"" + W.pics[d.s.pic] + "\">" + (document.querySelector("#dhd-pic .pv[data-k=\"" + d.s.pic + "\"]") || { outerHTML: "" }).outerHTML.replace(" on\"", "\"") + "</span>" +
          "<div><p class=\"wd-t\">" + esc(d.s.title) + "</p><p class=\"wd-m\">" + d.s.price + " € · " + (d.s.platform === "vinted" ? "Vinted" : "Leboncoin") + "</p>" +
          "<p class=\"wd-r\"><span class=\"salpill c-" + ch.c + "\"># " + ch.name + "</span><b>" + eur(ev.best_profit) + "</b> de profit</p></div></div>";
        var off = users.me.presence === "OFF" && users.other.presence === "OFF";
        var res = E.mentions([users.me, users.other], ev, d.r.channel);
        document.getElementById("who-bot").innerHTML = off ? "<b>Bot en pause</b>&nbsp;: plus personne ne chasse, les annonces ne sont même plus lues." : "<b>Bot en chasse</b>&nbsp;: au moins un chasseur est ON.";
        who.classList.toggle("paused", off);
        ["me", "other"].forEach(function (k, j) {
          var box = who.querySelector("[data-res=\"" + k + "\"]"), r = res[j];
          box.className = "hunt-res " + (off ? "zz" : r.pinged ? "yes" : "no");
          box.innerHTML = off ? "Bot en pause&nbsp;: annonce jamais lue" : r.pinged ? "<b>@" + esc(r.name) + "</b> mentionné" : "Silencieux&nbsp;: " + esc(r.why) + (note[k] ? "<em>" + note[k] + "</em>" : "");
          if (!off && r.pinged && note[k]) box.innerHTML += "<em>" + note[k] + "</em>";
          var p = who.querySelector("[data-u=\"" + k + "\"]"), u = users[k];
          each(p.querySelectorAll("[data-f]"), function (b) {
            var f = b.getAttribute("data-f");
            if (f === "presence") { b.textContent = u.presence; b.setAttribute("aria-pressed", u.presence === "ON" ? "true" : "false"); }
            else if (f === "notify_when_offline") { b.textContent = u.notify_when_offline ? "oui" : "non"; b.setAttribute("aria-pressed", u.notify_when_offline ? "true" : "false"); }
            else if (f === "min_profit_to_ping") b.setAttribute("aria-pressed", String(u.min_profit_to_ping === +b.getAttribute("data-v")));
            else if (f === "ch") b.setAttribute("aria-pressed", String(!!u.channels_to_ping[b.getAttribute("data-v")]));
          });
        });
        each(who.querySelectorAll(".wtab"), function (t, j) { t.classList.toggle("on", j === cur); t.setAttribute("aria-selected", String(j === cur)); });
      }
      function stopAuto() { clearInterval(auto); auto = null; }
      each(who.querySelectorAll(".wtab"), function (t, j) { t.addEventListener("click", function () { stopAuto(); cur = j; render(); }); });
      each(who.querySelectorAll(".hunt"), function (p) {
        var k = p.getAttribute("data-u"), u = users[k];
        each(p.querySelectorAll("[data-f]"), function (b) {
          b.addEventListener("click", function () {
            stopAuto(); note[k] = "";
            var f = b.getAttribute("data-f");
            if (f === "presence") u.presence = u.presence === "ON" ? "OFF" : "ON";
            else if (f === "notify_when_offline") u.notify_when_offline = !u.notify_when_offline;
            else if (f === "min_profit_to_ping") u.min_profit_to_ping = +b.getAttribute("data-v");
            else if (f === "ch") { var c = b.getAttribute("data-v"); u.channels_to_ping[c] = !u.channels_to_ping[c]; }
            else if (f === "disconnect") { if (u.presence === "ON") { u.presence = "OFF"; note[k] = "Discord fermé : présence passée à OFF."; } else note[k] = "Déjà OFF."; }
            render();
          });
        });
      });
      render();
      if (!reduce && "IntersectionObserver" in window) {
        new IntersectionObserver(function (es) {
          if (es[0].isIntersecting) { if (!auto && auto !== false) auto = setInterval(function () { cur = (cur + 1) % R.length; render(); }, 3200); }
          else if (auto) { clearInterval(auto); auto = null; }
        }, { threshold: .3 }).observe(who);
      }
    })();

    // ---------- Le plan : détail de l'étape choisie ----------
    (function () {
      var P = JSON.parse(document.getElementById("plan-data").textContent), rail = document.getElementById("rail"), det = document.getElementById("rail-detail");
      each(rail.querySelectorAll(".st2"), function (n) {
        function show() {
          each(rail.querySelectorAll(".st2"), function (o) { o.classList.toggle("on", o === n); });
          var t = P[n.getAttribute("data-k")]; det.innerHTML = "<b>" + esc(t[0]) + "</b> " + esc(t[1]);
        }
        n.addEventListener("click", show);
        n.addEventListener("pointerenter", function (e) { if (e.pointerType === "mouse") show(); });
      });
    })();

    // ---------- Forge : la règle se construit à l'arrivée ----------
    (function () {
      var f = document.getElementById("forge");
      if (reduce || !("IntersectionObserver" in window)) { f.classList.add("built"); return; }
      var armed = true;
      new IntersectionObserver(function (es) {
        var e = es[0];
        if (!e.isIntersecting) { if (!armed) { f.classList.remove("built"); armed = true; } return; }
        if (armed && e.intersectionRatio >= .35) { armed = false; void f.offsetWidth; f.classList.add("built"); }
      }, { threshold: [0, .35] }).observe(f);
    })();
  })();
</script>
