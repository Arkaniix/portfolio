---
// Page 404 : Cloudflare la sert pour toute adresse inconnue (assets.not_found_handling = "404-page" dans wrangler.jsonc).
// Le dessin reprend le vocabulaire de Deal Hunter : sans modèle reconnu, pas de prix de référence.
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/projet.css";
---
<Base title="Page introuvable · Etienne Monat" description="Cette adresse ne mène à aucune page du site d’Etienne Monat." themeColor="#2B45FF">
<meta slot="head" name="robots" content="noindex">
<SiteHeader />

<main class="v">
  <section class="band b-blue nf-band" aria-labelledby="nf-title">
    <div class="wrap nf-grid">
      <div class="nf-txt">
        <p class="kicker">Erreur 404</p>
        <h1 id="nf-title" class="v-h1">Introuvable</h1>
        <p class="lead">Aucune page à cette adresse. Le lien est peut-être ancien, ou la page n’existe pas encore.</p>
        <div class="cta">
          <a class="vbtn primary" href="/">Retour à l’accueil</a>
          <a class="vbtn" href="/projets/videntis/">Videntis</a>
          <a class="vbtn" href="/projets/deal-hunter/">Deal Hunter</a>
        </div>
      </div>
      <div class="nf-art" aria-hidden="true">
        <div class="nf-card">
          <div class="nf-pic"><span>?</span><em>page inventée</em></div>
          <p class="nf-t">Page demandée, état inconnu</p>
          <p class="nf-p">— €</p>
          <p class="nf-m">= aucun modèle reconnu</p>
        </div>
        <p class="nf-stamp">❓ Pas de référence</p>
      </div>
    </div>
  </section>
  <section class="band b-paper nf-foot"><div class="wrap"><SiteFooter /></div></section>
</main>
</Base>

<style>
  .nf-band{ min-height:calc(100svh - 120px); display:grid; align-items:center; padding-top:clamp(110px, 12vw, 150px); }
  .nf-grid{ display:grid; grid-template-columns:minmax(0, 1.2fr) minmax(0, 1fr); gap:clamp(28px, 5vw, 72px); align-items:center; }
  .nf-band .v-h1{ font-size:clamp(64px, 10vw, 150px); }
  .nf-band .kicker{ margin-bottom:calc(clamp(64px, 10vw, 150px) * .1 + 18px); }
  .nf-band .lead{ color:#fff; }
  /* Sur le bleu : boutons secondaires et en-tête en clair, pour le contraste */
  .nf-band .vbtn:not(.primary){ background:#fff; }
  :global(.top.sub:not(.solid) .brand), :global(.top.sub:not(.solid) nav a){ color:#fff; }
  .nf-art{ position:relative; justify-self:center; width:min(340px, 100%); }
  .nf-card{ background:#fff; color:var(--ink); border:1.5px solid var(--ink); border-radius:12px; padding:12px 12px 16px; box-shadow:-8px 8px 0 var(--ink); transform:rotate(2deg); }
  .nf-pic{ position:relative; display:grid; place-items:center; height:170px; border-radius:8px; border:1.5px dashed var(--ink-2); background:repeating-linear-gradient(-45deg, var(--paper) 0 10px, #fff 10px 20px); }
  .nf-pic span{ font-family:var(--display); font-variation-settings:"wdth" 70, "wght" 840; font-size:110px; line-height:1; color:var(--rule); }
  .nf-pic em{ position:absolute; left:8px; bottom:8px; font-style:normal; font-family:var(--mono); font-size:11px; background:#fff; border:1px solid var(--rule); border-radius:4px; padding:1px 6px; }
  .nf-card p{ margin:0; }
  .nf-t{ margin-top:12px !important; font-size:17px; font-weight:800; }
  .nf-p{ margin-top:4px !important; font-size:22px; font-weight:800; }
  .nf-m{ margin-top:6px !important; font-size:14px; font-weight:700; color:var(--blue); }
  .nf-stamp{ position:absolute; right:-14px; top:34px; margin:0; transform:rotate(-12deg); font-family:var(--display); font-variation-settings:"wdth" 75, "wght" 850; font-size:26px; text-transform:uppercase; color:var(--pink-ink); border:4px solid var(--pink-ink); border-radius:10px; padding:4px 12px; background:rgba(255, 255, 255, .85); animation:nf-slam .45s cubic-bezier(.3, 1.5, .5, 1) .5s both; }
  @keyframes nf-slam{ from{ opacity:0; transform:rotate(-20deg) scale(1.8); } }
  .nf-foot{ padding-block:24px; }
  @media (max-width: 760px){
    .nf-grid{ grid-template-columns:minmax(0, 1fr); }
    .nf-art{ width:min(300px, 86%); margin-top:8px; }
    .nf-stamp{ font-size:21px; right:-8px; top:26px; }
  }
  @media (prefers-reduced-motion: reduce){ .nf-stamp{ animation:none; } }
</style>
