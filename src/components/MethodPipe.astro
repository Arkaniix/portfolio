---
// Frise « Ma méthode » : une fonctionnalité traverse cinq étapes, chaque vignette joue son étape au passage.
// Reprise telle quelle de l’accueil (styles et script), avec sa propre boucle d’animation.
---
<div class="pipe-box" id="pipe">
  <div class="rail" aria-hidden="true"><i class="rail-fill"></i></div>
  <span class="token" aria-hidden="true"></span>
  <ol class="pipe">
    <li style="--i:0"><span class="pn">1</span>
      <div class="vg vg-spec" aria-hidden="true"><p class="vh"><span>spec.md</span></p>
        <p class="sr"><b class="ck"></b>Besoin<i class="sb"><i></i></i></p>
        <p class="sr"><b class="ck"></b>Contraintes<i class="sb"><i></i></i></p>
        <p class="sr"><b class="ck"></b>Cas limites<i class="sb"><i></i></i></p></div>
      <strong>Spécifications</strong><span class="pd">J’écris le besoin, les contraintes et les cas limites avant toute ligne de code.</span></li>
    <li style="--i:1"><span class="pn">2</span>
      <div class="vg vg-ag" aria-hidden="true">
        <div class="ag"><p><b>Claude Code</b><span>serveur</span><em class="st"></em></p><i class="cl c1"><i></i></i><i class="cl c1"><i></i></i></div>
        <div class="ag"><p><b>Lovable</b><span>interface</span><em class="st"></em></p><i class="cl c2"><i></i></i><i class="cl c2"><i></i></i></div></div>
      <strong>Agents</strong><span class="pd">Claude Code exécute côté serveur, Lovable côté interface.</span></li>
    <li style="--i:2"><span class="pn">3</span>
      <div class="vg vg-diff" aria-hidden="true"><p class="vh"><span>diff</span><em class="rv">Relu</em></p>
        <p class="dl a"><span>+</span><i style="width:72%"></i></p>
        <p class="dl d"><span>−</span><i style="width:50%"></i></p>
        <p class="dl a"><span>+</span><i style="width:84%"></i></p>
        <p class="dl"><span></span><i style="width:60%"></i></p>
        <b class="scan"></b></div>
      <strong>Relecture</strong><span class="pd">Je relis chaque diff, jamais le seul résumé de l’agent.</span></li>
    <li style="--i:3"><span class="pn">4</span>
      <div class="vg vg-test" aria-hidden="true"><p class="vh"><span>golden master</span><em class="cnt">0/3</em></p>
        <p class="tr"><b class="td"></b><i style="width:78%"></i></p>
        <p class="tr"><b class="td"></b><i style="width:60%"></i></p>
        <p class="tr"><b class="td"></b><i style="width:70%"></i></p></div>
      <strong>Tests</strong><span class="pd">Une suite golden master fige le comportement de l’estimation de prix.</span></li>
    <li style="--i:4"><span class="pn">5</span>
      <div class="vg vg-dep" aria-hidden="true"><p class="tl">$ ./deploy</p><p class="tl t2">dépôt propre ✓</p><p class="tl t3">mise en ligne</p>
        <i class="pb"><i></i></i><em class="live">En ligne</em></div>
      <strong>Déploiement</strong><span class="pd">Un seul chemin, qui refuse de partir si le dépôt n’est pas propre.</span></li>
  </ol>
</div>
<style is:global>
/* Ma méthode : une fonctionnalité traverse les cinq étapes ; chaque vignette joue son étape au passage */
.pipe-box{ position:relative; }
.pipe{ list-style:none; margin:0; padding:0; position:relative; display:grid; grid-template-columns:repeat(5, minmax(0, 1fr)); gap:28px; }
.rail{ position:absolute; background:var(--rule); border-radius:2px; pointer-events:none; }
.rail-fill{ position:absolute; inset:0; border-radius:2px; background:var(--blue); transform-origin:0 50%; transform:scaleX(var(--f, 0)); }
.rail.v .rail-fill{ transform-origin:50% 0; transform:scaleY(var(--f, 0)); }
.token{
  position:absolute; left:0; top:0; z-index:3; width:18px; height:18px; margin:-9px 0 0 -9px; border-radius:50%;
  background:var(--blue); border:2.5px solid #fff; box-shadow:0 0 0 1.5px var(--blue), 0 0 0 7px rgba(43,69,255,.16);
  opacity:0; pointer-events:none;
}
.pipe li{
  position:relative; padding-top:46px; display:flex; flex-direction:column; gap:6px; min-width:0;
  opacity:0; transform:translateY(18px); transition:opacity .5s ease, transform .7s var(--ease); transition-delay:calc(var(--i) * 90ms);
}
.pipe-box.seen .pipe li{ opacity:1; transform:none; }
.pn{
  position:absolute; left:0; top:0; z-index:2; width:30px; height:30px; border-radius:50%; display:grid; place-items:center;
  background:var(--paper); border:2px solid var(--ink-2); font-size:13px; font-weight:800; color:var(--ink-2); font-variant-numeric:tabular-nums;
  transition:background-color .3s ease, color .3s ease, border-color .3s ease, transform .35s var(--ease);
}
.pipe li.cur .pn{ background:var(--blue); border-color:var(--blue); color:#fff; transform:scale(1.15); }
.pn::after{ content:""; position:absolute; inset:-2px; border-radius:50%; border:2px solid var(--blue); opacity:0; pointer-events:none; }
.pipe li.cur .pn::after{ animation:arrive .7s ease-out; }
@keyframes arrive{ from{ opacity:.9; transform:scale(1); } to{ opacity:0; transform:scale(2.1); } }
.pipe li.done .pn{ background:var(--ink); border-color:var(--ink); color:#fff; }
.pipe strong{ font-size:17px; font-weight:750; transition:color .3s ease; }
.pipe li.cur strong{ color:var(--blue); }
.vg{
  position:relative; height:118px; margin-bottom:10px; padding:9px 11px 10px; overflow:hidden; cursor:default;
  background:#fff; color:var(--ink); border:1.5px solid var(--ink); border-radius:10px; box-shadow:0 3px 0 rgba(17,18,22,.16);
  font-size:11.5px; line-height:1.3; transition:box-shadow .3s ease, transform .35s var(--ease);
}
.vg > *{ transition:opacity .35s ease; }
.pipe-box.rst .vg > *{ opacity:0 !important; }
.pipe li.cur .vg{ box-shadow:-5px 5px 0 var(--ink); transform:translate(3px, -3px); }
.vg p{ margin:0; }
.vh{ display:flex; align-items:center; justify-content:space-between; gap:6px; padding-bottom:6px; margin-bottom:7px !important; border-bottom:1px solid var(--rule); font-family:var(--mono); font-size:10.5px; color:var(--ink-2); }
.vh em{ font-style:normal; font-family:var(--font); font-size:10.5px; font-weight:800; border-radius:999px; padding:1px 7px; }
/* 1. Spécifications */
.sr{ display:flex; align-items:center; gap:7px; font-weight:650; white-space:nowrap; }
.sr + .sr{ margin-top:7px; }
.ck{ flex:none; width:14px; height:14px; border-radius:4px; border:1.5px solid var(--rule); display:grid; place-items:center; font-size:9px; transition:background-color .2s ease, border-color .2s ease; }
.ck.on{ background:var(--green); border-color:var(--ink); }
.ck.on::after{ content:"✓"; font-weight:900; }
.sb{ flex:1; min-width:16px; height:6px; border-radius:3px; background:#EEF0F3; overflow:hidden; }
.sb i{ display:block; height:100%; width:0; border-radius:3px; background:var(--ink-2); }
/* 2. Agents */
.ag + .ag{ margin-top:10px; }
.ag p{ display:flex; align-items:baseline; gap:6px; white-space:nowrap; }
.ag b{ font-weight:800; }
.ag p span{ color:var(--ink-2); }
.st{ margin-left:auto; align-self:center; width:8px; height:8px; border-radius:50%; background:var(--rule); }
.st.run{ background:var(--yellow); box-shadow:0 0 0 2px rgba(255,217,59,.4); animation:blinkSoft .8s ease-in-out infinite; }
.st.ok{ background:var(--green); box-shadow:0 0 0 1.5px var(--ink); }
@keyframes blinkSoft{ 50%{ opacity:.35; } }
.cl{ display:block; height:5px; margin-top:5px; border-radius:3px; background:#EEF0F3; overflow:hidden; }
.cl i{ display:block; height:100%; width:0; border-radius:3px; }
.cl.c1 i{ background:var(--pink-ink); }
.cl.c2 i{ background:var(--blue); }
/* 3. Relecture */
.dl{ position:relative; display:flex; align-items:center; gap:6px; height:15px; padding:0 5px; border-radius:3px; font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--ink-2); }
.dl + .dl{ margin-top:3px; }
.dl i{ display:block; height:5px; border-radius:3px; background:rgba(17,18,22,.22); }
.dl.a{ background:#DDF8EB; color:#11834F; }
.dl.d{ background:#FFE3EF; color:var(--pink-ink); }
.dl.seen::after{ content:"✓"; position:absolute; right:5px; top:0; font-size:10px; font-weight:900; color:var(--ink); }
.scan{ position:absolute; left:8px; right:8px; top:0; height:19px; border:1.5px solid var(--ink); border-radius:4px; opacity:0; pointer-events:none; }
.rv{ background:var(--green); color:var(--ink); opacity:0; transform:scale(.7); transition:opacity .2s ease, transform .3s var(--ease); }
.rv.on{ opacity:1; transform:none; }
/* 4. Tests */
.tr{ display:flex; align-items:center; gap:8px; }
.tr + .tr{ margin-top:8px; }
.tr i{ display:block; height:5px; border-radius:3px; background:#EEF0F3; }
.td{ flex:none; width:15px; height:15px; border-radius:50%; border:1.5px solid var(--rule); display:grid; place-items:center; font-size:9px; transition:background-color .2s ease, border-color .2s ease, transform .3s var(--ease); }
.td.on{ background:var(--green); border-color:var(--ink); transform:scale(1.1); }
.td.on::after{ content:"✓"; font-weight:900; }
.cnt{ background:#EEF0F3; color:var(--ink-2); font-variant-numeric:tabular-nums; }
.cnt.ok{ background:var(--green); color:var(--ink); }
/* 5. Déploiement */
.vg-dep{ background:#0A0B0E; color:#E6F6EE; font-family:var(--mono); font-size:11px; }
.tl{ line-height:1.55; white-space:nowrap; opacity:0; }
.tl.t2{ color:var(--green); }
.tl.t3{ color:rgba(230,246,238,.7); }
.pb{ display:block; height:6px; margin-top:6px; border-radius:3px; background:rgba(255,255,255,.12); overflow:hidden; }
.pb i{ display:block; height:100%; width:0; border-radius:3px; background:var(--green); }
.live{
  position:absolute; right:10px; bottom:9px; font-style:normal; font-family:var(--font); font-size:11px; font-weight:800;
  color:var(--ink); background:var(--green); border-radius:999px; padding:2px 9px; opacity:0; transform:scale(.6);
  transition:opacity .2s ease, transform .35s var(--ease);
}
.live.on{ opacity:1; transform:none; }
.live.on::before{ content:""; display:inline-block; width:6px; height:6px; margin-right:5px; border-radius:50%; background:var(--ink); vertical-align:1px; }
.pd{ font-size:15px; line-height:1.5; color:var(--ink-2); }
@media (max-width: 860px){
  .pipe{ grid-template-columns:minmax(0, 1fr); gap:26px; }
  .pipe li{ padding-top:0; padding-left:46px; }
  .vg{ height:108px; max-width:360px; }
}
@media (prefers-reduced-motion: reduce){
  .pipe li{ opacity:1; transform:none; }
}
</style>
<script is:inline>
(function () {
  "use strict";
  var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  function ease(t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
  /* ---------------- Méthode ---------------- */
  // Une fonctionnalité traverse les cinq étapes ; chaque vignette joue son étape quand elle y arrive.
  // Au survol, l'étape survolée se rejoue et la boucle attend.
  var pipe = document.getElementById("pipe");
  var pipeList = pipe.querySelector(".pipe");
  var pItems = Array.prototype.slice.call(pipe.querySelectorAll(".pipe > li"));
  var pBadges = pItems.map(function (li) { return li.querySelector(".pn"); });
  var pVg = pItems.map(function (li) { return li.querySelector(".vg"); });
  var rail = pipe.querySelector(".rail"), railFill = pipe.querySelector(".rail-fill"), token = pipe.querySelector(".token");
  var P_STEP = 1750, P_TRAVEL = 480, P_PLAY = 1250, P_T0 = 900, P_HOLD = 1600;
  var P_LOOP = 4 * P_STEP + P_PLAY + P_HOLD;
  var pIn = false, pClock = 0, pLast = 0, pVert = false, pPos = [], pFocus = -1, pFocusT0 = 0, pMem = {};
  function pm(key, val, fn) { if (pMem[key] !== val) { pMem[key] = val; fn(val); } }
  function sg(p, a, b) { return clamp((p - a) / (b - a), 0, 1); }
  function q(el, sel) { return Array.prototype.slice.call(el.querySelectorAll(sel)); }
  var VGF = [
    (function (el) { // Spécifications : le besoin, les contraintes et les cas limites s'écrivent puis se cochent
      var bars = q(el, ".sb i"), cks = q(el, ".ck"), W = [92, 74, 86];
      return function (p) { bars.forEach(function (b, k) { var f = sg(p, .05 + k * .29, .27 + k * .29); b.style.width = (f * W[k]).toFixed(1) + "%"; cks[k].classList.toggle("on", f >= 1); }); };
    })(pVg[0]),
    (function (el) { // Agents : Claude Code et Lovable travaillent en parallèle
      var ls = q(el, ".cl i"), st = q(el, ".st"), W = [88, 62, 76, 92];
      var R = [[.04, .4], [.4, .78], [.16, .52], [.52, .86]];
      return function (p) {
        ls.forEach(function (l, k) { l.style.width = (sg(p, R[k][0], R[k][1]) * W[k]).toFixed(1) + "%"; });
        st.forEach(function (d, k) { var done = p >= R[k * 2 + 1][1], run = p > 0 && !done; d.className = "st" + (done ? " ok" : (run ? " run" : "")); });
      };
    })(pVg[1]),
    (function (el) { // Relecture : chaque ligne du diff est relue, puis « Relu »
      var dl = q(el, ".dl"), scan = el.querySelector(".scan"), rv = el.querySelector(".rv");
      return function (p) {
        var f = sg(p, .02, .8), pos = f * (dl.length - 1);
        var top = dl[0].offsetTop - 2 + pos * (dl[1].offsetTop - dl[0].offsetTop);
        scan.style.transform = "translateY(" + top.toFixed(1) + "px)";
        scan.style.opacity = p > 0 && p < .92 ? 1 : 0;
        dl.forEach(function (d, k) { d.classList.toggle("seen", p > 0 && pos >= k + .55 || p >= .8); });
        rv.classList.toggle("on", p >= .86);
      };
    })(pVg[2]),
    (function (el) { // Tests : la suite passe, test par test
      var td = q(el, ".td"), cnt = el.querySelector(".cnt");
      return function (p) {
        var n = 0;
        td.forEach(function (d, k) { var on = p >= .22 + k * .25; d.classList.toggle("on", on); if (on) n++; });
        cnt.textContent = n + "/3"; cnt.classList.toggle("ok", n === 3);
      };
    })(pVg[3]),
    (function (el) { // Déploiement : dépôt vérifié, mise en ligne
      var tl = q(el, ".tl"), pb = el.querySelector(".pb i"), live = el.querySelector(".live");
      return function (p) {
        tl.forEach(function (l, k) { l.style.opacity = p > 0 && p >= k * .2 ? 1 : 0; });
        pb.style.width = (sg(p, .42, .84) * 100).toFixed(1) + "%";
        live.classList.toggle("on", p >= .88);
      };
    })(pVg[4])
  ];
  function pipeMeasure() {
    var ol = pipeList;
    pVert = getComputedStyle(ol).gridTemplateColumns.split(" ").length === 1;
    pPos = pBadges.map(function (b, i) {
      var li = pItems[i];
      return { x: ol.offsetLeft + li.offsetLeft + b.offsetLeft + b.offsetWidth / 2, y: ol.offsetTop + li.offsetTop + b.offsetTop + b.offsetHeight / 2 };
    });
    var a = pPos[0], z = pPos[4];
    rail.classList.toggle("v", pVert);
    rail.style.cssText = pVert ? "left:" + (a.x - 1) + "px;top:" + a.y + "px;width:2px;height:" + (z.y - a.y) + "px"
      : "left:" + a.x + "px;top:" + (a.y - 1) + "px;height:2px;width:" + (z.x - a.x) + "px";
    pMem = {};
  }
  function pipeState(lt, now) {
    // lt : temps dans la boucle (négatif avant le premier départ)
    var tokI = 0, tokF = 0, tokO = 0;
    for (var i = 0; i < 5; i++) {
      var arr = i * P_STEP;
      if (lt >= arr - P_TRAVEL) {
        tokI = i; tokF = i === 0 ? 1 : ease(clamp((lt - (arr - P_TRAVEL)) / P_TRAVEL, 0, 1));
        var u = (lt - (arr - P_TRAVEL)) / P_TRAVEL;
        tokO = i === 0 ? 0 : clamp(Math.min(u * 6, (1 - u) * 6), 0, 1);
      }
    }
    var rst = lt > P_LOOP - 420;
    pm("rst", rst, function (v) { pipe.classList.toggle("rst", v); });
    var A = pPos[Math.max(0, tokI - 1)], B = pPos[tokI];
    var tx = lerp(A.x, B.x, tokF), ty = lerp(A.y, B.y, tokF);
    token.style.transform = "translate(" + tx.toFixed(1) + "px," + ty.toFixed(1) + "px)";
    token.style.opacity = tokO.toFixed(3);
    var a = pPos[0], z = pPos[4];
    var fr = pVert ? (ty - a.y) / (z.y - a.y) : (tx - a.x) / (z.x - a.x);
    rail.style.setProperty("--f", (rst ? 0 : clamp(fr, 0, 1)).toFixed(4));
    for (var k = 0; k < 5; k++) {
      var p = pFocus === k ? clamp((now - pFocusT0) / P_PLAY, 0, 1) : clamp((lt - k * P_STEP) / P_PLAY, 0, 1);
      if (pFocus === k && p >= 1 && lt < k * P_STEP) p = 1;
      var cls = pFocus === k ? (p < 1 ? "cur" : "cur done") : (p >= 1 ? "done" : (lt >= k * P_STEP && p > 0 ? "cur" : ""));
      if (pFocus >= 0 && pFocus !== k && cls === "cur") cls = "";
      pm("c" + k, cls, (function (li) { return function (v) { li.classList.remove("cur", "done"); if (v) v.split(" ").forEach(function (c) { li.classList.add(c); }); }; })(pItems[k]));
      pm("p" + k, Math.round(p * 400), (function (f) { return function () { f(p); }; })(VGF[k]));
    }
  }
  function pipeFrame(now) {
    var dt = pLast ? Math.min(100, now - pLast) : 0; pLast = now;
    if (pFocus < 0) pClock += dt;
    var lt = pClock < P_T0 ? pClock - P_T0 : (pClock - P_T0) % P_LOOP;
    pipeState(lt, now);
  }
  pItems.forEach(function (li, k) {
    li.addEventListener("pointerenter", function (e) { if (e.pointerType !== "mouse" || reduce) return; pFocus = k; pFocusT0 = performance.now(); });
    li.addEventListener("pointerleave", function () { if (pFocus === k) pFocus = -1; });
  });
  function pipeShowAll() {
    pipe.classList.add("seen");
    pItems.forEach(function (li) { li.classList.add("done"); });
    VGF.forEach(function (f) { f(1); });
    rail.style.setProperty("--f", 1);
  }
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(function (es) {
      pIn = es[0].isIntersecting;
      if (pIn) { pipe.classList.add("seen"); pLast = 0; if (reduce) pipeShowAll(); }
    }, { threshold: .25 }).observe(pipe);
  } else { pIn = true; pipeShowAll(); }
  function frame(now) { requestAnimationFrame(frame); if (document.hidden) return; if (pIn && !reduce) pipeFrame(now); }
  pipeMeasure();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(pipeMeasure);
  window.addEventListener("resize", pipeMeasure);
  requestAnimationFrame(frame);
})();
</script>
