---
// Démo Deal Hunter : une annonce traverse les six étapes du bot, avec son code porté (deal-hunter-engine.js),
// puis arrive dans son salon. Catalogue GPU : données publiques de l'API. Prix de marché : jeu inventé.
// Réponses de Claude Haiku : écrites pour la démo au format exact du bot. La démo n'appelle aucun serveur.
import { SAMPLES, PIPELINE, ME, CHANNEL_INFO } from "../data/deal-hunter/samples";
import { PIC } from "../lib/dh-art";
import market from "../data/deal-hunter/demo-market.json";
import catalog from "../data/videntis/gpu-catalog.json";
import engineSrc from "../scripts/deal-hunter-engine.js?raw";

const PL: Record<string, string> = { leboncoin: "Leboncoin", vinted: "Vinted" };
const picKeys = Object.keys(PIC);
const data = JSON.stringify({
  catalog: (catalog as { name: string }[]).map((c) => ({ name: c.name })),
  market, samples: SAMPLES, pipeline: PIPELINE, me: ME, channels: CHANNEL_INFO,
  pics: Object.fromEntries(picKeys.map((k) => [k, PIC[k].bg])),
});
const ORDER = ["deals_fire", "deals_price_drop", "deals_hs", "deals_suspect", "deals_not_rentable", "deals_other"];
const STEPS = [
  ["Écartée d’office ?", "vrai code", "t-real"],
  ["Quel modèle ?", "vrai code", "t-real"],
  ["Déjà vue ?", "vrai code", "t-real"],
  ["Combien ça rapporte ?", "prix inventés", "t-fake"],
  ["Pour pièces ? Arnaque ?", "vrai code", "t-real"],
  ["Quel salon ?", "vrai code", "t-real"],
];
---
<div class="dhd" id="dhd">
  <div class="dhd-pick">
    <p class="dh-k">1. Une annonce <span>inventée</span></p>
    <div class="dhd-samples">
      {SAMPLES.map((s, i) => (
        <button type="button" class={"smp2" + (i === 0 ? " on" : "")} data-i={i}>
          <span class="smp2-pic" data-bg={PIC[s.pic].bg}><svg class="draw" viewBox="0 0 176 100" aria-hidden="true" set:html={PIC[s.pic].svg} /></span>
          <span class="smp2-t">{s.title}</span>
          <span class="smp2-m">{s.price} € · {PL[s.platform]}</span>
        </button>
      ))}
    </div>
    <form class="dhd-form" id="dhd-form" autocomplete="off">
      <p class="dh-k">ou la vôtre</p>
      <label class="dh-f"><span>Titre</span><input id="dhd-title" type="text" maxlength="120" value={SAMPLES[0].title} /></label>
      <div class="dhd-row">
        <label class="dh-f"><span>Prix (€)</span><input id="dhd-price" type="number" min="1" max="99999" step="1" value={SAMPLES[0].price} /></label>
        <label class="dh-f"><span>Site</span><select id="dhd-plat"><option value="leboncoin">Leboncoin</option><option value="vinted">Vinted</option></select></label>
      </div>
      <label class="dh-f"><span>Description <em>(facultatif)</em></span><input id="dhd-desc" type="text" maxlength="200" value="" placeholder="Fonctionne parfaitement, facture…" /></label>
      <button class="dhd-go" type="submit">Passer l’annonce au bot</button>
    </form>
  </div>

  <div class="dhd-run">
    <p class="dh-k">2. Le bot la lit</p>
    <article class="dh-lot" aria-live="polite">
      <div class="dh-lot-pic" id="dhd-pic" data-bg={PIC[SAMPLES[0].pic].bg}>
        {picKeys.map((k) => <svg class={"draw pv" + (k === SAMPLES[0].pic ? " on" : "")} data-k={k} viewBox="0 0 176 100" aria-hidden="true" set:html={PIC[k].svg} />)}
        <span>annonce inventée</span>
      </div>
      <div class="dh-lot-txt">
        <p class="dh-lot-t" id="dhd-t">{SAMPLES[0].title}</p>
        <p class="dh-lot-p"><b id="dhd-p">{SAMPLES[0].price} €</b><span id="dhd-pl">Leboncoin</span></p>
        <p class="dh-lot-d" id="dhd-d"></p>
      </div>
    </article>
    <ol class="dhd-steps">
      {STEPS.map(([q, tag, cls], i) => (
        <li class="st" id={"st" + (i + 1)}>
          <header><i>{i + 1}</i><h3>{q}</h3><span class={"tag " + cls}>{tag}</span></header>
          <div class="st-b"></div>
        </li>
      ))}
    </ol>
  </div>

  <div class="dhd-out">
    <p class="dh-k">3. Le salon</p>
    <ul class="dhd-salons" aria-label="Les six salons">
      {ORDER.map((k) => (
        <li class={"sal c-" + CHANNEL_INFO[k].c} data-ch={k}><b><i>#&nbsp;</i>{CHANNEL_INFO[k].name}</b><span>{CHANNEL_INFO[k].label}</span><em>0</em></li>
      ))}
    </ul>
    <div class="dhd-msg" id="dhd-msg"></div>
    <div class="dhd-what" id="dhd-what" hidden>
      <p class="dh-k">Et si…</p>
      <div>
        <button type="button" class="wif" data-w="drop">le vendeur baisse de 10 %</button>
        <button type="button" class="wif" data-w="dup">le même objet, sous un autre numéro</button>
        <button type="button" class="wif" data-w="seen">relue au passage suivant</button>
      </div>
    </div>
    <div class="dhd-reply" id="dhd-reply"></div>
  </div>
</div>
<p class="dh-note">« Vrai code » : les fonctions du bot, portées de Python en JavaScript sans changer leur logique, tournent dans votre navigateur. Prix de marché inventés ; les réponses de Claude Haiku ont été écrites pour la démo au format exact du bot. Rien n’est envoyé à un serveur.</p>

<script type="application/json" id="dhd-data" set:html={data}></script>
<Fragment set:html={"<script>" + engineSrc + "</script>"} />
<script is:inline>
(function () {
  "use strict";
  var E = window.DealHunterEngine, raw = JSON.parse(document.getElementById("dhd-data").textContent);
  var data = { index: E.buildModelIndex(raw.catalog), market: raw.market.gpu, cpu: raw.market.cpu };
  var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  var $ = function (id) { return document.getElementById(id); };
  var steps = [1, 2, 3, 4, 5, 6].map(function (k) { return $("st" + k); });
  var PL = { leboncoin: "Leboncoin", vinted: "Vinted" }, PLS = { leboncoin: "LBC", vinted: "VINTED" };
  var CHN = { lbc: "Leboncoin", vinted: "Vinted", ebay: "eBay" };
  var state = { seen: {}, sent: {} }, counts = {}, timers = [], cur = null, lastPosted = null, uid = 0;
  var me = JSON.parse(JSON.stringify(raw.me));

  function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
  function eur(x) { return Math.round(x).toLocaleString("fr-FR") + "\u00a0€"; }
  function seur(x) { var r = Math.round(x); return (r > 0 ? "+" : r < 0 ? "−" : "") + Math.abs(r).toLocaleString("fr-FR") + "\u00a0€"; }
  function num(x, d) { return x.toFixed(d).replace(".", ","); }
  function later(fn, ms) { if (reduce) fn(); else timers.push(setTimeout(fn, ms)); }

  // ---------- Étapes ----------
  function markTitle(t, hit) {
    if (!hit) return esc(t);
    var i = E.normalize(t).indexOf(E.normalize(hit));
    if (i < 0) return esc(t);
    return esc(t.slice(0, i)) + "<mark>" + esc(t.slice(i, i + hit.length)) + "</mark>" + esc(t.slice(i + hit.length));
  }
  function bodyExclude(s) {
    if (s.ok) return "<p class=\"ans ok\">✓ Rien à écarter</p><p class=\"sd\">Ni lot, ni boîte vide, ni portable, ni échange, ni accessoire" + (cur.ad.platform === "vinted" ? ", ni bruit en langue étrangère." : ".") + "</p>";
    return "<p class=\"ans no\">✗ Écartée</p><p class=\"sd\">" + esc(s.why) + (s.hit ? "&nbsp;: <mark>« " + esc(s.hit) + " »</mark>" : "") + "</p>" + (s.vinted ? "<p class=\"sd sm\">Filtre propre à Vinted.</p>" : "");
  }
  function bodyModel(s) {
    if (!s.ok) return "<p class=\"ans no\">✗ " + (s.token ? "Trop ancienne" : "Non traitée") + "</p>" + (s.token ? "<p class=\"sd\">Lu dans le titre&nbsp;: <code>" + esc(s.token) + "</code></p>" : "") + "<p class=\"sd\">" + esc(s.why) + ".</p>";
    return "<p class=\"ans\">" + esc(s.name || s.token) + "</p><p class=\"sd\">" + esc(s.family) + " · lu dans le titre&nbsp;: <code>" + esc(s.token) + "</code>" + (s.name ? "" : "<br>absent du catalogue de la démo") + "</p>";
  }
  function bodySeen(s) {
    if (s.dup) return "<p class=\"ans no\">✗ Doublon</p><p class=\"sd\">" + esc(s.why) + ".</p><p class=\"sd sm\">Empreinte&nbsp;: <code>" + esc(s.fp.length > 46 ? s.fp.slice(0, 44) + "…" : s.fp) + "</code></p>";
    if (s.ok === false) return "<p class=\"ans no\">✗ Déjà vue</p><p class=\"sd\">" + esc(s.why) + ".</p>";
    if (s.drop) return "<p class=\"ans warn\">↘ Baisse de " + num(s.drop.drop_pct, 0) + " %</p><p class=\"sd\">Vue à " + eur(s.drop.old_price) + ", revient à " + eur(s.drop.new_price) + "&nbsp;: elle repasse.</p>";
    return "<p class=\"ans ok\">✓ Première fois</p><p class=\"sd\">Gardée 7 jours en mémoire, avec son prix.</p>";
  }
  function bodyProfit(s) {
    var ev = s.ev;
    if (ev.realistic_sell_price === null) return "<p class=\"ans\">Pas de référence</p><p class=\"sd\">Ce modèle n’a pas de prix dans le jeu de la démo. Le bot le poste quand même, sans profit.</p>";
    var h = "";
    if (ev.staticEstimate) h += "<p class=\"sd\">Revente&nbsp;: <b>" + eur(ev.realistic_sell_price) + "</b>, l’estimation fixe du code pour ce modèle.</p>";
    else h += "<p class=\"sd\">Ventes confirmées&nbsp;: " + eur(ev.market_median) + " × " + num(ev.tier, 2) + " = <b>" + eur(ev.realistic_sell_price) + "</b> à la revente" + (ev.capped ? " (plafond&nbsp;: 90 % du neuf)" : "") + ".</p>";
    var mx = 1;
    ["lbc", "vinted", "ebay"].forEach(function (c) { mx = Math.max(mx, Math.abs(ev.profits_by_channel[c].profit)); });
    h += "<ul class=\"pbars\">";
    ["lbc", "vinted", "ebay"].forEach(function (c) {
      var p = ev.profits_by_channel[c], w = Math.max(3, Math.abs(p.profit) / mx * 100);
      var sub = c === "lbc" ? "main propre, sans frais" : "−" + Math.round(p.fee * 100) + "\u00a0%, port " + p.ship + "\u00a0€";
      h += "<li class=\"" + (c === ev.best_channel ? "best" : "") + (p.profit < 0 ? " neg" : "") + "\"><span class=\"pb-n\">" + CHN[c] + "<em>" + sub + "</em></span><span class=\"pb-t\"><i style=\"width:" + w.toFixed(1) + "%\"></i></span><b>" + seur(p.profit) + "</b></li>";
    });
    h += "</ul><p class=\"verd v-" + vk(ev) + "\">" + esc(ev.verdict.v) + "</p>";
    return h;
  }
  function vk(ev) { return ev.verdict.k; }
  function bodyRisk(s) {
    if (s.skipped) return "<p class=\"sd\">Non atteinte&nbsp;: rien n’est posté.</p>";
    if (s.hs.is_hs) return "<p class=\"ans warn\">Pour pièces</p><p class=\"chips\">" + s.hs.signals.map(function (x) { return "<span>" + esc(x) + "</span>"; }).join("") + "</p><p class=\"sd sm\">Confiance " + Math.round(s.hs.confidence * 100) + " %. Pas de contrôle d’arnaque&nbsp;: un prix bas est normal ici.</p>";
    if (s.suspect) return "<p class=\"ans no\">⚑ Suspecte</p><ul class=\"flags\">" + s.flags.map(function (f) { return "<li>" + esc(f) + "</li>"; }).join("") + "</ul>";
    var veto = s.hs.veto ? "<p class=\"sd sm\">Mot « " + esc(s.hs.veto) + " » : la détection de panne est annulée.</p>" : "";
    if (s.skip) return "<p class=\"ans ok\">✓ Rien à signaler</p><p class=\"sd sm\">Sous 100 € de revente, le bot ne cherche pas d’arnaque.</p>" + veto;
    return "<p class=\"ans ok\">✓ Rien à signaler</p><p class=\"sd sm\">Prix à " + num(s.ratio || 0, 2) + " de la revente" + (s.flags.length ? "&nbsp;; un seul signal&nbsp;: " + esc(s.flags[0]) : "") + ".</p>" + veto;
  }
  function bodyRoute(s) {
    if (!s.ok) return "<p class=\"ans no\">✗ Rien n’est posté</p><p class=\"sd\">" + esc(s.why) + ".</p>";
    var c = raw.channels[s.channel], h = "<p class=\"salpill c-" + c.c + "\"># " + esc(c.name) + "</p>";
    s.who.forEach(function (w) { h += "<p class=\"sd\">" + (w.pinged ? "<b class=\"at\">@" + esc(w.name) + "</b> mentionné." : "Sans mention&nbsp;: " + esc(w.why) + ".") + "</p>"; });
    return h;
  }
  var BODY = { exclude: bodyExclude, model: bodyModel, seen: bodySeen, profit: bodyProfit, risk: bodyRisk, route: bodyRoute };

  // ---------- Message du bot ----------
  var FAM = { gpu: "", cpu: "CPU · ", ram: "RAM · ", ssd: "SSD · " };
  function fam(ev) { return ev.is_cpu ? "cpu" : ev.is_ram ? "ram" : ev.is_ssd ? "ssd" : "gpu"; }
  function msgHtml(r, smp) {
    var ev = r.ev, ad = r.ad, drop = ev.price_drop, model = ev.matched_model ? ev.matched_model.name : (r.steps[1].token || "GPU");
    var kind = ev.is_scam_suspect ? "sus" : drop ? "drop" : vk(ev);
    var title = (drop ? "BAISSE DE PRIX" : ev.verdict.v) + " · " + model;
    var f = [];
    f.push(["Prix", "<b>" + eur(ad.price_eur) + "</b>"]);
    if (drop) f.push(["Baisse", eur(drop.old_price) + " → " + eur(drop.new_price) + " (−" + Math.round(drop.drop_pct) + " %)"]);
    f.push(ev.realistic_sell_price !== null ? ["Revente estimée", "~" + eur(ev.realistic_sell_price)] : ["Revente", "N/A"]);
    f.push(ev.best_profit !== null ? ["Profit net", "<b>" + seur(ev.best_profit) + "</b> via " + ev.best_channel.toUpperCase()] : ["Profit", "N/A"]);
    if (smp && smp.city) f.push(["Localisation", esc(smp.city)]);
    f.push(["Plateforme", PL[ad.platform]]);
    var n = ev.observation_count;
    if (n > 0) f.push(["Observations", n + (n >= 30 ? " ✓ fiable" : n >= 15 ? "" : " ⚠ faible")]);
    if (ev.new_price_eur) f.push(["Prix neuf", eur(ev.new_price_eur)]);
    var wide = [];
    if (ev.best_channel) wide.push(["Détail profits", ["lbc", "vinted", "ebay"].map(function (c) { return c.toUpperCase() + "&nbsp;: " + seur(ev.profits_by_channel[c].profit); }).join(" | ")]);
    if (ev.is_scam_suspect) wide.push(["Drapeaux", ev.scam_flags.map(function (x) { return "• " + esc(x); }).join("<br>")]);
    if (ev.is_hs) {
      if (ev.hs.signals.length) wide.unshift(["Signaux HS", esc(ev.hs.signals.slice(0, 3).join(" · "))]);
      if (ev.hs.price_anomaly) wide.splice(1, 0, ["Prix exceptionnellement bas", "Prix &lt; 40 % de la revente estimée, vérifier la cohérence."]);
      wide.push(["", "<b>Annonce détectée comme HS / pour pièces.</b> Le verdict ci-dessus est basé sur la valeur fonctionnelle du composant. La rentabilité réelle dépend de la réparabilité. Utilise <b>Analyser</b> pour un diagnostic technique détaillé."]);
    }
    f.push(["Publiée", smp ? smp.ago : "à l’instant"]);
    var who = r.who.filter(function (w) { return w.pinged; }).map(function (w) { return "@" + w.name; }).join(" ");
    var desc = esc(ad.title) + (ad.description ? "<span class=\"emb-desc\">" + esc(ad.description) + "</span>" : "") + (ev.is_scam_suspect ? "<b class=\"emb-warn\">NE PAS ACHETER SANS VÉRIFIER LE VENDEUR</b>" : "");
    return "<div class=\"msg\"><span class=\"msg-av\" aria-hidden=\"true\">DH</span><div class=\"msg-b\">" +
      "<p class=\"msg-h\"><b>Deal Hunter</b><span class=\"botp\">bot</span><em>aujourd’hui</em></p>" +
      (who ? "<p class=\"msg-at\">" + esc(who) + "</p>" : "") +
      "<div class=\"emb k-" + kind + "\"><div class=\"emb-top\"><div class=\"emb-txt\"><p class=\"emb-t\">" + (drop ? "" : "<span class=\"newp\">nouveau</span>") + esc(title) + "</p><p class=\"emb-d\">" + desc + "</p></div>" +
      "<span class=\"emb-th\" data-bg=\"" + raw.pics[cur.pic] + "\">" + picSvg(cur.pic) + "</span></div>" +
      "<dl class=\"emb-f\">" + f.map(function (x) { return "<div><dt>" + x[0] + "</dt><dd>" + x[1] + "</dd></div>"; }).join("") +
      wide.map(function (x) { return "<div class=\"w\">" + (x[0] ? "<dt>" + x[0] + "</dt>" : "") + "<dd>" + x[1] + "</dd></div>"; }).join("") + "</dl>" +
      "<p class=\"emb-foot\">Deal Hunter · " + FAM[fam(ev)] + PLS[ad.platform] + "</p></div>" +
      "<div class=\"msg-btns\"><span class=\"mb mb-buy\">Acheter ↗</span><button type=\"button\" class=\"mb mb-ai\" id=\"dhd-ai\">Analyser</button><button type=\"button\" class=\"mb mb-rep\" id=\"dhd-rep\">Signaler</button></div>" +
      "<p class=\"msg-rep\" id=\"dhd-repn\" hidden>Signalée&nbsp;: elle rejoint la liste de #bot-settings, avec le contexte du message figé. Les causes qui reviennent deviennent des exclusions.</p>" +
      "</div></div>";
  }
  // Sur téléphone, la suite se joue plus bas : on l'amène à l'écran.
  function bring(el) {
    var r = el.getBoundingClientRect();
    if (r.top < 60 || r.top > innerHeight - 120) el.scrollIntoView({ block: "start", behavior: reduce ? "auto" : "smooth" });
  }
  function picSvg(k) { var s = document.querySelector("#dhd-pic .pv[data-k=\"" + k + "\"]"); return s ? s.outerHTML.replace(" on\"", "\"") : ""; }

  // ---------- Réponse de Haiku ----------
  function aiHtml(sections, hs) {
    return "<div class=\"msg msg-ai\"><span class=\"msg-av\" aria-hidden=\"true\">DH</span><div class=\"msg-b\">" +
      "<p class=\"msg-re\">↳ réponse à Deal Hunter</p><p class=\"msg-h\"><b>Deal Hunter</b><span class=\"botp\">bot</span><em>aujourd’hui</em></p>" +
      "<div class=\"emb k-ai\"><p class=\"emb-t\">Analyse du deal</p>" + sections.map(function (s) {
        var pd = reduce ? "" : " pend";
        return "<p class=\"ai-h" + pd + "\">" + esc(s.h) + "</p>" + s.l.map(function (l) { return "<p class=\"ai-l" + pd + "\" data-t=\"" + esc(l) + "\"></p>"; }).join("");
      }).join("") + "<p class=\"emb-foot\">Analyse par Claude Haiku (texte + image) · usage personnel" + (hs ? " · consigne réparateur" : "") + "</p></div>" +
      "<p class=\"ai-tag\">Réponse écrite pour la démo, au format exact du bot.</p></div></div>";
  }
  function typeAi(box) {
    var ls = box.querySelectorAll(".ai-l");
    if (reduce) { Array.prototype.forEach.call(ls, function (p) { p.textContent = p.getAttribute("data-t"); }); return; }
    var t0 = 0;
    Array.prototype.forEach.call(ls, function (p) {
      var txt = p.getAttribute("data-t"), dur = Math.min(700, 120 + txt.length * 6);
      (function (p, txt, start, dur) {
        var n = 12, h = p.previousElementSibling;
        timers.push(setTimeout(function () {             // la ligne (et son titre) n'apparaît qu'au moment où elle s'écrit
          p.classList.remove("pend"); if (h && h.classList.contains("ai-h")) h.classList.remove("pend");
        }, start));
        for (var k = 1; k <= n; k++) (function (k) { timers.push(setTimeout(function () { p.textContent = txt.slice(0, Math.round(txt.length * k / n)); }, start + dur * k / n)); })(k);
      })(p, txt, t0, dur);
      t0 += dur + 60;
    });
  }
  function bindMsg(r) {
    var ai = $("dhd-ai"), rep = $("dhd-rep");
    if (ai) ai.addEventListener("click", function () {
      var reply = $("dhd-reply"), smp = cur.sample;
      ai.classList.add("used");
      var sec = smp ? (r.ev.price_drop && smp.aiDrop ? smp.aiDrop : smp.ai) : null;
      if (!sec) { reply.innerHTML = "<p class=\"ai-none\">Sur une annonce libre, rien n’est simulé&nbsp;: la démo n’appelle aucune IA. Les réponses de Haiku existent pour les annonces d’exemple.</p>"; return; }
      reply.innerHTML = aiHtml(sec, !!smp.aiHs);
      typeAi(reply);
      bring(reply);
    });
    if (rep) rep.addEventListener("click", function () { rep.classList.add("used"); $("dhd-repn").hidden = false; });
  }

  // ---------- Déroulé ----------
  var ORDER = ["exclude", "model", "seen", "profit", "risk", "route"];
  function pickPic(r, input) {
    if (input.pic) return input.pic;
    var s1 = r.steps[0], s2 = r.steps[1], t = E.normalize(input.title);
    if (s1 && !s1.ok) return /lunette|ray|monture|optique/.test(t) ? "glasses" : /portable|laptop|legion|omen|zephyrus/.test(t) ? "laptop" : "unknown";
    if (s2 && s2.ok) {
      var f = s2.family;
      if (f === "Processeur") return "cpu"; if (f === "Mémoire") return "ram"; if (f === "SSD") return "ssd";
      var g = ["gpu-fe", "gpu-mid", "gpu-amd", "gpu-huge"], h = 0;
      for (var i = 0; i < s2.token.length; i++) h = (h * 31 + s2.token.charCodeAt(i)) | 0;
      return g[Math.abs(h) % g.length];
    }
    return "unknown";
  }
  function showAd(input, pic, hit) {
    $("dhd-t").innerHTML = markTitle(input.title, hit);
    $("dhd-p").textContent = eur(input.price_eur); $("dhd-pl").textContent = PL[input.platform] + (input.city ? " · " + input.city : "");
    $("dhd-d").textContent = input.description || ""; $("dhd-d").hidden = !input.description;
    Array.prototype.forEach.call(document.querySelectorAll("#dhd-pic .pv"), function (s) { s.classList.toggle("on", s.getAttribute("data-k") === pic); });
    $("dhd-pic").setAttribute("data-bg", raw.pics[pic]);
  }
  function run(input, sample, opts) {
    timers.forEach(clearTimeout); timers = [];
    opts = opts || {};
    var r = E.processAd(input, data, state, raw.pipeline, [me]);
    var pic = pickPic(r, { title: input.title, pic: sample ? sample.pic : null });
    cur = { ad: input, sample: sample, pic: pic, r: r };
    var exStep = r.steps[0] && !r.steps[0].ok ? r.steps[0] : null;
    showAd(input, pic, exStep ? exStep.hit : null);
    $("dhd-reply").innerHTML = "";
    var byK = {};
    r.steps.forEach(function (s) { byK[s.k] = s; });
    var instant = reduce || opts.instant;
    steps.forEach(function (st, i) {
      var s = byK[ORDER[i]], b = st.querySelector(".st-b"), html = s ? BODY[s.k](s) : "<p class=\"sd\">Non atteinte.</p>";
      var fin = "st " + (s ? (s.ok === false || (s.k === "risk" && s.suspect) ? "done bad" : "done") : "off");
      if (instant) { b.innerHTML = html; st.className = fin; return; }
      st.className = "st wait"; b.innerHTML = "";
      timers.push(setTimeout(function () { st.className = "st run"; }, 60 + i * 300));
      timers.push(setTimeout(function () { b.innerHTML = html; st.className = fin; }, 300 + i * 300));
    });
    var posted = r.stop === null, msg = $("dhd-msg");
    var fin2 = function () {
      Array.prototype.forEach.call(document.querySelectorAll(".sal"), function (li) { li.classList.toggle("on", posted && li.getAttribute("data-ch") === r.channel); });
      if (posted) {
        if (!opts.noCount) { counts[r.channel] = (counts[r.channel] || 0) + 1; }
        Array.prototype.forEach.call(document.querySelectorAll(".sal"), function (li) { var c = counts[li.getAttribute("data-ch")] || 0; li.querySelector("em").textContent = c; li.classList.toggle("has", c > 0); });
        msg.innerHTML = msgHtml(r, sample);
        if (!instant) { msg.classList.remove("in"); void msg.offsetWidth; msg.classList.add("in"); }
        bindMsg(r);
        lastPosted = { input: input, sample: sample };
      } else {
        msg.innerHTML = "<p class=\"msg-none\">" + (r.stop === "dup" || r.stop === "seen" ? "Rien de nouveau dans le salon&nbsp;: le bot se tait." : "Rien n’est posté&nbsp;: aucun salon ne reçoit cette annonce.") + "</p>";
      }
      $("dhd-what").hidden = !lastPosted;
    };
    if (instant) fin2(); else { msg.classList.add("fade"); timers.push(setTimeout(function () { msg.classList.remove("fade"); fin2(); }, 300 + 6 * 300)); }
  }
  function adFrom(s, over) {
    var ad = { ad_id: s.id, title: s.title, price_eur: s.price, platform: s.platform, description: s.description || "", condition: s.condition || null, city: s.city || "" };
    for (var k in over) ad[k] = over[k];
    return ad;
  }
  // ---------- Commandes ----------
  Array.prototype.forEach.call(document.querySelectorAll(".smp2"), function (b) {
    b.addEventListener("click", function () {
      var s = raw.samples[+b.getAttribute("data-i")];
      Array.prototype.forEach.call(document.querySelectorAll(".smp2"), function (o) { o.classList.toggle("on", o === b); });
      $("dhd-title").value = s.title; $("dhd-price").value = s.price; $("dhd-plat").value = s.platform; $("dhd-desc").value = s.description || "";
      state = { seen: {}, sent: {} };                   // une annonce choisie repart toujours de zéro ; la mémoire se teste avec « Et si… »
      run(adFrom(s, {}), s);
      if (innerWidth < 760) bring(document.querySelector(".dhd-run"));
    });
  });
  $("dhd-form").addEventListener("submit", function (e) {
    e.preventDefault();
    Array.prototype.forEach.call(document.querySelectorAll(".smp2"), function (o) { o.classList.remove("on"); });
    var t = $("dhd-title").value.trim() || "(titre vide)", h = 0;
    for (var i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) | 0;
    state = { seen: {}, sent: {} };
    var input = { ad_id: "u" + Math.abs(h), title: t, price_eur: Math.max(1, Math.round(+$("dhd-price").value || 1)), platform: $("dhd-plat").value, description: $("dhd-desc").value.trim(), condition: null, city: "" };
    run(input, null);
    if (innerWidth < 760) bring(document.querySelector(".dhd-run"));
  });
  Array.prototype.forEach.call(document.querySelectorAll(".wif"), function (b) {
    b.addEventListener("click", function () {
      if (!lastPosted) return;
      var base = lastPosted.input, w = b.getAttribute("data-w"), over = {};
      var cp = {}; for (var k in base) cp[k] = base[k];
      if (w === "drop") cp.price_eur = Math.max(1, Math.round(base.price_eur * 0.9));
      if (w === "dup") { uid++; cp.ad_id = base.ad_id + "-bis" + uid; }
      run(cp, lastPosted.sample);
      if (w !== "drop") lastPosted = { input: base, sample: lastPosted.sample };
      if (innerWidth < 760) bring(document.querySelector(".dhd-run"));
    });
  });
  // Premier passage : rendu immédiat, puis rejoué quand la démo arrive à l'écran.
  var first = raw.samples[0];
  run(adFrom(first, {}), first, { instant: true });
  var started = false, dhd = $("dhd");
  if ("IntersectionObserver" in window && !reduce) {
    new IntersectionObserver(function (es, ob) {
      if (es[0].isIntersecting && !started) { started = true; ob.disconnect(); state = { seen: {}, sent: {} }; counts = {}; run(adFrom(first, {}), first); }
    }, { threshold: .3 }).observe(dhd);
  }
})();
</script>
