---
// Dessins de la page Videntis : composants du catalogue, fonctions de l'appli, étapes de la méthode.
// Trait encre 2 px, aplats aux couleurs du site. Aucun logo ni dessin de marque.
interface Props { name: string; label?: string }
const { name, label } = Astro.props;
const I = "#111216", W = "#FFFFFF", Y = "#FFD93B", B = "#2B45FF", P = "#FF4F9A", G = "#3DDC97", PA = "#F3F4F6", R = "#D3D6DC";
const ticks = (x0: number, y0: number, n: number, dx: number, dy: number, lx: number, ly: number) =>
  Array.from({ length: n }, (_, i) => `M${x0 + i * dx} ${y0 + i * dy}l${lx} ${ly}`).join("");
const fan = (cx: number, cy: number, r: number) =>
  `<g class="an-fan"><circle cx="${cx}" cy="${cy}" r="${r}" fill="${B}" stroke="${I}" stroke-width="2"/>` +
  [0, 72, 144, 216, 288].map((a) => `<path d="M${cx} ${cy}q${r * .55} ${-r * .15} ${r * .78} ${r * .32}" fill="none" stroke="${W}" stroke-width="2.4" stroke-linecap="round" transform="rotate(${a} ${cx} ${cy})"/>`).join("") +
  `<circle cx="${cx}" cy="${cy}" r="${r * .26}" fill="${W}" stroke="${I}" stroke-width="2"/></g>`;
const S = `stroke="${I}" stroke-width="2"`;
const ART: Record<string, [string, string]> = {
  // ---------- Composants ----------
  gpu: ["0 0 160 100", `<rect x="8" y="20" width="134" height="54" rx="7" fill="${W}" ${S}/>${fan(46, 47, 19)}${fan(102, 47, 19)}<rect x="142" y="14" width="10" height="66" rx="2" fill="${R}" ${S}/><rect x="36" y="74" width="74" height="9" fill="${Y}" ${S}/><path d="${ticks(42, 75, 12, 5.6, 0, 0, 7)}" stroke="${I}" stroke-width="1.2"/>`],
  cpu: ["0 0 160 100", `<path d="${ticks(54, 6, 6, 10.4, 0, 0, 8)}${ticks(54, 86, 6, 10.4, 0, 0, 8)}${ticks(38, 22, 6, 0, 10.4, 8, 0)}${ticks(114, 22, 6, 0, 10.4, 8, 0)}" stroke="${I}" stroke-width="2"/><rect x="46" y="14" width="68" height="72" rx="7" fill="${G}" ${S}/><rect x="58" y="26" width="44" height="48" rx="4" fill="${W}" ${S}/><path d="M66 38h28M66 46h20M66 54h24" stroke="${I}" stroke-width="2" stroke-linecap="round"/>`],
  ram: ["0 0 160 100", `<rect x="8" y="28" width="144" height="42" rx="4" fill="${P}" ${S}/>${Array.from({ length: 8 }, (_, i) => `<rect x="${16 + i * 16.5}" y="35" width="12" height="18" rx="1.5" fill="${W}" ${S}/>`).join("")}<rect x="8" y="60" width="144" height="10" fill="${Y}" ${S}/><path d="${ticks(13, 61, 23, 6.1, 0, 0, 8)}" stroke="${I}" stroke-width="1.1"/><rect x="74" y="58" width="7" height="14" fill="${PA}" stroke="none"/><path d="M74 70v-10h7v10" fill="none" ${S}/>`],
  ssd: ["0 0 160 100", `<rect x="12" y="34" width="134" height="32" rx="4" fill="${B}" ${S}/><rect x="12" y="34" width="14" height="32" fill="${Y}" ${S}/><path d="${ticks(15, 37, 5, 0, 6, 8, 0)}" stroke="${I}" stroke-width="1.1"/><rect x="36" y="41" width="30" height="18" rx="2" fill="${W}" ${S}/><rect x="72" y="41" width="30" height="18" rx="2" fill="${W}" ${S}/><rect x="108" y="43" width="16" height="14" rx="2" fill="${G}" ${S}/><circle cx="140" cy="50" r="6" fill="${PA}" ${S}/>`],
  mobo: ["0 0 160 100", `<rect x="26" y="6" width="108" height="88" rx="5" fill="${G}" ${S}/><rect x="40" y="18" width="30" height="30" rx="3" fill="${W}" ${S}/><rect x="47" y="25" width="16" height="16" fill="${R}" ${S}/>${[0, 1, 2, 3].map((i) => `<rect x="${80 + i * 8}" y="14" width="4.5" height="40" fill="${I}"/>`).join("")}<rect x="40" y="60" width="78" height="7" rx="1.5" fill="${W}" ${S}/><rect x="40" y="76" width="78" height="7" rx="1.5" fill="${W}" ${S}/><rect x="114" y="18" width="12" height="12" rx="2" fill="${Y}" ${S}/>`],
  psu: ["0 0 160 100", `<rect x="18" y="16" width="124" height="68" rx="7" fill="${Y}" ${S}/><circle cx="66" cy="50" r="25" fill="${W}" ${S}/><g class="an-fan"><path d="M42 50h48M66 26v48M49 33l34 34M83 33l-34 34" stroke="${I}" stroke-width="1.4"/><circle cx="66" cy="50" r="15" fill="none" stroke="${I}" stroke-width="1.4"/></g><rect x="104" y="28" width="24" height="17" rx="2" fill="${I}"/><rect x="109" y="33" width="14" height="7" rx="1" fill="${W}"/><rect x="108" y="56" width="16" height="12" rx="2" fill="${P}" ${S}/>`],

  // ---------- Fonctions ----------
  lens: ["0 0 200 120", `<rect x="6" y="6" width="188" height="108" rx="9" fill="${W}" ${S}/><path d="M6 24h188" ${S}/><circle cx="18" cy="15" r="3" fill="${P}"/><circle cx="28" cy="15" r="3" fill="${Y}"/><circle cx="38" cy="15" r="3" fill="${G}"/><rect x="18" y="34" width="62" height="46" rx="5" fill="${PA}" ${S}/><path d="M92 40h74M92 50h52" stroke="${I}" stroke-width="3" stroke-linecap="round"/><text x="92" y="74" font-family="Anybody, sans-serif" font-weight="800" font-size="16" fill="${I}">420 €</text><g class="an-stamp"><g transform="rotate(-9 140 90)"><rect x="98" y="78" width="84" height="26" rx="5" fill="${W}" stroke="${B}" stroke-width="3"/><text x="140" y="96" text-anchor="middle" font-family="Anybody, sans-serif" font-weight="800" font-size="13" fill="${B}" letter-spacing=".5">NÉGOCIER</text></g></g>`],
  estimator: ["0 0 200 120", `<text x="14" y="40" font-family="Anybody, sans-serif" font-weight="800" font-size="30" fill="${I}">+37 €</text><text x="118" y="40" font-family="Schibsted Grotesk, sans-serif" font-weight="700" font-size="12" fill="${I}">marge nette</text><rect x="14" y="58" width="172" height="16" rx="8" fill="${W}" ${S}/><rect x="15" y="59" width="56" height="14" rx="7" fill="${G}"/><rect x="71" y="59" width="70" height="14" fill="${Y}"/><path d="M141 59h37a7 7 0 0 1 0 14h-37z" fill="${P}"/><g class="an-mark"><path d="M110 50l-7 -10h14z" fill="${I}"/><path d="M110 50v28" stroke="${I}" stroke-width="2.5"/></g><path d="M14 96h40M76 96h40M138 96h48" stroke="${I}" stroke-width="3" stroke-linecap="round"/><path d="M54 96l22 -10M116 96l22 -10" stroke="${I}" stroke-width="1.6" stroke-dasharray="3 3"/>`],
  catalogue: ["0 0 200 120", [0, 1, 2].flatMap((c) => [0, 1].map((r) => `<g class="an-card" style="--i:${c * 2 + r}"><rect x="${12 + c * 62}" y="${10 + r * 54}" width="52" height="44" rx="6" fill="${W}" ${S}/><rect x="${20 + c * 62}" y="${18 + r * 54}" width="36" height="16" rx="3" fill="${[B, G, P, Y, G, B][c * 2 + r]}" ${S}/><path d="M${20 + c * 62} ${43 + r * 54}h${24 - r * 6}" stroke="${I}" stroke-width="2.5" stroke-linecap="round"/></g>`)).join("")],
  watchlist: ["0 0 200 120", `<path d="M14 34q30 -30 60 0q-30 30 -60 0z" fill="${W}" ${S}/><circle cx="44" cy="34" r="9" fill="${B}" ${S}/><circle cx="46" cy="32" r="2.5" fill="${W}"/>${[0, 1, 2].map((i) => `<rect x="88" y="${14 + i * 32}" width="100" height="24" rx="5" fill="${W}" ${S}/><polyline class="an-line" pathLength="1" points="${[96, 106, 116, 126, 136].map((x, j) => `${x},${28 + i * 32 + [4, -2, 2, -6, -3][(j + i) % 5]}`).join(" ")}" fill="none" stroke="${[G, P, B][i]}" stroke-width="2.6" stroke-linejoin="round"/><path d="M150 ${26 + i * 32}h28" stroke="${I}" stroke-width="2.5" stroke-linecap="round"/>`).join("")}<path d="M14 74h56M14 88h40M14 102h48" stroke="${I}" stroke-width="2.5" stroke-linecap="round" opacity=".35"/>`],
  stock: ["0 0 200 120", `<rect x="22" y="60" width="64" height="48" rx="3" fill="${Y}" ${S}/><path d="M22 74h64M54 60v14" ${S}/><rect x="96" y="60" width="64" height="48" rx="3" fill="${Y}" ${S}/><path d="M96 74h64M128 60v14" ${S}/><rect x="58" y="14" width="64" height="46" rx="3" fill="${Y}" ${S}/><path d="M58 28h64M90 14v14" ${S}/><g class="an-tag"><g transform="rotate(8 160 30)"><path d="M136 18h40l8 12-8 12h-40z" fill="${G}" ${S}/><text x="158" y="35" text-anchor="middle" font-family="Anybody, sans-serif" font-weight="800" font-size="13" fill="${I}">+64 €</text></g></g>`],
  dashboard: ["0 0 200 120", `<rect x="8" y="8" width="184" height="104" rx="9" fill="${W}" ${S}/>${[30, 52, 40, 66, 58, 78].map((h, i) => `<rect class="an-bar" style="--i:${i}" x="${22 + i * 16}" y="${96 - h}" width="11" height="${h}" rx="2" fill="${i === 5 ? G : B}" stroke="${I}" stroke-width="1.6"/>`).join("")}<path d="M18 97h102" ${S}/><circle cx="156" cy="56" r="26" fill="${Y}" ${S}/><path d="M156 30a26 26 0 0 1 24 36l-24-10z" fill="${P}" ${S}/><path d="M180 66a26 26 0 0 1-30 15l6-25z" fill="${G}" ${S}/><circle cx="156" cy="56" r="11" fill="${W}" ${S}/>`],
  repair: ["0 0 200 120", `<g class="an-wrench"><g transform="rotate(-38 54 60)"><rect x="46" y="44" width="16" height="64" rx="5" fill="${Y}" ${S}/><path d="M36 22a20 20 0 1 0 36 0l-6 10h-24z" fill="${R}" ${S}/></g></g>${[0, 1, 2, 3].map((i) => `<rect x="104" y="${16 + i * 24}" width="16" height="16" rx="4" fill="${i < 2 ? G : W}" ${S}/>${i < 2 ? `<path class="an-check" pathLength="1" d="M108 ${24 + i * 24}l3 3 6-7" fill="none" stroke="${I}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>` : ""}<path d="M128 ${24 + i * 24}h${[52, 40, 56, 34][i]}" stroke="${I}" stroke-width="3" stroke-linecap="round"/>`).join("")}`],
  community: ["0 0 200 120", `${[30, 74, 118].map((x, i) => `<circle cx="${x}" cy="74" r="16" fill="${[B, P, G][i]}" ${S}/><path d="M${x - 22} 112a22 18 0 0 1 44 0" fill="${[B, P, G][i]}" ${S}/><g class="an-bub" style="--i:${i}"><rect x="${x - 15}" y="20" width="30" height="24" rx="6" fill="${W}" ${S}/><path d="M${x - 6} 44l6 7 6-7" fill="${W}" ${S}/><text x="${x}" y="38" text-anchor="middle" font-family="Schibsted Grotesk, sans-serif" font-weight="800" font-size="14" fill="${I}">${i === 1 ? "✗" : "✓"}</text></g>`).join("")}<path d="M142 40h18" stroke="${I}" stroke-width="2.5"/><path d="M158 34l8 6-8 6" fill="none" stroke="${I}" stroke-width="2.5" stroke-linejoin="round"/><g class="an-ok"><rect x="168" y="26" width="26" height="28" rx="6" fill="${Y}" ${S}/><path d="M174 40l5 5 9-10" fill="none" stroke="${I}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></g>`],

  // ---------- Évolution de la méthode ----------
  "era-gpt": ["0 0 240 130", `<rect x="10" y="22" width="86" height="58" rx="6" fill="${W}" ${S}/><path d="M2 86h102l-8 10h-86z" fill="${R}" ${S}/><rect x="20" y="32" width="48" height="14" rx="7" fill="${G}" ${S}/><rect x="38" y="52" width="48" height="14" rx="7" fill="${PA}" ${S}/><path d="M108 58h40" stroke="${I}" stroke-width="2.5" stroke-dasharray="5 5"/><path d="M144 51l9 7-9 7" fill="none" stroke="${I}" stroke-width="2.5" stroke-linejoin="round"/><rect x="114" y="20" width="26" height="32" rx="3" fill="${Y}" ${S}/><rect x="120" y="16" width="14" height="8" rx="2" fill="${W}" ${S}/><path d="M119 32h16M119 39h12M119 46h14" stroke="${I}" stroke-width="1.6"/>${[0, 1, 2].map((i) => `<rect x="162" y="${22 + i * 28}" width="68" height="22" rx="4" fill="${W}" ${S}/><circle cx="176" cy="${33 + i * 28}" r="3.5" fill="${G}"/><path d="M188 ${33 + i * 28}h32" stroke="${I}" stroke-width="2" stroke-linecap="round"/>`).join("")}`],
  "era-cc": ["0 0 240 130", `${[0, 1, 2].map((i) => `<rect x="150" y="${22 + i * 28}" width="80" height="22" rx="4" fill="${W}" ${S}/><circle cx="164" cy="${33 + i * 28}" r="3.5" fill="${G}"/><path d="M176 ${33 + i * 28}h44" stroke="${I}" stroke-width="2" stroke-linecap="round"/>`).join("")}<rect x="10" y="14" width="152" height="104" rx="8" fill="${I}" ${S}/><circle cx="22" cy="25" r="3" fill="${P}"/><circle cx="32" cy="25" r="3" fill="${Y}"/><circle cx="42" cy="25" r="3" fill="${G}"/><text x="22" y="52" font-family="ui-monospace, Menlo, monospace" font-size="11" fill="${G}">› lit app/services</text><text x="22" y="70" font-family="ui-monospace, Menlo, monospace" font-size="11" fill="${W}">  modifie 3 fichiers</text><text x="22" y="88" font-family="ui-monospace, Menlo, monospace" font-size="11" fill="${W}">  tests   ✓ tous verts</text><rect x="22" y="98" width="8" height="12" fill="${Y}"/>`],
  "era-lovable": ["0 0 240 130", `<circle cx="120" cy="40" r="22" fill="${Y}" ${S}/><text x="120" y="46" text-anchor="middle" font-family="Anybody, sans-serif" font-weight="800" font-size="17" fill="${I}">EM</text><path d="M104 56l-46 30M136 56l46 30" stroke="${I}" stroke-width="2.5"/><rect x="8" y="84" width="96" height="38" rx="7" fill="${I}" ${S}/><text x="56" y="101" text-anchor="middle" font-family="Schibsted Grotesk, sans-serif" font-weight="800" font-size="12" fill="${W}">Claude Code</text><text x="56" y="115" text-anchor="middle" font-family="Schibsted Grotesk, sans-serif" font-size="10.5" fill="${G}">serveur</text><rect x="136" y="84" width="96" height="38" rx="7" fill="${W}" ${S}/><text x="184" y="101" text-anchor="middle" font-family="Schibsted Grotesk, sans-serif" font-weight="800" font-size="12" fill="${I}">Lovable</text><text x="184" y="115" text-anchor="middle" font-family="Schibsted Grotesk, sans-serif" font-size="10.5" fill="${B}">interface</text><rect x="148" y="10" width="78" height="26" rx="6" fill="${W}" ${S}/><text x="187" y="27" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="10.5" fill="${I}">brief.md</text><path d="M146 30l-10 6" stroke="${I}" stroke-width="2"/>`],
  "era-git": ["0 0 240 130", `<path d="M14 66h212" stroke="${I}" stroke-width="3"/>${[30, 66, 102, 138, 174, 210].map((x, i) => `<circle cx="${x}" cy="66" r="8" fill="${i === 5 ? G : W}" ${S}/>`).join("")}<path d="M66 66c0-30 36-30 36-30h36c24 0 36 30 36 30" fill="none" stroke="${B}" stroke-width="3"/><circle cx="102" cy="36" r="7" fill="${B}" ${S}/><circle cx="138" cy="36" r="7" fill="${B}" ${S}/><text x="14" y="98" font-family="ui-monospace, Menlo, monospace" font-size="11" fill="${I}">main</text><text x="84" y="22" font-family="ui-monospace, Menlo, monospace" font-size="10.5" fill="${B}">1 branche = 1 chantier</text><rect x="160" y="88" width="66" height="24" rx="5" fill="${Y}" ${S}/><text x="193" y="104" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="10.5" fill="${I}">./deploy</text>`],
};
const [vb, body] = ART[name] ?? ["0 0 10 10", ""];
---
<svg class={"draw d-" + name} viewBox={vb} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} set:html={body} />
